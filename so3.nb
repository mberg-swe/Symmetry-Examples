Cell[TextData[{
 "(M f\[ODoubleDot]r \[OpenCurlyDoubleQuote]Matematikernas L-matriser\
\[CloseCurlyDoubleQuote].)\nEn allm\[ADoubleDot]n reell antisymmetrisk \
3x3-matris har tre oberoende element, och g\[ARing]r att bygga upp \
fr\[ARing]n de h\[ADoubleDot]r tre. S\[ARing] vi kan \
karakt\[ADoubleDot]risera de tre matriserna som en ",
 StyleBox["bas",
  FontSlant->"Italic"],
 " f\[ODoubleDot]r reella antisymmetriska 3x3-matriser.\n\nL\[ARing]t oss g\
\[ARing] nu igenom hur t.ex. matrisen ",
 StyleBox["LzM", "Input"],
 " kan bygga upp serieutvecklingen av rotationsmatrisen Rz.\n\n\
F\[ODoubleDot]rst, ",
 StyleBox["LzM", "Input"],
 " ger sj\[ADoubleDot]lv per definition linj\[ADoubleDot]ra termen \[Theta].\n\
Kvadratiska termen \[ADoubleDot]r:"
}], "Text",
 CellChangeTimes->{{3.873266935799666*^9, 3.873266946171431*^9}, {
  3.873267843887743*^9, 3.873267854996153*^9}, {3.936409254612679*^9, 
