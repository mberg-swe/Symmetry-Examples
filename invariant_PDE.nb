Cell[BoxData[
 FormBox[
  RowBox[{"2", " ", 
   RowBox[{"cosh", "(", "x", ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"sin", "(", 
      RowBox[{
       SqrtBox["2"], " ", "y"}], ")"}], "+", 
     RowBox[{"cos", "(", 
      RowBox[{
       SqrtBox["2"], " ", "y"}], ")"}]}], ")"}]}], TraditionalForm]], "Output",\

 CellChangeTimes->{{3.976723871559116*^9, 3.976724084237526*^9}},
 CellLabel->
  "Out[2800]=",ExpressionUUID->"c53ebe9a-eea0-40c8-a433-f1ef4ef6dfbc"]
}, Open  ]],

