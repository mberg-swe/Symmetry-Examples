(* Beginning of Notebook Content *)
Notebook[{
Cell[TextData[{
 StyleBox["Invariant PDE", "Subsubsection"],
 "\nExample: \[CapitalDelta]",
 StyleBox["f",
  FontSlant->"Italic"],
 " = \[Lambda]",
 StyleBox["f",
  FontSlant->"Italic"],
 ". \nStudy what it means that this is \[OpenCurlyDoubleQuote]invariant\
\[CloseCurlyDoubleQuote] under coordinate transformations. Certainly it doesn\
\[CloseCurlyQuote]t mean it\[CloseCurlyQuote]s \
\[OpenCurlyDoubleQuote]unchanged\[CloseCurlyDoubleQuote]. \n(Note: the \
connection to coordinate transformations is special to 2nd order Casimir \
operators.)\n\nPose \[CapitalDelta]",
 StyleBox["f",
  FontSlant->"Italic"],
 " = \[Lambda]",
 StyleBox["f",
  FontSlant->"Italic"],
 " as an \[OpenCurlyDoubleQuote]inactive\[CloseCurlyDoubleQuote] ",
 StyleBox["DSolve", "Input"],
 " problem:"
}], "Text",
 CellChangeTimes->{{3.976610793058921*^9, 3.976610811227625*^9}, {
  3.9766109688174057`*^9, 3.9766110102340593`*^9}, {3.9766123568121567`*^9, 
  3.976612366087162*^9}, {3.976613482770261*^9, 3.976613486731803*^9}, {
  3.976613610292411*^9, 3.9766136117933197`*^9}, {3.9767190236661787`*^9, 
  3.976719024030974*^9}, {3.976719109475142*^9, 
  3.976719229490683*^9}},ExpressionUUID->"c237a011-840a-41f5-9c7c-\
4509464797dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[CapitalDelta]fCartesian", " ", "=", " ", 
  RowBox[{
   RowBox[{"Inactive", "[", "DSolve", "]"}], "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Laplacian", "[", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "\[Equal]", 
     RowBox[{"\[Lambda]", " ", 
      RowBox[{"f", "[", 
       RowBox[{"x", ",", "y"}], "]"}]}]}], ",", 
    RowBox[{"f", "[", 
     RowBox[{"x", ",", "y"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.976610848971839*^9, 3.9766108546983137`*^9}, {
  3.9766110257310677`*^9, 3.976611027032083*^9}, {3.9766124103043137`*^9, 
  3.976612415883669*^9}},
 CellLabel->
  "In[2798]:=",ExpressionUUID->"ab9f3157-5186-454f-a97b-40baafd3729c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{"DSolve"},
    "InactiveHead",
    BaseStyle->"InactiveTraditional",
    SyntaxForm->"Symbol",
    Tooltip->"Inactive[DSolve]"], "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["f", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"0", ",", "2"}], ")"}],
         Derivative],
        MultilineFunction->None], "(", 
       RowBox[{"x", ",", "y"}], ")"}], "+", 
      RowBox[{
       SuperscriptBox["f", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"2", ",", "0"}], ")"}],
         Derivative],
        MultilineFunction->None], "(", 
       RowBox[{"x", ",", "y"}], ")"}]}], "\[LongEqual]", 
     RowBox[{"\[Lambda]", " ", 
      RowBox[{"f", "(", 
       RowBox[{"x", ",", "y"}], ")"}]}]}], ",", 
    RowBox[{"f", "(", 
     RowBox[{"x", ",", "y"}], ")"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}], TraditionalForm]], "Output",
 CellChangeTimes->{{3.976610844399708*^9, 3.976610855134225*^9}, 
   3.976610888444647*^9, {3.976611027492587*^9, 3.976611034771916*^9}, 
   3.976612417262271*^9, 3.976612455237586*^9, {3.976612543604436*^9, 
   3.976612558821612*^9}, 3.976612594976665*^9, 3.976612628122601*^9, {
   3.97672387151863*^9, 3.9767240841808443`*^9}},
 CellLabel->
  "Out[2798]=",ExpressionUUID->"a7dc4f58-9c4e-4c30-971d-63db2a4c6051"]
}, Open  ]],

Cell[TextData[{
 "(There is another form of ",
 StyleBox["DSolve", "Input"],
 " where instead of \[OpenCurlyDoubleQuote]",
 StyleBox["f[x,y]", "Input"],
 "\[CloseCurlyDoubleQuote] you write \[OpenCurlyDoubleQuote]",
 StyleBox["f", "Input"],
 "\[CloseCurlyDoubleQuote], i.e. just the function, not with arguments. This \
one is a little easier to read, the other one is a little easier to use.)\n\
Mathematica can find one particular solution:"
}], "Text",
 CellChangeTimes->{{3.976611064966073*^9, 3.9766111698539658`*^9}, {
  3.976612384601582*^9, 3.976612385013093*^9}, {3.97661349972407*^9, 
  3.976613535774695*^9}},ExpressionUUID->"cda68351-297d-4352-8ca9-\
6e4abcbdc8f6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fExpl", " ", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], "/.", 
     RowBox[{"Activate", "[", "%", "]"}]}], "//", "First"}], " ", "//", 
   "Quiet"}]}]], "Input",
 CellChangeTimes->{{3.976612510963511*^9, 3.976612556298258*^9}, {
  3.976612586514954*^9, 3.9766125925393353`*^9}, {3.9767239861247473`*^9, 
  3.976724017651658*^9}},
 CellLabel->
  "In[2799]:=",ExpressionUUID->"0f3f9417-2068-4184-9eca-5bd2771d8250"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     SqrtBox[
      TemplateBox[{"5"},
       "CTraditional"]], " ", 
     RowBox[{"(", 
      RowBox[{"-", "x"}], ")"}]}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      TemplateBox[{"1"},
       "CTraditional"], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"2", " ", 
        SqrtBox[
         TemplateBox[{"5"},
          "CTraditional"]], " ", "x"}]]}], "+", 
     TemplateBox[{"2"},
      "CTraditional"]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      TemplateBox[{"4"},
       "CTraditional"], " ", 
      RowBox[{"cos", "(", 
       RowBox[{"y", " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"-", "\[Lambda]"}], "+", 
          TemplateBox[{"5"},
           "CTraditional"]}]]}], ")"}]}], "+", 
     RowBox[{
      TemplateBox[{"3"},
       "CTraditional"], " ", 
      RowBox[{"sin", "(", 
       RowBox[{"y", " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"-", "\[Lambda]"}], "+", 
          TemplateBox[{"5"},
           "CTraditional"]}]]}], ")"}]}]}], ")"}]}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{{3.976612513909471*^9, 3.976612560263225*^9}, 
   3.976612597293273*^9, 3.976612629664764*^9, {3.976723871556725*^9, 
   3.97672408420991*^9}},
 CellLabel->
  "Out[2799]=",ExpressionUUID->"6e336d42-14b7-426e-9c2d-d557c3d3919e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"%", "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"C", "[", "_", "]"}], "->", " ", "1"}], ",", 
     RowBox[{"\[Lambda]", "->", 
      RowBox[{"-", "1"}]}]}], "}"}]}], "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.976723844308928*^9, 3.976723906682702*^9}, {
  3.976723953741819*^9, 3.976723966764526*^9}, {3.976724024351985*^9, 
  3.976724081910781*^9}},
 CellLabel->
