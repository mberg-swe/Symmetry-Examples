Cell[TextData[{
 "Now apply the Laplacian \[CapitalDelta] to ",
 StyleBox["f",
  FontSlant->"Italic"],
 " in polar coordinates:"
}], "Text",
 CellChangeTimes->{{3.976613102111627*^9, 3.9766131064722958`*^9}, {
  3.9766135606008883`*^9, 3.976613565810857*^9}, {3.9767190570532913`*^9, 
