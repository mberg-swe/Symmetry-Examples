Cell["Check that it\[CloseCurlyQuote]s indeed a solution with eigenvalue \
\[Lambda]:", "Text",
 CellChangeTimes->{{3.976613539270883*^9, 3.9766135489217854`*^9}, {
  3.976719246097369*^9, 
  3.976719247023809*^9}},ExpressionUUID->"5cef01bc-c3e7-462a-9ac4-\
2d8380d6902b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Laplacian", "[", 
  RowBox[{"fExpl", ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "/", "fExpl"}], "   ", "//", "Simplify"}]}], "Input",
 CellChangeTimes->{{3.9766125220656853`*^9, 3.976612531451157*^9}, {
  3.976612604998831*^9, 3.976612624714408*^9}, {3.976613287261887*^9, 
  3.976613288789472*^9}, {3.976613411832101*^9, 3.9766134140707808`*^9}},
 CellLabel->
  "In[2802]:=",ExpressionUUID->"d0eb706b-ab77-4222-bfd7-09c5559668be"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{"5"},
     "CTraditional"], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      SqrtBox[
       TemplateBox[{"5"},
        "CTraditional"]], " ", 
      RowBox[{"(", 
       RowBox[{"-", "x"}], ")"}]}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       TemplateBox[{"1"},
        "CTraditional"], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", 
         SqrtBox[
          TemplateBox[{"5"},
           "CTraditional"]], " ", "x"}]]}], "+", 
      TemplateBox[{"2"},
       "CTraditional"]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       TemplateBox[{"4"},
        "CTraditional"], " ", 
       RowBox[{"cos", "(", 
        RowBox[{"y", " ", 
         SqrtBox[
          RowBox[{
           RowBox[{"-", "\[Lambda]"}], "+", 
           TemplateBox[{"5"},
            "CTraditional"]}]]}], ")"}]}], "+", 
      RowBox[{
       TemplateBox[{"3"},
        "CTraditional"], " ", 
       RowBox[{"sin", "(", 
        RowBox[{"y", " ", 
         SqrtBox[
          RowBox[{
           RowBox[{"-", "\[Lambda]"}], "+", 
           TemplateBox[{"5"},
            "CTraditional"]}]]}], ")"}]}]}], ")"}]}], "+", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      SqrtBox[
       TemplateBox[{"5"},
        "CTraditional"]], " ", 
      RowBox[{"(", 
       RowBox[{"-", "x"}], ")"}]}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       TemplateBox[{"1"},
        "CTraditional"], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", 
         SqrtBox[
          TemplateBox[{"5"},
           "CTraditional"]], " ", "x"}]]}], "+", 
      TemplateBox[{"2"},
       "CTraditional"]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        TemplateBox[{"4"},
         "CTraditional"]}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "\[Lambda]"}], "+", 
         TemplateBox[{"5"},
          "CTraditional"]}], ")"}], " ", 
       RowBox[{"cos", "(", 
        RowBox[{"y", " ", 
         SqrtBox[
          RowBox[{
           RowBox[{"-", "\[Lambda]"}], "+", 
           TemplateBox[{"5"},
            "CTraditional"]}]]}], ")"}]}], "-", 
      RowBox[{
       TemplateBox[{"3"},
        "CTraditional"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "\[Lambda]"}], "+", 
         TemplateBox[{"5"},
          "CTraditional"]}], ")"}], " ", 
       RowBox[{"sin", "(", 
        RowBox[{"y", " ", 
         SqrtBox[
          RowBox[{
           RowBox[{"-", "\[Lambda]"}], "+", 
           TemplateBox[{"5"},
            "CTraditional"]}]]}], ")"}]}]}], ")"}]}]}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{
  3.976612532195195*^9, 3.9766125637309713`*^9, {3.976612605585815*^9, 
   3.9766126315015287`*^9}, 3.976613289213914*^9, 3.976613414304675*^9, {
   3.976723871610273*^9, 3.976724084292636*^9}},
 CellLabel->
  "Out[2802]=",ExpressionUUID->"9b52ac2d-9451-49e6-b40e-d99105568e2d"],

Cell[BoxData[
 FormBox["\[Lambda]", TraditionalForm]], "Output",
 CellChangeTimes->{
  3.976612532195195*^9, 3.9766125637309713`*^9, {3.976612605585815*^9, 
   3.9766126315015287`*^9}, 3.976613289213914*^9, 3.976613414304675*^9, {
   3.976723871610273*^9, 3.976724084293653*^9}},
 CellLabel->
  "Out[2803]=",ExpressionUUID->"d07bf99f-9f48-4f4d-9b76-b41f79aa443f"]
}, Open  ]],

Cell[TextData[{
 "OK. In polar coordinates, the PDE \[CapitalDelta]",
 StyleBox["f",
  FontSlant->"Italic"],
 " = \[Lambda]",
 StyleBox["f",
  FontSlant->"Italic"],
 "  reads:"
}], "Text",
 CellChangeTimes->{{3.9766111792021027`*^9, 3.976611184885644*^9}, {
  3.976719248617766*^9, 3.976719260366706*^9}, {3.976724114968894*^9, 
  3.976724116775362*^9}},ExpressionUUID->"b428432b-10a9-4f15-b681-\
b4520fad0484"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[CapitalDelta]fPolar", " ", "=", 
  RowBox[{
   RowBox[{"DSolveChangeVariables", "[", 
    RowBox[{"\[CapitalDelta]fCartesian", ",", "f", ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "\[Theta]"}], "}"}], ",", 
     RowBox[{"\"\<Cartesian\>\"", "\[Rule]", "\"\<Polar\>\""}]}], "]"}], "//",
    "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.9766108431298103`*^9, 3.976610868019582*^9}},
 CellLabel->
  "In[2804]:=",ExpressionUUID->"8a487e9d-470b-4062-b608-6c66f483e951"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{"DSolve"},
    "InactiveHead",
    BaseStyle->"InactiveTraditional",
    SyntaxForm->"Symbol",
    Tooltip->"Inactive[DSolve]"], "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["f", 
         TagBox[
          RowBox[{"(", 
           RowBox[{"0", ",", "2"}], ")"}],
          Derivative],
         MultilineFunction->None], "(", 
        RowBox[{"r", ",", "\[Theta]"}], ")"}], 
       SuperscriptBox["r", "2"]], "+", 
      FractionBox[
       RowBox[{
        SuperscriptBox["f", 
         TagBox[
          RowBox[{"(", 
           RowBox[{"1", ",", "0"}], ")"}],
          Derivative],
         MultilineFunction->None], "(", 
        RowBox[{"r", ",", "\[Theta]"}], ")"}], "r"], "+", 
      RowBox[{
       SuperscriptBox["f", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"2", ",", "0"}], ")"}],
         Derivative],
        MultilineFunction->None], "(", 
       RowBox[{"r", ",", "\[Theta]"}], ")"}]}], "\[LongEqual]", 
     RowBox[{"\[Lambda]", " ", 
      RowBox[{"f", "(", 
       RowBox[{"r", ",", "\[Theta]"}], ")"}]}]}], ",", 
    RowBox[{"f", "(", 
     RowBox[{"r", ",", "\[Theta]"}], ")"}], ",", 
    RowBox[{"{", 
     RowBox[{"r", ",", "\[Theta]"}], "}"}]}], "]"}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{
  3.976610708910326*^9, 3.976610868441319*^9, 3.9766109351559963`*^9, 
   3.9766110439328613`*^9, 3.9766123868989487`*^9, 3.9766124196482077`*^9, 
   3.976612659172345*^9, 3.976612762432786*^9, {3.9767238716373367`*^9, 
   3.976724084303911*^9}},
 CellLabel->
  "Out[2804]=",ExpressionUUID->"2ac724f8-2377-4b1f-b866-4623a20113ac"]
}, Open  ]],

Cell["\<\
Here Mathematica used this internal data,
that you know:\
\>", "Text",
 CellChangeTimes->{{3.976612882537402*^9, 3.97661289195996*^9}, {
  3.976719036118609*^9, 
  3.9767190399666758`*^9}},ExpressionUUID->"73f9eff4-f481-496c-ae91-\
7f984fafc4bc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CoordinateTransformData", "[", 
  RowBox[{
   RowBox[{"\"\<Polar\>\"", "\[Rule]", "\"\<Cartesian\>\""}], 
   ",", "\"\<Mapping\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{"r", ",", "\[Theta]"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9766128769879093`*^9, 3.976612879596961*^9}},
 CellLabel->
  "In[2805]:=",ExpressionUUID->"c377ba39-8451-497a-bfe3-f6834b343f2c"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"r", " ", 
     RowBox[{"cos", "(", "\[Theta]", ")"}]}], ",", 
    RowBox[{"r", " ", 
     RowBox[{"sin", "(", "\[Theta]", ")"}]}]}], "}"}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{
  3.9766128799982653`*^9, {3.976723871641975*^9, 3.976724084306439*^9}},
 CellLabel->
  "Out[2805]=",ExpressionUUID->"5eb2b8fb-8b55-4e52-b461-8708f4aa222f"]
}, Open  ]],

Cell["so we can just plug in the change of variables:", "Text",
 CellChangeTimes->{{3.97671904166719*^9, 3.9767190502923117`*^9}, {
  3.976724137057313*^9, 
  3.9767241441502037`*^9}},ExpressionUUID->"5cc38459-8724-42c6-af16-\
f6a88ef182e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fExplPolar", " ", "=", " ", 
  RowBox[{"fExpl", " ", "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "->", 
      RowBox[{"r", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ",", 
     RowBox[{"y", "->", 
      RowBox[{"r", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.9766130542161903`*^9, 3.9766130788887787`*^9}, {
  3.976613114207209*^9, 3.976613115571333*^9}},
 CellLabel->
  "In[2806]:=",ExpressionUUID->"0e8de83c-34b5-48ab-9dfc-1784848216a9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     SqrtBox[
      TemplateBox[{"5"},
       "CTraditional"]], " ", 
     RowBox[{"(", 
      RowBox[{"-", "r"}], ")"}], " ", 
     RowBox[{"cos", "(", "\[Theta]", ")"}]}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      TemplateBox[{"1"},
       "CTraditional"], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"2", " ", 
        SqrtBox[
         TemplateBox[{"5"},
          "CTraditional"]], " ", "r", " ", 
        RowBox[{"cos", "(", "\[Theta]", ")"}]}]]}], "+", 
     TemplateBox[{"2"},
      "CTraditional"]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      TemplateBox[{"3"},
       "CTraditional"], " ", 
      RowBox[{"sin", "(", 
       RowBox[{"r", " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"-", "\[Lambda]"}], "+", 
          TemplateBox[{"5"},
           "CTraditional"]}]], " ", 
        RowBox[{"sin", "(", "\[Theta]", ")"}]}], ")"}]}], "+", 
     RowBox[{
      TemplateBox[{"4"},
       "CTraditional"], " ", 
      RowBox[{"cos", "(", 
       RowBox[{"r", " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"-", "\[Lambda]"}], "+", 
          TemplateBox[{"5"},
           "CTraditional"]}]], " ", 
        RowBox[{"sin", "(", "\[Theta]", ")"}]}], ")"}]}]}], ")"}]}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{{3.976613068969241*^9, 3.97661308029055*^9}, 
   3.9766131158881607`*^9, {3.97672387164609*^9, 3.976724084313364*^9}},
 CellLabel->
  "Out[2806]=",ExpressionUUID->"d1a2e247-a3df-4016-935e-ed1a83c61411"]
}, Open  ]],

