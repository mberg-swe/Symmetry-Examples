Cell["\<\
On the input labelled (g,h), join then split lists factorizations of gh. \
Split h first gives pairs (a,b) with ab = h; joining g to the left label \
changes each to (ga,b). Split g first gives pairs (a,b) with ab = g; joining \
h to the right label changes each to (a,bh). These are the only operations in \
the next cell.\
\>", "Text",ExpressionUUID->"a0255bdc-a5c7-4f8b-a0dd-061c9d6cb1e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"joinThenSplit", "[", 
    RowBox[{"p_", ",", "q_"}], "]"}], ":=", 
   RowBox[{"split", "[", 
    RowBox[{"product", "[", 
     RowBox[{"p", ",", "q"}], "]"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"splitRightThenJoin", "[", 
    RowBox[{"p_", ",", "q_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"product", "[", 
         RowBox[{"p", ",", 
          RowBox[{
          "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
         "]"}], ",", 
        RowBox[{
        "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "}"}],
       "&"}], ")"}], "/@", 
    RowBox[{"split", "[", "q", "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"splitLeftThenJoin", "[", 
    RowBox[{"p_", ",", "q_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        ",", 
        RowBox[{"product", "[", 
         RowBox[{
          RowBox[{
          "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
          "q"}], "]"}]}], "}"}], "&"}], ")"}], "/@", 
    RowBox[{"split", "[", "p", "]"}]}]}], ";", 
  TagBox[
   TemplateBox[{
     RowBox[{"{", 
       RowBox[{
         RowBox[{
           RowBox[{"(", 
             RowBox[{
               RowBox[{"name", "/@", "#1"}], "&"}], ")"}], "/@", 
           RowBox[{"joinThenSplit", "[", 
             RowBox[{"g", ",", "h"}], "]"}]}], ",", 
         RowBox[{
           RowBox[{"(", 
             RowBox[{
               RowBox[{"name", "/@", "#1"}], "&"}], ")"}], "/@", 
           RowBox[{"splitRightThenJoin", "[", 
             RowBox[{"g", ",", "h"}], "]"}]}], ",", 
         RowBox[{
           RowBox[{"(", 
             RowBox[{
               RowBox[{"name", "/@", "#1"}], "&"}], ")"}], "/@", 
           RowBox[{"splitLeftThenJoin", "[", 
             RowBox[{"g", ",", "h"}], "]"}]}]}], "}"}]},
    "Transpose"],
   Function[BoxForm`e$, 
    TableForm[
    BoxForm`e$, 
     TableHeadings -> {
      None, {"Join then split", "Split h; join on left", 
        "Split g; join on right"}}]]]}]], "Input",
 CellLabel->
  "In[196]:=",ExpressionUUID->"8e6f08a7-903e-465f-b8dd-bed187f76643"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"{", 
       RowBox[{"\<\"(123)\"\>", ",", "\<\"1\"\>"}], "}"}], 
      RowBox[{"{", 
       RowBox[{"\<\"(123)\"\>", ",", "\<\"1\"\>"}], "}"}], 
      RowBox[{"{", 
       RowBox[{"\<\"(12)\"\>", ",", "\<\"(23)\"\>"}], "}"}]},
     {
      RowBox[{"{", 
       RowBox[{"\<\"(12)\"\>", ",", "\<\"(23)\"\>"}], "}"}], 
      RowBox[{"{", 
       RowBox[{"\<\"(12)\"\>", ",", "\<\"(23)\"\>"}], "}"}], 
      RowBox[{"{", 
       RowBox[{"\<\"(123)\"\>", ",", "\<\"1\"\>"}], "}"}]},
     {
      RowBox[{"{", 
       RowBox[{"\<\"(13)\"\>", ",", "\<\"(12)\"\>"}], "}"}], 
      RowBox[{"{", 
       RowBox[{"\<\"(13)\"\>", ",", "\<\"(12)\"\>"}], "}"}], 
      RowBox[{"{", 
       RowBox[{"\<\"1\"\>", ",", "\<\"(123)\"\>"}], "}"}]},
     {
      RowBox[{"{", 
       RowBox[{"\<\"(132)\"\>", ",", "\<\"(132)\"\>"}], "}"}], 
      RowBox[{"{", 
       RowBox[{"\<\"(132)\"\>", ",", "\<\"(132)\"\>"}], "}"}], 
      RowBox[{"{", 
       RowBox[{"\<\"(23)\"\>", ",", "\<\"(13)\"\>"}], "}"}]},
     {
      RowBox[{"{", 
       RowBox[{"\<\"1\"\>", ",", "\<\"(123)\"\>"}], "}"}], 
      RowBox[{"{", 
       RowBox[{"\<\"1\"\>", ",", "\<\"(123)\"\>"}], "}"}], 
      RowBox[{"{", 
       RowBox[{"\<\"(13)\"\>", ",", "\<\"(12)\"\>"}], "}"}]},
     {
      RowBox[{"{", 
       RowBox[{"\<\"(23)\"\>", ",", "\<\"(13)\"\>"}], "}"}], 
      RowBox[{"{", 
       RowBox[{"\<\"(23)\"\>", ",", "\<\"(13)\"\>"}], "}"}], 
      RowBox[{"{", 
       RowBox[{"\<\"(132)\"\>", ",", "\<\"(132)\"\>"}], "}"}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.000003044799637*^9},
 CellLabel->
  "Out[196]=",ExpressionUUID->"d83d04dc-0cd4-40c3-a409-c99243ddc89b"]
}, Open  ]],

Cell["\<\
Rows need not match: each route may list the terms in a different order. \
Addition of tensors allows reordering. Sorting the lists compares the same \
basis terms with the same multiplicities; it does not commute the two labels \
within any pair.\
\>", "Text",ExpressionUUID->"f40bc290-1bb2-4bf4-a2a9-3d0ebbf20bfe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Sort", "[", 
     RowBox[{"joinThenSplit", "[", 
      RowBox[{"g", ",", "h"}], "]"}], "]"}], "\[Equal]", 
    RowBox[{"Sort", "[", 
     RowBox[{"splitRightThenJoin", "[", 
      RowBox[{"g", ",", "h"}], "]"}], "]"}]}], ",", 
   RowBox[{
    RowBox[{"Sort", "[", 
     RowBox[{"joinThenSplit", "[", 
      RowBox[{"g", ",", "h"}], "]"}], "]"}], "\[Equal]", 
    RowBox[{"Sort", "[", 
     RowBox[{"splitLeftThenJoin", "[", 
      RowBox[{"g", ",", "h"}], "]"}], "]"}]}]}], "}"}]], "Input",
 CellLabel->
  "In[197]:=",ExpressionUUID->"8d90d890-84bf-47a9-b517-cd3b24a50861"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"True", ",", "True"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.000003044801674*^9},
 CellLabel->
  "Out[197]=",ExpressionUUID->"2c1879f3-6407-4b08-b61e-97e923b88ed7"]
}, Open  ]],

Cell["\<\
Both answers are True. We have checked one noncommuting input pair. The \
reason it works for every pair is more informative than the computation.\
\>", "Text",ExpressionUUID->"449b6361-75eb-47e4-923b-400f0be29e51"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Why the condition holds for every finite group", "Section",ExpressionUUID->"54974fb4-a996-44c1-83b3-7bf4511a3dea"],

Cell[TextData[{
 "The first route lists all (u,v) with uv = gh. In the second route, (a,b) \
becomes (ga,b), and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"b", " ", 
    RowBox[{"(", 
     RowBox[{"a", " ", "g"}], ")"}]}], "\[LongEqual]", 
   RowBox[{"g", " ", 
    RowBox[{"(", 
     RowBox[{"a", " ", "b"}], ")"}]}], "\[LongEqual]", 
   RowBox[{"g", " ", "h"}]}]], "InlineFormula",ExpressionUUID->
  "5a33c2be-68bb-47c8-b166-fbb9fd90e850"],
 ". Conversely, from any (u,v) with uv = gh, recover the unique input labels ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"a", "\[LongEqual]", 
    RowBox[{"u", " ", 
     TemplateBox[{"g", 
       RowBox[{"-", "1"}]},
      "Superscript"]}]}], "\[And]", 
   RowBox[{"b", "\[LongEqual]", "v"}]}]], "InlineFormula",ExpressionUUID->
  "395494e7-ef67-438b-a2f0-7b34c36ddc8c"],
 ", whose product is h. Thus the second route lists every factorization \
exactly once."
}], "Text",ExpressionUUID->"60b89566-597b-4f7c-b47a-c336edade925"],

Cell[TextData[{
 "In the third route, (a,b) becomes (a,bh), with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"a", " ", 
    RowBox[{"(", 
     RowBox[{"b", " ", "h"}], ")"}]}], "\[LongEqual]", 
   RowBox[{"h", " ", 
    RowBox[{"(", 
     RowBox[{"a", " ", "b"}], ")"}]}], "\[LongEqual]", 
   RowBox[{"g", " ", "h"}]}]], "InlineFormula",ExpressionUUID->
  "d66599eb-57e7-4cf7-a1e6-9ee9d6a65479"],
 ". The inverse correspondence has labels ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"a", "\[LongEqual]", "u"}], "\[And]", 
   RowBox[{"b", "\[LongEqual]", 
    RowBox[{"v", " ", 
     TemplateBox[{"h", 
       RowBox[{"-", "1"}]},
      "Superscript"]}]}]}]], "InlineFormula",ExpressionUUID->
  "b02574ee-55dc-4f61-9bda-4e62aa036359"],
 ". Again there is neither a missing term nor an extra term. All three sums \
therefore agree for every finite group, without assuming commutativity."
}], "Text",ExpressionUUID->"633c9ee7-1a05-452b-bbb0-bdcc74f1c517"],

Cell["\<\
Each map is linear, so equality on all basis inputs proves equality on every \
element of A tensor A, including superpositions. The next cell verifies the \
36 basis inputs for S3; the bijection above is the general proof.\
\>", "Text",ExpressionUUID->"4e3ef4dd-2729-45a0-92da-f7838009bbef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"basisChecks", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{"joinThenSplit", "[", 
          RowBox[{"p", ",", "q"}], "]"}], "]"}], "\[Equal]", 
        RowBox[{"Sort", "[", 
         RowBox[{"splitRightThenJoin", "[", 
          RowBox[{"p", ",", "q"}], "]"}], "]"}]}], "&&", 
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{"joinThenSplit", "[", 
          RowBox[{"p", ",", "q"}], "]"}], "]"}], "\[Equal]", 
        RowBox[{"Sort", "[", 
         RowBox[{"splitLeftThenJoin", "[", 
          RowBox[{"p", ",", "q"}], "]"}], "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"p", ",", "elements"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"q", ",", "elements"}], "}"}]}], "]"}], "]"}]}], ";", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<Basis inputs tested\>\"", "\[Rule]", 
     RowBox[{"Length", "[", "basisChecks", "]"}]}], ",", 
    RowBox[{"\"\<Both Frobenius equalities hold\>\"", "\[Rule]", 
     RowBox[{"And", "@@", "basisChecks"}]}]}], "]"}]}]], "Input",
 CellLabel->
  "In[198]:=",ExpressionUUID->"3eba33cc-de57-4395-bb4b-b19dcbffb0d5"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"\<\"Basis inputs tested\"\>", "\[Rule]", "36"}], ",", 
    RowBox[{"\<\"Both Frobenius equalities hold\"\>", "\[Rule]", "True"}]}], 
   "\[RightAssociation]"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.000003044813033*^9},
 CellLabel->
  "Out[198]=",ExpressionUUID->"f74d189f-7f3b-480e-afb1-f2d17a55fe8e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Why simply copying the label is different", "Section",ExpressionUUID->"0f3ae94b-e585-4780-923e-a3547a9e1440"],

Cell[TextData[{
 "The group algebra also has the Hopf coproduct ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "H"], "(", 
    SubscriptBox["e", "g"], ")"}], "\[LongEqual]", 
   RowBox[{
    SubscriptBox["e", "g"], "\[CircleTimes]", 
    SubscriptBox["e", "g"]}]}]], "InlineFormula",ExpressionUUID->
  "837b8673-5fad-4886-b64c-ec27d69e37b1"],
 ". This copies the group label into both slots. It is not the factorization \
coproduct used here. On our chosen input, joining then copying gives (gh,gh), \
whereas copying h then joining on the left gives (gh,h)."
}], "Text",ExpressionUUID->"fc783c34-6ed3-4a13-9af1-a97b747c343d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"hopfJoinThenCopy", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"product", "[", 
      RowBox[{"g", ",", "h"}], "]"}], ",", 
     RowBox[{"product", "[", 
      RowBox[{"g", ",", "h"}], "]"}]}], "}"}]}], ";", 
  RowBox[{"hopfCopyThenJoin", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"product", "[", 
      RowBox[{"g", ",", "h"}], "]"}], ",", "h"}], "}"}]}], ";", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<Join then copy\>\"", "\[Rule]", 
     RowBox[{"name", "/@", "hopfJoinThenCopy"}]}], ",", 
    RowBox[{"\"\<Copy h then join on left\>\"", "\[Rule]", 
     RowBox[{"name", "/@", "hopfCopyThenJoin"}]}], ",", 
    RowBox[{"\"\<Frobenius equality\>\"", "\[Rule]", 
     RowBox[{"hopfJoinThenCopy", "\[Equal]", "hopfCopyThenJoin"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[199]:=",ExpressionUUID->"36c6e792-b573-40a7-a8d8-d45dc9491eb0"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"\<\"Join then copy\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\<\"(123)\"\>", ",", "\<\"(123)\"\>"}], "}"}]}], ",", 
    RowBox[{"\<\"Copy h then join on left\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\<\"(123)\"\>", ",", "\<\"(23)\"\>"}], "}"}]}], ",", 
    RowBox[{"\<\"Frobenius equality\"\>", "\[Rule]", "False"}]}], 
   "\[RightAssociation]"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.000003044815115*^9},
 CellLabel->
  "Out[199]=",ExpressionUUID->"31331e9b-d795-4a62-83e7-857ddf8a6de7"]
}, Open  ]],

Cell["\<\
The False answer is the expected counterexample: these are two different \
basis tensors. It does not say the Hopf coproduct is invalid; it obeys a \
different compatibility with multiplication.\
\>", "Text",ExpressionUUID->"348cf5fd-b50f-45dd-afea-79707864d316"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Counit and normalization: connect back to the notes", "Section",ExpressionUUID->"96b94426-05f4-4f4a-a790-375a9b4b9559"],

Cell[TextData[{
 "For any nonzero complex number c set ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "c"], "[", 
    SubscriptBox["e", "g"], "]"}], "=", "c", 
   UnderscriptBox["\[Sum]", 
    RowBox[{"a", " ", "b", "=", "g"}]], 
   RowBox[{
    SubscriptBox["e", "a"], "\[CircleTimes]", 
    SubscriptBox["e", "b"]}]}]], "InlineFormula",ExpressionUUID->
  "99bea887-a75a-4093-acc8-12acc3dbb037"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", "c"], "(", 
    SubscriptBox["e", "g"], ")"}], "\[LongEqual]", 
   FractionBox[
    SubscriptBox["\[Delta]", 
     RowBox[{"1", " ", "g"}]], "c"]}]], "InlineFormula",ExpressionUUID->
  "1bb6c55d-066b-4c10-8a66-8a41e9526e93"],
 ". The symbol on the right is the Kronecker delta: one for the identity \
label and zero otherwise. The unit remains ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[Eta]", "(", "1", ")"}], "\[LongEqual]", 
   SubscriptBox["e", "1"]}]], "InlineFormula",ExpressionUUID->
  "39b5a216-4a06-42bb-b7a5-0cb42b7c9b2a"],
 "."
}], "Text",ExpressionUUID->"817a523d-33c1-4382-a947-475bfba9fb93"],

Cell["\<\
The counit removes one output: only the term with identity in that slot \
survives, and the factors c and 1/c cancel. This returns the original basis \
vector. Every Frobenius route contains one splitting, so rescaling it \
multiplies all three routes by the same c. Coassociativity contains two \
splittings on either side; both sides list each triple factorization once \
with coefficient c squared.\
\>", "Text",ExpressionUUID->"27a2d440-ce5f-480e-b3fe-653e458220ff"],

Cell[TextData[{
 "Joining after splitting returns the same label six times: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[Mu]", "\[SmallCircle]", 
      SubscriptBox["\[CapitalDelta]", "c"]}], ")"}], "\[InvisibleApplication]", 
    RowBox[{"(", 
     SubscriptBox["e", "g"], ")"}]}], "\[LongEqual]", 
   RowBox[{"6", " ", "c", " ", 
    SubscriptBox["e", "g"]}]}]], "InlineFormula",ExpressionUUID->
  "b03783a0-bfe7-43e3-a6dc-0d85e6683e21"],
 ". Also ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", "c"], "(", 
    RowBox[{"\[Eta]", "(", "1", ")"}], ")"}], "\[LongEqual]", 
   FractionBox["1", "c"]}]], "InlineFormula",ExpressionUUID->
  "a852a84c-b72e-4a42-9868-e4cde2bf747f"],
 ". More generally, replace six by the order of the finite group."
}], "Text",ExpressionUUID->"bfad1aa6-f9a0-40f2-be98-cabb69e05b23"],

Cell[CellGroupData[{

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      TagBox["\"\<Convention\>\"",
       HoldForm], 
      TagBox["\"\<c\>\"",
       HoldForm], 
      TagBox["\"\<Scalar in join after split\>\"",
       HoldForm], 
      TagBox["\"\<Counit after unit\>\"",
       HoldForm]},
     {"\"\<Initial teaching convention\>\"", "1", "6", "1"},
     {"\"\<Notes (17.38)\>\"", "6", "36", 
      FractionBox["1", "6"]},
     {"\"\<Special convention (17.42)\>\"", 
      FractionBox["1", "6"], "1", "6"}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxDividers->{
     "Columns" -> {{False}}, "Rows" -> {False, True, {False}, False}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[2.0999999999999996`]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}],
   {None, OutputFormsDump`HeadedColumns}],
  Function[BoxForm`e$, 
   TableForm[
   BoxForm`e$, 
    TableHeadings -> {
     None, {"Convention", "c", "Scalar in join after split", 
       "Counit after unit"}}]]]], "Input",
 CellLabel->
  "In[200]:=",ExpressionUUID->"1d7bbd00-e588-40ad-8c04-f5d866b56df7"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"\<\"Initial teaching convention\"\>", "1", "6", "1"},
     {"\<\"Notes (17.38)\"\>", "6", "36", 
      FractionBox["1", "6"]},
     {"\<\"Special convention (17.42)\"\>", 
      FractionBox["1", "6"], "1", "6"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0000030448176813`*^9},
 CellLabel->
  "Out[200]=",ExpressionUUID->"861c9bc2-ab7d-4e84-a5ce-81f644a93cee"]
}, Open  ]],

Cell["\<\
The notes use c = |G|, hence c = 6 for S3. That structure is Frobenius but is \
not special with the definition (17.42). Choosing c = 1/|G| makes joining \
after splitting the identity, and the counit after the unit equals dim(A) = \
|G|. Both special conditions then hold. This distinction is a change of \
normalization, not a contradiction in the notes.\
\>", "Text",ExpressionUUID->"0eac8927-00e1-4ae1-857e-283d00ed87f2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Check your understanding", "Section",ExpressionUUID->"954ae926-a85e-4bf4-be97-330397d48bcd"],

Cell["\<\
Before opening the optional matrix check: (a) Write all six inverse pairs in \
the splitting of the identity. (b) Explain why reordering the six terms is \
allowed but swapping the two slots is a different operation. (c) For a group \
of order N, choose c to make joining after splitting the identity. (d) \
Explain where the proof in Section 4 uses an inverse, and why commutativity \
is unnecessary.\
\>", "Text",ExpressionUUID->"0922924d-4ce0-4843-8087-c4911e213531"],

Cell["\<\
Answers: (a) (1,1), ((23),(23)), ((12),(12)), ((123),(132)), ((132),(123)), \
((13),(13)). (b) Addition is commutative, but tensor slots are ordered. (c) c \
= 1/N, with counit value N on the identity basis vector. (d) The inverse maps \
recover (g inverse times u,v) and (u,v times h inverse); associativity gives \
the product equalities.\
\>", "Text",ExpressionUUID->"f75a0b32-7139-404c-b925-35509f9c1f76"],

Cell["\<\
The idea to retain is the bijection of factorizations. Matrix calculations \
below verify the same maps and all algebra/coalgebra axioms, and show a \
superposition explicitly. They are optional; no index-contraction machinery \
is needed to understand the proof.\
\>", "Text",ExpressionUUID->"7fcd9fda-3649-4447-915c-fa466d3e13f5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Optional matrix check: maps, axioms and a superposition", "Section",ExpressionUUID->"43b2da8f-8d18-4b4c-878c-ea08d115bb8f"],

Cell["\<\
Matrices are built from the basis images already described. Each column is \
the output on one input basis vector. Tensor pairs follow Tuples[elements,2], \
so the second label changes fastest. We display dimensions and Boolean \
checks, not large arrays.\
\>", "Text",ExpressionUUID->"c1349977-12c6-472f-b58a-68a2ca7e3181"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"Length", "[", "elements", "]"}]}], ";", 
  RowBox[{"pairBasis", "=", 
   RowBox[{"Tuples", "[", 
    RowBox[{"elements", ",", "2"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"vector", "[", "p_", "]"}], ":=", 
   RowBox[{"UnitVector", "[", 
    RowBox[{"n", ",", 
     RowBox[{"First", "[", 
      RowBox[{"FirstPosition", "[", 
       RowBox[{"elements", ",", "p"}], "]"}], "]"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"tensorVector", "[", 
    RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"u", ",", "v"}], "]"}], "]"}]}], ";", 
  RowBox[{"mu", "=", 
   TemplateBox[{
     RowBox[{"Table", "[", 
       RowBox[{
         RowBox[{"vector", "[", 
           RowBox[{"product", "@@", "pair"}], "]"}], ",", 
         RowBox[{"{", 
           RowBox[{"pair", ",", "pairBasis"}], "}"}]}], "]"}]},
    "Transpose"]}], ";", 
  RowBox[{"deltaOne", "=", 
   TemplateBox[{
     RowBox[{"Table", "[", 
       RowBox[{
         RowBox[{"Total", "[", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 RowBox[{"tensorVector", "[", 
                   RowBox[{
                    RowBox[{"vector", "[", 
                    
                    RowBox[{
                    "#1", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "]"}], ",", 
                    RowBox[{"vector", "[", 
                    
                    RowBox[{
                    "#1", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], "]"}]}], "]"}], "&"}], ")"}], 
             "/@", 
             RowBox[{"split", "[", "p", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
           RowBox[{"p", ",", "elements"}], "}"}]}], "]"}]},
    "Transpose"]}], ";", 
  RowBox[{"unit", "=", 
   TemplateBox[{
     RowBox[{"{", 
       RowBox[{"vector", "[", "identity", "]"}], "}"}]},
    "Transpose"]}], ";", 
  RowBox[{"counitOne", "=", 
   RowBox[{"{", 
    RowBox[{"vector", "[", "identity", "]"}], "}"}]}], ";", 
  RowBox[{"id", "=", 
   RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ";", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<Multiplication dimensions\>\"", "\[Rule]", 
     RowBox[{"Dimensions", "[", "mu", "]"}]}], ",", 
    RowBox[{"\"\<Splitting dimensions\>\"", "\[Rule]", 
     RowBox[{"Dimensions", "[", "deltaOne", "]"}]}], ",", 
    RowBox[{"\"\<Unit dimensions\>\"", "\[Rule]", 
     RowBox[{"Dimensions", "[", "unit", "]"}]}], ",", 
    RowBox[{"\"\<Counit dimensions\>\"", "\[Rule]", 
     RowBox[{"Dimensions", "[", "counitOne", "]"}]}]}], "]"}]}]], "Input",
 CellLabel->
  "In[201]:=",ExpressionUUID->"e31f0840-b4be-4285-864a-f278279594f9"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"\<\"Multiplication dimensions\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"6", ",", "36"}], "}"}]}], ",", 
    RowBox[{"\<\"Splitting dimensions\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"36", ",", "6"}], "}"}]}], ",", 
    RowBox[{"\<\"Unit dimensions\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"6", ",", "1"}], "}"}]}], ",", 
    RowBox[{"\<\"Counit dimensions\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "6"}], "}"}]}]}], "\[RightAssociation]"}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{4.000003044829269*^9},
 CellLabel->
  "Out[201]=",ExpressionUUID->"6482f02c-004c-4476-a391-c93386d93c3c"]
}, Open  ]],

Cell["\<\
The general nonzero scale remains symbolic. In the expressions below a dot \
composes linear maps and KroneckerProduct makes them act on separate tensor \
slots.\
\>", "Text",ExpressionUUID->"87c4a3ec-1146-4d88-887a-9c1390fa917a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", "c", "]"}], ";", 
  RowBox[{"deltaC", "=", 
   RowBox[{"c", " ", "deltaOne"}]}], ";", 
  RowBox[{"counitC", "=", 
   FractionBox["counitOne", "c"]}], ";", 
  RowBox[{"routeJoin", "=", 
   RowBox[{"deltaC", ".", "mu"}]}], ";", 
  RowBox[{"routeRight", "=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"mu", ",", "id"}], "]"}], ".", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"id", ",", "deltaC"}], "]"}]}]}], ";", 
  RowBox[{"routeLeft", "=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"id", ",", "mu"}], "]"}], ".", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"deltaC", ",", "id"}], "]"}]}]}], ";", 
  RowBox[{"studentChecks", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<Associativity\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"mu", ".", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"mu", ",", "id"}], "]"}]}], "\[Equal]", 
       RowBox[{"mu", ".", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"id", ",", "mu"}], "]"}]}]}]}], ",", 
     RowBox[{"\"\<Left unit\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"mu", ".", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"unit", ",", "id"}], "]"}]}], "\[Equal]", "id"}]}], ",", 
     RowBox[{"\"\<Right unit\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"mu", ".", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"id", ",", "unit"}], "]"}]}], "\[Equal]", "id"}]}], ",", 
     RowBox[{"\"\<Coassociativity\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"deltaC", ",", "id"}], "]"}], ".", "deltaC"}], "\[Equal]", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"id", ",", "deltaC"}], "]"}], ".", "deltaC"}]}]}], ",", 
     RowBox[{"\"\<Left counit\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"counitC", ",", "id"}], "]"}], ".", "deltaC"}], "\[Equal]", 
       "id"}]}], ",", 
     RowBox[{"\"\<Right counit\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"id", ",", "counitC"}], "]"}], ".", "deltaC"}], "\[Equal]", 
       "id"}]}], ",", 
     RowBox[{"\"\<Frobenius: split on right\>\"", "\[Rule]", 
      RowBox[{"routeJoin", "\[Equal]", "routeRight"}]}], ",", 
     RowBox[{"\"\<Frobenius: split on left\>\"", "\[Rule]", 
      RowBox[{"routeJoin", "\[Equal]", "routeLeft"}]}], ",", 
     RowBox[{"\"\<Join after split is 6 c times identity\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"mu", ".", "deltaC"}], "\[Equal]", 
       RowBox[{"6", " ", "c", " ", "id"}]}]}], ",", 
     RowBox[{"\"\<Counit after unit is 1/c\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"counitC", ".", "unit"}], "\[Equal]", 
       RowBox[{"{", 
        RowBox[{"{", 
         FractionBox["1", "c"], "}"}], "}"}]}]}], ",", 
     RowBox[{"\"\<Special at c=1/6\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"mu", ".", "deltaC"}], "/.", "\[VeryThinSpace]", 
          RowBox[{"c", "\[Rule]", 
           FractionBox["1", "6"]}]}], ")"}], "\[Equal]", "id"}], "&&", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"counitC", ".", "unit"}], "/.", "\[VeryThinSpace]", 
          RowBox[{"c", "\[Rule]", 
           FractionBox["1", "6"]}]}], ")"}], "\[Equal]", 
        RowBox[{"{", 
         RowBox[{"{", "6", "}"}], "}"}]}]}]}]}], "]"}]}], ";", 
  RowBox[{"studentChecks", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"studentChecks", ",", 
     RowBox[{
      RowBox[{"c", "\[Element]", 
       TemplateBox[{},
        "Complexes"]}], "&&", 
      RowBox[{"c", "\[NotEqual]", "0"}]}]}], "]"}]}], ";", 
  TagBox[
   RowBox[{"KeyValueMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", "studentChecks"}], "]"}],
   
   Function[BoxForm`e$, 
    TableForm[BoxForm`e$]]]}]], "Input",
 CellLabel->
  "In[202]:=",ExpressionUUID->"daa90bef-76b7-4f6b-8690-fcc1dcec4b9d"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"\<\"Associativity\"\>", "True"},
     {"\<\"Left unit\"\>", "True"},
     {"\<\"Right unit\"\>", "True"},
     {"\<\"Coassociativity\"\>", "True"},
     {"\<\"Left counit\"\>", "True"},
     {"\<\"Right counit\"\>", "True"},
     {"\<\"Frobenius: split on right\"\>", "True"},
     {"\<\"Frobenius: split on left\"\>", "True"},
     {"\<\"Join after split is 6 c times identity\"\>", "True"},
     {"\<\"Counit after unit is 1/c\"\>", "True"},
     {"\<\"Special at c=1/6\"\>", "True"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0000030448729067`*^9},
 CellLabel->
  "Out[202]=",ExpressionUUID->"ffd9e694-0061-4e56-a942-aaabeacdfe27"]
}, Open  ]],

Cell[TextData[{
 "A concrete superposition is ",
 Cell[BoxData[
  RowBox[{"x", "\[LongEqual]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       SubscriptBox["e", "g"]}], "+", 
      SubscriptBox["e", "1"]}], ")"}], "\[CircleTimes]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["e", "h"], "-", 
      RowBox[{"\[ImaginaryI]", " ", 
       SubscriptBox["e", "1"]}]}], ")"}]}]}]], "InlineFormula",ExpressionUUID->
  "7ebefce2-9675-4a9b-9962-7eff69564fe4"],
 ". At c = 1, compare all three outputs and list their nonzero coefficients. \
Linearity predicts that the answer is the sum of four splittings, with \
coefficients 1, -i, 2 and -2i."
}], "Text",ExpressionUUID->"c319961d-9ec9-4185-8a38-e4bdce7624d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"x", "=", 
   RowBox[{"tensorVector", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"vector", "[", "identity", "]"}], "+", 
      RowBox[{"2", " ", 
       RowBox[{"vector", "[", "g", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"vector", "[", "h", "]"}], "-", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"vector", "[", "identity", "]"}]}]}]}], "]"}]}], ";", 
  RowBox[{"y", "=", 
   RowBox[{"deltaOne", ".", "mu", ".", "x"}]}], ";", 
  RowBox[{"expected", "=", 
   RowBox[{
    RowBox[{"deltaOne", ".", 
     RowBox[{"vector", "[", "h", "]"}]}], "-", 
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"deltaOne", ".", 
      RowBox[{"vector", "[", "identity", "]"}]}]}], "+", 
    RowBox[{"2", " ", 
     RowBox[{"deltaOne", ".", 
      RowBox[{"vector", "[", 
       RowBox[{"product", "[", 
        RowBox[{"g", ",", "h"}], "]"}], "]"}]}]}], "-", 
    RowBox[{"2", " ", "\[ImaginaryI]", " ", 
     RowBox[{"deltaOne", ".", 
      RowBox[{"vector", "[", "g", "]"}]}]}]}]}], ";", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<All routes agree on the superposition\>\"", "\[Rule]", 
     RowBox[{
      RowBox[{"y", "\[Equal]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"routeRight", "/.", "\[VeryThinSpace]", 
          RowBox[{"c", "\[Rule]", "1"}]}], ")"}], ".", "x"}]}], "&&", 
      RowBox[{"y", "\[Equal]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"routeLeft", "/.", "\[VeryThinSpace]", 
          RowBox[{"c", "\[Rule]", "1"}]}], ")"}], ".", "x"}]}]}]}], ",", 
    RowBox[{"\"\<Four-term linear expansion agrees\>\"", "\[Rule]", 
     RowBox[{"y", "\[Equal]", "expected"}]}], ",", 
    RowBox[{"\"\<Nonzero output coefficients\>\"", "\[Rule]", 
     RowBox[{"Count", "[", 
      RowBox[{"y", ",", 
       RowBox[{"Except", "[", "0", "]"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellLabel->
  "In[203]:=",ExpressionUUID->"2fcb79d5-d7a8-4696-9091-71cf1eba8b0b"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"\<\"All routes agree on the superposition\"\>", "\[Rule]", 
     "True"}], ",", 
    RowBox[{"\<\"Four-term linear expansion agrees\"\>", "\[Rule]", "True"}], 
    ",", 
    RowBox[{"\<\"Nonzero output coefficients\"\>", "\[Rule]", "24"}]}], 
   "\[RightAssociation]"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.00000304487488*^9},
 CellLabel->
  "Out[203]=",ExpressionUUID->"e488fd59-553f-48c9-a640-8ba386053f98"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 TagBox[
  RowBox[{"Select", "[", 
   RowBox[{
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"name", "/@", "#1"}], ",", "#2"}], "}"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"pairBasis", ",", "y"}], "}"}]}], "]"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"Last", "[", "#1", "]"}], "\[NotEqual]", "0"}], "&"}]}], "]"}],
  Function[BoxForm`e$, 
   TableForm[
   BoxForm`e$, 
    TableHeadings -> {
     None, {"Output basis labels", "Coefficient"}}]]]], "Input",
 CellLabel->
  "In[204]:=",ExpressionUUID->"40413e82-81b4-4765-9ceb-eb238193742c"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"{", 
       RowBox[{"\<\"1\"\>", ",", "\<\"1\"\>"}], "}"}], 
      RowBox[{"-", "\[ImaginaryI]"}]},
