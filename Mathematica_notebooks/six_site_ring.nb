Cell["At time zero, the particle is entirely at site 0.", "Text",ExpressionUUID->"b6d0b3e5-6009-4390-ac2c-379fae8a7185"],

Cell[CellGroupData[{

Cell[BoxData[RowBox[{RowBox[{"probabilityAt", "[", "0", "]"}], "", RowBox[{"N", "[", "initial", "]"}]}]], "Input",
