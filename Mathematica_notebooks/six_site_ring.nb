Cell[CellGroupData[{

Cell["5. Start with the particle at one site", "Section",ExpressionUUID->"19f32175-2dbf-43b4-bf75-8a62aed2023c"],

Cell["\<\
A state localized at site 0 is a superposition of all six waves. Each wave \
then acquires its own energy-dependent phase. Interference between those \
phases changes the site probabilities.\
\>", "Text",ExpressionUUID->"74f81fc2-b753-444a-85d0-ae9698551b77"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"initial", "=", 
   RowBox[{
   "siteBasis", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ";", 
  RowBox[{"waveCoefficients", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     TemplateBox[{"fourier"},
      "ConjugateTranspose"], ".", "initial"}], "]"}]}], ";", 
  "waveCoefficients"}]], "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"b78b2e4f-210e-41ec-a461-77974e5ec662"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    FractionBox["1", 
     SqrtBox["6"]], ",", 
    FractionBox["1", 
     SqrtBox["6"]], ",", 
    FractionBox["1", 
     SqrtBox["6"]], ",", 
    FractionBox["1", 
     SqrtBox["6"]], ",", 
    FractionBox["1", 
     SqrtBox["6"]], ",", 
    FractionBox["1", 
     SqrtBox["6"]]}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{
  4.002991493077529*^9, {4.0029919843661957`*^9, 4.0029920067152157`*^9}, 
   4.0029920464698*^9, 4.0031429519860992`*^9},
 CellLabel->"Out[50]=",ExpressionUUID->"2dd9459c-6cc7-4a8c-97ca-e503538eaea7"]
}, Open  ]],

Cell[TextData[{
 "Time evolution multiplies the mth wave coefficient by ",
 Cell[BoxData[
  RowBox[{"exp", "(", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"\[ImaginaryI]", " ", 
      SubscriptBox["\[ExponentialE]", "m"], " ", "t"}], "\[HBar]"]}], ")"}]], 
  "InlineFormula",ExpressionUUID->"010da090-5734-4949-83e4-eaded5ce9102"],
 ". Using ",
 Cell[BoxData[
  RowBox[{"\[Tau]", "\[LongEqual]", 
   FractionBox[
    RowBox[{"J", " ", "t"}], "\[HBar]"]}]], "InlineFormula",ExpressionUUID->
  "4fd05685-b934-483c-be7f-ae300ca085f6"],
 ", only the energies in units of J are needed. The next function returns the \
six probabilities, in site order 0,\[Ellipsis],5."
}], "Text",ExpressionUUID->"be1419f8-3273-4d03-a691-b3726ac47fca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"stateAt", "[", "time_", "]"}], ":=", 
   RowBox[{
    RowBox[{"N", "[", "fourier", "]"}], ".", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        RowBox[{"N", "[", "energyUnits", "]"}], " ", "time"}], "]"}], " ", 
      RowBox[{"N", "[", "waveCoefficients", "]"}]}], ")"}]}]}], ";", 
  RowBox[{
   RowBox[{"probabilityAt", "[", "time_", "]"}], ":=", 
   RowBox[{"Chop", "[", 
    SuperscriptBox[
     RowBox[{"Abs", "[", 
      RowBox[{"stateAt", "[", "time", "]"}], "]"}], "2"], "]"}]}], ";", 
  RowBox[{"probabilityAt", "[", "0", "]"}]}]], "Input",
 CellChangeTimes->{{4.00299203643858*^9, 4.0029920434417152`*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"6b628e43-e244-45ff-b3cd-5be2699b5626"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
   "1.0000000000000004`", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
   "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{
  4.0029914930842037`*^9, {4.0029919843679333`*^9, 4.002992006716893*^9}, 
   4.002992046481348*^9, 4.003142951988492*^9},
 CellLabel->"Out[51]=",ExpressionUUID->"ff1cae49-fe9d-4423-b0c1-a8f75c083612"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"probabilityPlot", "[", 
    RowBox[{"values_", ",", "caption_"}], "]"}], ":=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     TemplateBox[{
       RowBox[{"{", 
         RowBox[{"siteLabels", ",", "values"}], "}"}]},
      "Transpose"], ",", 
     RowBox[{"Filling", "\[Rule]", "Axis"}], ",", 
     RowBox[{"PlotMarkers", "\[Rule]", "Automatic"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.3`"}], ",", "5.3`"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1.05`"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<site\>\"", ",", "\"\<probability\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "\[Rule]", "caption"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "360"}]}], "]"}]}], ";", 
  RowBox[{"probabilitySnapshots", "=", 
   RowBox[{"Column", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"probabilityPlot", "[", 
       RowBox[{
        RowBox[{"probabilityAt", "[", "time", "]"}], ",", 
        TemplateBox[{"\"tau = \"", "time"},
         "RowDefault"]}], "]"}], ",", 
      RowBox[{"{", 
