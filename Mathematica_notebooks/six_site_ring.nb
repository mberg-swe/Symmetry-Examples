Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ExponentialE]", "m"], "\[LongEqual]", 
   RowBox[{
    RowBox[{"-", "2"}], " ", "J", " ", 
    RowBox[{"cos", "(", 
     SubscriptBox["k", "m"], ")"}]}]}]], "InlineFormula",ExpressionUUID->
  "7704ec6b-15bf-4ef9-b3c2-377314d78635"],
 ". For J>0 the uniform wave has the lowest energy. The modes m and \
6\[Minus]m have equal energies because the hopping is equal in the two \
directions. Cyclic symmetry alone does not require these pairs to have equal \
energies; this Hamiltonian also has reflection symmetry."
}], "Text",ExpressionUUID->"e7bf2f94-1809-43ab-9ada-9b9f23d5b3c6"],

