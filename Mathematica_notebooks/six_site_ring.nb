Cell["\<\
Exercise: replace the number 2 in the defect energy by 0, then by a larger \
positive number. Predict how likely the particle is to remain near its \
initial site. A closed finite ring has unitary, recurrent dynamics; it is not \
an irreversible diffusion model.\
\>", "Text",ExpressionUUID->"2aa6fba6-d3f4-480e-ab4f-a07600aed948"],

Cell["\<\
At time 2, the Fourier-wave evolution agrees with the matrix exponential to \
within 10^-12 in every component.\
\>", "Text",ExpressionUUID->"48b16722-837d-4ed0-a529-8b6cdceed0e9"],

Cell[CellGroupData[{

Cell[BoxData[RowBox[{RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[{RowBox[{"stateAt", "[", "2", "]"}], "-", RowBox[{RowBox[{"MatrixExp", "[", RowBox[{RowBox[{"-", "2"}], " ", "", " ", "h0"}], "]"}], ".", "initial"}]}], "]"}], "]"}], "<", FractionBox["1", SuperscriptBox["10", "12"]]}]], "Input",
 CellTags->"ring-local-check-10",
 CellLabel->"In[60]:=",ExpressionUUID->"b8bc43bf-d0bc-48d6-8d68-dd3a68fbb1fd"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.003142952566763*^9},
 CellTags->"ring-local-check-10",
 CellLabel->"Out[60]=",ExpressionUUID->"010ec6c5-72b3-4575-9c76-2bf4a2757da2"]
}, Open  ]],

Cell["\<\
The defect of energy 2J breaks one-step translation symmetry: the commutator \
is nonzero.\
\>", "Text",ExpressionUUID->"c5b4fd21-635e-4a56-9fd6-1caba225d51b"],

Cell[CellGroupData[{

Cell[BoxData[RowBox[{TemplateBox[{RowBox[{RowBox[{"hDefect", ".", "shift"}], "-", RowBox[{"shift", ".", "hDefect"}]}]}, "Norm"], ">", "0"}]], "Input",
 CellTags->"ring-local-check-11",
 CellLabel->"In[61]:=",ExpressionUUID->"c347cd02-d8d1-4f8e-b557-b1c86aba543c"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.003142952571808*^9},
 CellTags->"ring-local-check-11",
 CellLabel->"Out[61]=",ExpressionUUID->"f4f702a2-e464-4278-99d8-7f8e1dde29a7"]
}, Open  ]],

Cell["\<\
The sine wave with a node at site 0 remains an eigenstate with energy -J, \
even with the defect.\
\>", "Text",ExpressionUUID->"b9930978-d5db-4a28-9d56-03b9d6d542e1"],

Cell[CellGroupData[{

Cell[BoxData[RowBox[{"FullSimplify", "[", RowBox[{RowBox[{"defectiveHamiltonian", ".", "nodeState"}], "", RowBox[{RowBox[{"-", "J"}], " ", "nodeState"}]}], "]"}]], "Input",
 CellTags->"ring-local-check-12",
 CellLabel->"In[62]:=",ExpressionUUID->"64d4e62a-ed07-405c-9356-826c908e0953"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.003142952577283*^9},
 CellTags->"ring-local-check-12",
 CellLabel->"Out[62]=",ExpressionUUID->"39d81d7c-9ba4-4bad-a143-b009e30f4987"]
}, Open  ]],

Cell[TextData[{
 "With the defect, total probability stays within ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "10d2749c-c3e4-4722-8553-ec92fc86a606"],
 " of one at times from 0 to 4 in steps of 1/4."
}], "Text",
 CellChangeTimes->{{4.003143270787673*^9, 
  4.0031432917388906`*^9}},ExpressionUUID->"a1d9168d-d52c-421b-a517-\
90d26a95d53d"],

Cell[CellGroupData[{

Cell[BoxData[RowBox[{RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[{"Table", "[", RowBox[{RowBox[{RowBox[{"Total", "[", RowBox[{"defectProbabilityAt", "[", "time", "]"}], "]"}], "-", "1"}], ",", RowBox[{"{", RowBox[{"time", ",", "0", ",", "4", ",", FractionBox["1", "4"]}], "}"}]}], "]"}], "]"}], "]"}], "<", FractionBox["1", SuperscriptBox["10", "12"]]}]], "Input",
 CellTags->"ring-local-check-13",
 CellLabel->"In[63]:=",ExpressionUUID->"84c5558b-b05a-47ac-a3db-98e87440a66b"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.003142952581614*^9},
 CellTags->"ring-local-check-13",
 CellLabel->"Out[63]=",ExpressionUUID->"d94f6c63-de34-4769-8d1b-4674321595b2"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
