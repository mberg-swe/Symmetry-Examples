Cell["\<\
The Fourier waves diagonalize the Hamiltonian, with the stated energies.\
\>", "Text",ExpressionUUID->"d41eb1f5-699e-4159-b6e6-3330d6238239"],

Cell[CellGroupData[{

Cell[BoxData[RowBox[{"energyMatrix", "", RowBox[{"DiagonalMatrix", "[", "energies", "]"}]}]], "Input",
 CellTags->"ring-local-check-6",
 CellLabel->"In[48]:=",ExpressionUUID->"fdd6044e-8f8a-4707-b5cb-e84d6dcc3eeb"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.0031429519794703`*^9},
 CellTags->"ring-local-check-6",
 CellLabel->"Out[48]=",ExpressionUUID->"5a6caa88-dced-4789-8480-711411558514"]
}, Open  ]],

Cell["\<\
In units of J, the six energies in wave-number order are -2, -1, 1, 2, 1 and \
-1.\
\>", "Text",ExpressionUUID->"b39f6cc6-1c8d-4f4f-869e-a12be7f15a6d"],

