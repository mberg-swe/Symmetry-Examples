Cell["\<\
The columns are the six waves. Our (active) translation shifts the amplitudes \
one site forward; this gives the phase with a minus sign. Check the \
convention instead of guessing it:\
\>", "Text",
 CellChangeTimes->{{4.003143120964003*^9, 
  4.0031431275262747`*^9}},ExpressionUUID->"9307cc1d-083b-4ba8-b4a5-\
86b4c9884091"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"translationPhases", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "waveNumbers"}], "]"}], "]"}]}], ";", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     TemplateBox[{"fourier"},
      "ConjugateTranspose"], ".", "shift", ".", "fourier"}], "\[Equal]", 
    RowBox[{"DiagonalMatrix", "[", "translationPhases", "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"a68c9ee0-43f7-4f96-9a29-12eda4b639c1"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{
  4.002991492984384*^9, {4.002991984323441*^9, 4.00299200667467*^9}, 
   4.002992046424014*^9, 4.00314295180462*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"2e15110a-1c68-4e01-9093-8430ca5e88f4"]
}, Open  ]],

Cell["\<\
Each one-dimensional wave space is invariant under translation. We have \
decomposed the six-dimensional regular representation into six \
one-dimensional complex representations, as discussed for finite abelian \
groups in \[Section]4.4.16.\
\>", "Text",ExpressionUUID->"6e967d92-d8dc-4b2a-9cbb-eded47991b98"],

Cell["The Fourier columns form an orthonormal basis.", "Text",ExpressionUUID->"e225b7e0-e022-4e8c-8c5f-ad0a0d9940f3"],

