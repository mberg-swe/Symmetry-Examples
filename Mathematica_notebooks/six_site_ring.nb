Cell[BoxData[RowBox[{"energyUnits", "", RowBox[{"{", RowBox[{RowBox[{"-", "2"}], ",", RowBox[{"-", "1"}], ",", "1", ",", "2", ",", "1", ",", RowBox[{"-", "1"}]}], "}"}]}]], "Input",
 CellTags->"ring-local-check-7",
 CellLabel->"In[49]:=",ExpressionUUID->"2a945a96-09d4-4c64-b237-358ceffd4083"],

