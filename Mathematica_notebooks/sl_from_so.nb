Cell[TextData[{
 "This agrees with Oblak section 2.3.3. \nAgain, if we pick \[Dash]",
 StyleBox["S2",
  FontSlant->"Italic"],
 " instead, we get the same f(",
 StyleBox["S2",
  FontSlant->"Italic"],
 "). \n\n",
 StyleBox["Example 3: can we get det f[S] \[NotEqual] 1? (No.)\n",
  FontWeight->"Bold"],
 "A matrix that looks like it might flip axes:"
}], "Text",
