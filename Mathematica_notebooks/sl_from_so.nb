Notebook[{
Cell[TextData[StyleBox["SL(2,\[DoubleStruckCapitalC]) and SO(3,1)", \
"Subsubsection"]], "Text",
 CellChangeTimes->{{3.936081267990038*^9, 3.936081273704835*^9}, {
  3.93619982299819*^9, 
  3.9361998543210573`*^9}},ExpressionUUID->"2373f5b1-e90c-44b2-8190-\
fc09c81725d5"],

Cell[TextData[{
 "Here I follow Oblak, https://arxiv.org/abs/1508.00920\nto show that the ",
 StyleBox["z",
  FontSlant->"Italic"],
 " of stereographic coordinates transforms as a M\[ODoubleDot]bius \
transformation (conformal transformation of a sphere) under Lorentz \
transformation of the coordinates ",
 StyleBox["x",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.9360812595900173`*^9, 3.936081266820581*^9}, {
  3.936081309096813*^9, 3.936081324999793*^9}, {3.936081638495235*^9, 
  3.936081697857234*^9}, {3.9361605614590473`*^9, 
  3.9361605685523653`*^9}},ExpressionUUID->"c957b36c-a5a5-460e-894d-\
7472f9c8afd4"],

