  3.936201094045192*^9}},ExpressionUUID->"21380100-6b68-413f-aacb-\
977cfee26407"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pointOnPlane", " ", "=", " ", 
  RowBox[{"First", "[", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"lineFromS", "[", 
       RowBox[{"[", "3", "]"}], "]"}], "==", "0"}], " ", ",", "t"}], "]"}], 
   "]"}]}]], "Input",
