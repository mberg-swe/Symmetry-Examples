Cell[TextData[{
 "OK. So now we know how r transforms. Call the factor ",
 StyleBox["F",
  FontSlant->"Italic"],
 "(",
 StyleBox["z,zb",
  FontSlant->"Italic"],
 "). \n\nHow does the stereographic coordinate",
 StyleBox[" z",
  FontSlant->"Italic"],
 " transform?"
}], "Text",
