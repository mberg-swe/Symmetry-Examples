Cell[TextData[{
 "Assembling the two real coordinates in the plane into a complex variable ",
 StyleBox["z",
  FontSlant->"Italic"],
 ":"
}], "Text",
 CellChangeTimes->{{3.936199991130826*^9, 3.93620001837714*^9}, {
  3.936201109993606*^9, 
  3.9362011196713247`*^9}},ExpressionUUID->"8192ed0f-9631-4c89-a6ac-\
357ca61842e2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"zExpl", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"%", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"%", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}], "/", "r"}], "    ", "//", 
   "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"zbExpl", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Conjugate", "[", "zExpl", "]"}], " ", "//", "ComplexExpand"}], "//",
    "Simplify"}]}]}], "Input",
 CellChangeTimes->{{3.936171837210031*^9, 3.936171864711203*^9}, {
  3.936171896093848*^9, 3.9361718984124203`*^9}, {3.936171956982126*^9, 
  3.936171957406303*^9}, {3.936172051368651*^9, 3.936172072663185*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"bcfff469-b5d1-43da-840c-d6fe64c5e91d"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    SubscriptBox["x", "1"], "+", 
    RowBox[{"\[ImaginaryI]", " ", 
     SubscriptBox["x", "2"]}]}], 
   RowBox[{"r", "+", 
    SubscriptBox["x", "3"]}]], TraditionalForm]], "Output",
 CellChangeTimes->{
  3.936171814924808*^9, {3.9361718461932507`*^9, 3.936171900756258*^9}, 
   3.936171960933325*^9, {3.936172060184411*^9, 3.936172076145279*^9}, 
   3.93617213017721*^9, 3.936173067668418*^9, 3.936174192038927*^9, {
   3.9361744873632307`*^9, 3.9361744961748857`*^9}, 3.936174529575913*^9, {
