Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"zwexpl", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"z", "->", " ", 
      RowBox[{"x1", " ", "+", " ", 
       RowBox[{"\[ImaginaryI]", " ", "y1"}]}]}], ",", 
     RowBox[{"w", "->", " ", 
      RowBox[{"x2", " ", "+", " ", 
       RowBox[{"\[ImaginaryI]", " ", "y2"}]}]}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"ComplexExpand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"z", " ", 
        RowBox[{"Conjugate", "[", "w", "]"}]}], "-", " ", 
       RowBox[{"w", " ", 
        RowBox[{"Conjugate", "[", "z", "]"}]}]}], "  ", "==", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", 
       RowBox[{"Im", "[", 
        RowBox[{"w", " ", 
         RowBox[{"Conjugate", "[", "z", "]"}]}], "]"}]}]}], "/.", "  ", 
     "zwexpl"}], " ", "]"}], "//", "Simplify"}]}]], "Input",
