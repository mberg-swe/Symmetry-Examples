Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"spc", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"2", " ", "x"}], ",", 
     RowBox[{"2", " ", "y"}], ",", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{"x", "^", "2"}], "+", 
      RowBox[{"y", "^", "2"}]}]}], "}"}], "/", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"x", "^", "2"}], "+", 
     RowBox[{"y", "^", "2"}]}], ")"}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mt", "[", 
    RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "]"}], "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{"Through", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"Re", ",", "Im"}], "}"}], "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"a", " ", "x"}], "+", 
       RowBox[{"a", " ", "I", " ", "y"}], "+", "b"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"c", " ", "x"}], "+", 
       RowBox[{"c", " ", "I", " ", "y"}], "+", "d"}], ")"}]}], "]"}], 
   "]"}]}], "\n", 
 RowBox[{
  RowBox[{"q", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"i", "-", "0.1"}], ",", 
           RowBox[{"j", "-", "0.1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"i", "-", "0.1"}], ",", "j"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "j"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"j", "-", "0.1"}]}], "}"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0.1", ",", "1", ",", "0.1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0.1", ",", "1", ",", "0.1"}], "}"}]}], "]"}], ",", 
     "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"col", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "[", 
      RowBox[{"#", "/", "100"}], "]"}], "&"}], "/@", 
    RowBox[{"Range", "[", "100", "]"}]}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"qm", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"mt", "[", 
          RowBox[{
           RowBox[{"Complex", "@@", "a"}], ",", 
           RowBox[{"Complex", "@@", "b"}], ",", 
           RowBox[{"Complex", "@@", "c"}], ",", 
           RowBox[{"Complex", "@@", "d"}]}], "]"}], "@@", "#"}], "&"}], ",", 
       "q", ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"planm", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"##", "~", "Join", "~", 
         RowBox[{"{", "0", "}"}]}], "&"}], ",", "qm", ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Graphics3D", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Opacity", "[", "0.4", "]"}], ",", 
        RowBox[{"InfinitePlane", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "}"}]}], "]"}], ",", 
        "LightBlue", ",", 
        RowBox[{"Sphere", "[", "]"}], ",", 
        RowBox[{"Opacity", "[", "1", "]"}], ",", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", 
             RowBox[{"Polygon", "@", "#2"}]}], "}"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"col", ",", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"spc", "@@", "#"}], "&"}], ",", "qm", ",", 
              RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", 
             RowBox[{"Polygon", "@", "#2"}]}], "}"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"col", ",", "planm"}], "}"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"Boxed", "->", "False"}], ",", 
      RowBox[{"Background", "->", "White"}], ",", 
      RowBox[{"FaceGrids", "->", "All"}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
         RowBox[{"{", "3", "}"}]}], "]"}]}]}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.1", ",", "0.1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"b", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"c", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.1", ",", "0.1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}], ",", 
   RowBox[{"ControlPlacement", "->", "Left"}]}], "]"}], "\n"}], "Input",
