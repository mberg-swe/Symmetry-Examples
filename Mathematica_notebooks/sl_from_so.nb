Cell[BoxData[{
 RowBox[{"S1", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        RowBox[{"\[Theta]", "/", "2"}]}], "]"}], ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"Exp", "[", 
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"\[Theta]", "/", "2"}]}], "]"}]}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"First", "[", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"S", "==", "S1"}], ",", 
    RowBox[{"Flatten", "[", "S", "]"}]}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"solfS", " ", "/.", " ", "%"}], "   ", "//", "ComplexExpand"}], 
  " ", "//", "ExpToTrig"}]}], "Input",
