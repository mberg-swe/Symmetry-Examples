 FormBox[
  RowBox[{"{", 
   RowBox[{"t", "\[Rule]", 
    FractionBox["r", 
     RowBox[{"r", "+", 
      SubscriptBox["x", "3"]}]]}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{{3.936171496067112*^9, 3.936171563667021*^9}, 
