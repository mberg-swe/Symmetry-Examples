Cell[TextData[{
 "Plug this into our large-r approximation for",
 StyleBox[" r\[CloseCurlyQuote]",
  FontSlant->"Italic"],
 ", to see how Lorentz transformations act on ",
 StyleBox["r  ",
  FontSlant->"Italic"],
 "through the SL matrix ",
 StyleBox["S",
  FontSlant->"Italic"],
 ":"
}], "Text",
