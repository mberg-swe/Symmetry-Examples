Cell[BoxData[
 RowBox[{"\[CapitalLambda]fromS", " ", "=", " ", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"fSMatrix", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"\[Mu]", "+", "1"}], ",", 
           RowBox[{"\[Nu]", "+", "1"}]}], "]"}], "]"}], "/.", " ", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "->", 
         RowBox[{"\[CapitalLambda]", "[", 
          RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}]}]}], ")"}], "->", 
      RowBox[{"solfS", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"\[Mu]", "+", "1"}], ",", 
         RowBox[{"\[Nu]", "+", "1"}]}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Mu]", ",", "0", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Nu]", ",", "0", ",", "3"}], "}"}]}], "]"}], "//", 
   "Flatten"}]}]], "Input",
