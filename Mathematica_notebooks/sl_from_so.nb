Cell[TextData[{
 StyleBox["Stereographic coordinates",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 "\nOblak eq. (3.17): draw a line from the south pole S to a point ",
 StyleBox["x",
  FontSlant->"Italic"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9360813872800283`*^9, 3.936081395175088*^9}, {
