Cell["Compare to Oblak:", "Text",
 CellChangeTimes->{{3.936200349416746*^9, 3.9362003585045443`*^9}, {
  3.936254445125139*^9, 
  3.936254484424365*^9}},ExpressionUUID->"ff9b4907-ffc0-43b0-812d-\
793e80efd729"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"solfS", "//.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"x_", " ", 
       RowBox[{"Conjugate", "[", "x_", "]"}]}], " ", "->", " ", 
      RowBox[{
       RowBox[{"Abs", "[", "x", "]"}], "^", "2"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x_", " ", 
         RowBox[{"Conjugate", "[", "y_", "]"}]}], "+", " ", 
        RowBox[{"y_", " ", 
         RowBox[{"Conjugate", "[", "x_", "]"}]}]}], ")"}], "->", " ", 
      RowBox[{"2", 
       RowBox[{"Re", "[", 
        RowBox[{"y", " ", 
         RowBox[{"Conjugate", "[", "x", "]"}]}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x_", " ", 
          RowBox[{"Conjugate", "[", "y_", "]"}]}], "+", " ", 
         RowBox[{"y_", " ", 
          RowBox[{"Conjugate", "[", "x_", "]"}]}]}], ")"}]}], "->", " ", 
      RowBox[{
       RowBox[{"-", "2"}], 
       RowBox[{"Re", "[", 
        RowBox[{"y", " ", 
         RowBox[{"Conjugate", "[", "x", "]"}]}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x_", " ", 
         RowBox[{"Conjugate", "[", "y_", "]"}]}], "-", " ", 
        RowBox[{"y_", " ", 
         RowBox[{"Conjugate", "[", "x_", "]"}]}]}], ")"}], "->", " ", 
      RowBox[{
       RowBox[{"-", "2"}], "\[ImaginaryI]", " ", 
       RowBox[{"Im", "[", 
        RowBox[{"y", " ", 
         RowBox[{"Conjugate", "[", "x", "]"}]}], "]"}]}]}]}], "}"}]}], "//", 
  "Expand"}]], "Input",
 CellChangeTimes->{{3.9361747035517817`*^9, 3.936174737272838*^9}, {
   3.936174767886739*^9, 3.936175051683206*^9}, {3.936175709322016*^9, 
   3.936175712758273*^9}, {3.93617577091698*^9, 3.936175814294922*^9}, 
   3.936175852216147*^9},
 CellLabel->"In[32]:=",ExpressionUUID->"b3bf7997-29ad-4c26-b098-1bda2f45242b"],

