Cell[TextData[{
 "OK. (There\[CloseCurlyQuote]s a sign typo in Oblak section 2.3.3.)\nIf we \
pick \[Dash]",
 StyleBox["S1",
  FontSlant->"Italic"],
 " instead, we get the same ",
 StyleBox["f",
  FontSlant->"Italic"],
 "(",
 StyleBox["S1",
  FontSlant->"Italic"],
 "). "
}], "Text",
