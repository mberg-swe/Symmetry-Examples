00ed7557c5e5"],

Cell[TextData[{
 "\nFinally, some entertainment:",
 StyleBox[" Manipulate", "Input"],
 " the numbers ",
 StyleBox["a, b, c, d",
  FontSlant->"Italic"],
 ". https://mathematica.stackexchange.com/questions/59271/m%C3%B6bius-\
transformations-revealed"
}], "Text",
