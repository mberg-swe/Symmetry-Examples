Cell[TextData[{
 "Awesome! This is a M\[ODoubleDot]bius transformation of ",
 StyleBox["z",
  FontSlant->"Italic"],
 ".\nThe sign in the 0 component was crucial to get this. (Try changing it, \
it becomes a mess.)"
}], "Text",
 CellChangeTimes->{{3.936200643683888*^9, 3.9362006640794487`*^9}, {
  3.936200894374318*^9, 3.936200959905793*^9}, {3.936201003267456*^9, 
