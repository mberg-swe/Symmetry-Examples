Cell[BoxData[
 RowBox[{"lineFromS", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"t", " ", 
     RowBox[{"x", "[", "1", "]"}]}], ",", 
    RowBox[{"t", " ", 
     RowBox[{"x", "[", "2", "]"}]}], ",", 
    RowBox[{
     RowBox[{"t", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "[", "3", "]"}], "+", "r"}], ")"}]}], "-", "r"}]}], 
   "}"}]}]], "Input",
