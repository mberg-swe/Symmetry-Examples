Cell[TextData[{
 "OK.\nThe rules above follow, since for any complex number z we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", "z"}], TraditionalForm]],ExpressionUUID->
  "4932fe90-9dac-45ee-b767-7ad08bafe0aa"],
 " \[Dash] ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["z", "_"], TraditionalForm]],ExpressionUUID->
  "8af407f2-3ab0-4494-8b17-a3110fe02327"],
 " =  2 \[ImaginaryI] Im[",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", "z"}], TraditionalForm]],ExpressionUUID->
  "14679478-c78b-4a3f-8c89-7a2cf8435428"],
 "], so setting z = ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    OverscriptBox["a", "_"]}], TraditionalForm]],ExpressionUUID->
  "273ab644-5903-4e31-a004-0bbff35822da"],
 StyleBox["b",
  FontSlant->"Italic"],
 ", we have",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    OverscriptBox["a", "_"]}], TraditionalForm]],ExpressionUUID->
  "67304a44-db3b-43bd-bfe7-fb068f83dfde"],
 StyleBox["b",
  FontSlant->"Italic"],
 " \[Dash] ",
 StyleBox["a",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   OverscriptBox["b", "_"], TraditionalForm]],ExpressionUUID->
  "93de14da-8f85-4960-9d46-b5dd31dbb7b8"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    OverscriptBox["a", "_"]}], TraditionalForm]],ExpressionUUID->
  "5e1e719d-5c25-4dee-bec1-2c446e2b40b5"],
 StyleBox["b",
  FontSlant->"Italic"],
 " \[Dash] ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    RowBox[{" ", 
     RowBox[{
      OverscriptBox["a", "_"], 
      StyleBox["b",
       FontSlant->"Italic"]}]}], "_"], TraditionalForm]],ExpressionUUID->
  "1885cdb3-766c-4b4f-a15b-18ba8a0f4534"],
 " = 2 \[ImaginaryI] Im[",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    OverscriptBox["a", "_"]}], TraditionalForm]],ExpressionUUID->
  "83f44c30-9dc5-4896-b2f8-58671bfafd4f"],
 StyleBox["b",
