    RowBox[{"t", " ", 
     SubscriptBox["x", "1"]}], ",", 
    RowBox[{"t", " ", 
     SubscriptBox["x", "2"]}], ",", 
    RowBox[{
     RowBox[{"t", " ", 
      RowBox[{"(", 
       RowBox[{"r", "+", 
        SubscriptBox["x", "3"]}], ")"}]}], "-", "r"}]}], "}"}], 
