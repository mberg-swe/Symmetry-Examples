Cell["The line intersects the plane when the 3rd entry is 0:", "Text",
 CellChangeTimes->{{3.9361999289664392`*^9, 
  3.936199964349231*^9}},ExpressionUUID->"0b77f6e1-2876-4910-9a9a-\
e31b54ac1fac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"lineFromS", "[", 
   RowBox[{"[", "3", "]"}], "]"}], "==", "0"}]], "Input",
