  RowBox[{
   RowBox[{
    RowBox[{"t", " ", 
     RowBox[{"(", 
      RowBox[{"r", "+", 
       SubscriptBox["x", "3"]}], ")"}]}], "-", "r"}], "\[LongEqual]", "0"}], 
  TraditionalForm]], "Output",
