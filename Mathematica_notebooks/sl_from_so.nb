Cell[TextData[{
 "This is inversion of ",
 StyleBox["two",
  FontSlant->"Italic"],
 " axes, ",
 StyleBox["x",
  FontSlant->"Italic"],
 " and ",
 StyleBox["z",
  FontSlant->"Italic"],
 ", not one. So the determinant is +1 (it\[CloseCurlyQuote]s in SO, not O).\n\
Spatial parity ",
 Cell[BoxData[
  SubscriptBox["\[CapitalLambda]", "P"]],
  CellChangeTimes->{{3.9362659127915573`*^9, 3.9362659305054483`*^9}, {
