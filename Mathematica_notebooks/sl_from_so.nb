Cell[TextData[{
 "All three coordinates scale with",
 StyleBox[" r",
  FontSlant->"Italic"],
 " (",
 StyleBox["r",
  FontSlant->"Italic"],
 " itself only approximately, but good enough) so ",
 StyleBox["r",
  FontSlant->"Italic"],
 " will cancel out. \nNeglect the finite coordinate value ",
 StyleBox["u",
  FontSlant->"Italic"],
 " when it stands next to",
 StyleBox[" r",
  FontSlant->"Italic"],
 ":"
}], "Text",
 CellChangeTimes->{{3.936178711837994*^9, 3.936178719473353*^9}, {
  3.9361800555463457`*^9, 3.936180072806387*^9}, {3.936180493295787*^9, 
