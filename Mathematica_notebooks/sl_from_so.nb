Cell[BoxData[
 RowBox[{"lorentz", " ", "=", " ", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", "\[Mu]", "]"}], "->", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalLambda]", "[", 
          RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "^", 
          RowBox[{"Boole", "[", 
           RowBox[{"\[Nu]", "==", "0"}], "]"}]}], 
         RowBox[{"x", "[", "\[Nu]", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Nu]", ",", "0", ",", "3"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Mu]", ",", "1", ",", "3"}], "}"}]}], "]"}], "/.", " ", 
   RowBox[{"(", 
    RowBox[{"bondi", "/.", " ", 
     RowBox[{"u", "->", "0"}]}], ")"}]}]}]], "Input",
