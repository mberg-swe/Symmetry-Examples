        HoldForm], "\<\"e\"\>", "\<\"r\"\>", "\<\"r2\"\>", "\<\"t\"\>", \
"\<\"rt\"\>", "\<\"r2t\"\>"},
      {
       TagBox["\<\"r\"\>",
        HoldForm], "\<\"r\"\>", "\<\"r2\"\>", "\<\"e\"\>", "\<\"rt\"\>", \
"\<\"r2t\"\>", "\<\"t\"\>"},
      {
       TagBox["\<\"r2\"\>",
        HoldForm], "\<\"r2\"\>", "\<\"e\"\>", "\<\"r\"\>", "\<\"r2t\"\>", "\<\
\"t\"\>", "\<\"rt\"\>"},
      {
       TagBox["\<\"t\"\>",
        HoldForm], "\<\"t\"\>", "\<\"r2t\"\>", "\<\"rt\"\>", "\<\"e\"\>", "\<\
\"r2\"\>", "\<\"r\"\>"},
      {
       TagBox["\<\"rt\"\>",
        HoldForm], "\<\"rt\"\>", "\<\"t\"\>", "\<\"r2t\"\>", "\<\"r\"\>", "\<\
\"e\"\>", "\<\"r2\"\>"},
      {
       TagBox["\<\"r2t\"\>",
        HoldForm], "\<\"r2t\"\>", "\<\"rt\"\>", "\<\"t\"\>", "\<\"r2\"\>", \
"\<\"r\"\>", "\<\"e\"\>"}
     },
     GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
     GridBoxDividers->{
      "Columns" -> {False, True, {False}, False}, 
       "Rows" -> {False, True, {False}, False}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[2.0999999999999996`]}, 
