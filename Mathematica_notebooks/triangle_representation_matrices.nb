Cell[CellGroupData[{

Cell["All six elements: the 2\[Times]2 matrices R(g)", "Subsubsection",ExpressionUUID->"1c1d9301-b783-47cc-b1b1-3b2ef0d3c38c"],

Cell[TextData[{
 "Every element is a product of the generators. Products act from right to \
left, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "t"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0a86990b-0c4d-4c66-a03e-2a496019a218"],
 " means: first ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e302fa13-4371-4f53-b6be-ef1a6430f7a5"],
 ", then ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "63d2e82c-c9a2-4ffd-8972-0c42fd6ce9a6"],
 ". The element ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "t"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0dcfd628-030c-41c3-b751-c12169ca554e"],
 " is the mirror (12), and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["r", "2"], "t"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b62717a5-e2cb-4e47-bb66-e92fdb3fdc91"],
 " is the mirror (13)."
}], "Text",ExpressionUUID->"7be6486b-2102-4d2a-9a6b-39ed32f42afd"],

