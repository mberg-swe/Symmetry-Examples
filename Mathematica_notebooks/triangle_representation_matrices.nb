Cell[TextData[{
 "Lecture 1 gave the relations ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["r", "3"], "=", "e"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0375d80f-4148-453b-b6d9-dd4b4dd9830e"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["t", "2"], "=", "e"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1b66aea1-701b-4531-a916-023571f9eee0"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "r", "t", "=", 
    SuperscriptBox["r", 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "84003d38-702b-42d6-8dbb-a2e28cf4934b"],
 ". The 6\[Times]6 matrices satisfy them. First the two sides of the third \
relation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "r", "t", "=", 
