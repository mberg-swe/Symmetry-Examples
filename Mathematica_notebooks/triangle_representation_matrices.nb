    {OutputFormsDump`HeadedRows, OutputFormsDump`HeadedColumns}],
   Function[BoxForm`e$, 
    TableForm[
    BoxForm`e$, 
     TableHeadings -> {{"e", "r", "r2", "t", "rt", "r2t"}, {
       "e", "r", "r2", "t", "rt", "r2t"}}]]], TraditionalForm]], "Output",
 CellChangeTimes->{4.0039395542537117`*^9},
