Cell[CellGroupData[{

Cell["The 6\[Times]6 matrices D(g) = P(g) \[CircleTimes] R(g)", \
"Subsubsection",ExpressionUUID->"0297c1b4-6c7e-4e8b-9a80-6e66ccd55b42"],

Cell[TextData[{
 "Mass ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f2dc900a-f501-4b7a-91be-4bfee36155c6"],
 " is ",
 StyleBox["displaced from its corner",
  FontWeight->"Bold"],
 " by a small arrow ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["x", "j"], ",", 
    SubscriptBox["y", "j"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"43f01fb6-b9d9-4748-9ad9-e76e88737cdc"],
 ". The six numbers are collected as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"u", "=", "(", 
    SubscriptBox["x", "1"], ",", 
    SubscriptBox["y", "1"], ",", 
    SubscriptBox["x", "2"], ",", 
    SubscriptBox["y", "2"], ",", 
    SubscriptBox["x", "3"], ",", 
    SubscriptBox["y", "3"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bd95599e-1795-4b38-a3b1-fce6c01b6cea"],
 ". A symmetry carries each arrow to a new corner and turns it, so it acts by \
the tensor product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "D", "(", "g", ")", "=", "P", "(", "g", ")", "\[CircleTimes]", "R", "(", 
    "g", ")"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "936aa6f3-b3fc-4965-b436-a1d9645c30ae"],
 ". In Mathematica the tensor product of two matrices is ",
 StyleBox["KroneckerProduct", "Input"],
 ". The name ",
 StyleBox["D",
  FontSlant->"Italic"],
 " is taken by the derivative in Mathematica, so the",
 StyleBox[" D",
  FontSlant->"Italic"],
 " matrices are called ",
 StyleBox["rep", "Input"],
 " here."
}], "Text",
 CellChangeTimes->{{4.00398749241424*^9, 
  4.003987498847571*^9}},ExpressionUUID->"1be43538-43c4-44d6-9348-\
42eda35c1550"],

Cell[CellGroupData[{

Cell["\<\
rep = Association[Table[g -> KroneckerProduct[P[g], R[g]], {g, Keys[R]}]]\
\>", "Input",
 CellChangeTimes->{4.0039880213170443`*^9},
 CellLabel->
  "In[167]:=",ExpressionUUID->"3b65292c-f1ca-43c5-8773-ba788121a76c"],

