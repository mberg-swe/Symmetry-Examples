Cell[TextData[{
 "Each 1 of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", "r", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"87bce6f2-77f9-47a1-87ed-7a167bc03fe9"],
 " has become a copy of the 2\[Times]2 rotation matrix. Written in blocks, \
the same matrix carries the arrow of mass 3 to corner 1, of mass 1 to corner \
2 and of mass 2 to corner 3, and turns each arrow:"
}], "Text",ExpressionUUID->"62172ee8-1b7c-4d6a-8159-11e38a56627b"],

