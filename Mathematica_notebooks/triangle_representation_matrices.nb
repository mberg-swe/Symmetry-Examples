Cell[TextData[{
 "The product of any two of the six matrices is again one of the six. The \
table shows which one: the entry in row ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "857efd4d-2f18-47ed-acbf-89ded7b93fe0"],
 " and column ",
 Cell[BoxData[
  FormBox["h", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7ee72112-52c6-4b99-bc1b-667a8d6fbd2b"],
 " is the element whose matrix equals ",
 Cell[BoxData[
  FormBox[
   RowBox[{"D", "(", "g", ")", "D", "(", "h", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"9bdb467f-b2f3-4d9f-baae-21ae44998aaa"],
 ". It is the multiplication table of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "3"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9f17893e-5c9f-413f-878d-c41e4584bd2d"],
 " (in this convention):"
}], "Text",
 CellChangeTimes->{{4.003987549411569*^9, 
  4.003987553732257*^9}},ExpressionUUID->"86b6b114-2ff8-4b52-bdcf-\
60242b763338"],

Cell[CellGroupData[{

Cell["\<\
elements = Keys[rep];
TableForm[
 Table[First[Select[elements, rep[#] == rep[g].rep[h] &]],
  {g, elements}, {h, elements}],
 TableHeadings -> {elements, elements}]\
\>", "Input",
 CellLabel->
  "In[134]:=",ExpressionUUID->"56cec3e8-a80e-4a23-a25f-993e35b1645e"],

Cell[BoxData[
 FormBox[
  TagBox[
   TagBox[GridBox[{
      {
       StyleBox["\[Null]",
        ShowStringCharacters->False], 
       TagBox["\<\"e\"\>",
        HoldForm], 
       TagBox["\<\"r\"\>",
        HoldForm], 
       TagBox["\<\"r2\"\>",
        HoldForm], 
       TagBox["\<\"t\"\>",
        HoldForm], 
       TagBox["\<\"rt\"\>",
        HoldForm], 
       TagBox["\<\"r2t\"\>",
        HoldForm]},
      {
