    Selectable->False],
   DefaultBaseStyle->"ImageGraphics",
   ImageSize->{50.951171875, Automatic},
   ImageSizeRaw->{146., 122.},
   PlotRange->{{0, 146.}, {0, 122.}}]], "Input",ExpressionUUID->
  "0baf9c6d-d004-4689-b50c-de461f56e31e"],
 "\nThree equal masses sit at the corners of a triangle and are joined by \
three equal springs. Mass 1 is at the top, mass 2 at the lower left, and mass \
3 at the lower right. This notebook writes down the matrices by which the six \
symmetries of the triangle act.\nPick the origin at the center of the \
triangle. \[LineSeparator]Coordinates of the three corners in ",
 StyleBox["x ",
  FontSlant->"Italic"],
 "and ",
 StyleBox["y",
  FontSlant->"Italic"],
 ":"
}], "Text",
 CellChangeTimes->{{4.0039871654512587`*^9, 4.003987248851575*^9}, {
  4.0039873079114733`*^9, 
  4.0039873476794453`*^9}},ExpressionUUID->"af79935b-2975-4410-abd2-\
05a8d991c300"],

Cell[CellGroupData[{

Cell["corner = {{0, 1}, {-Sqrt[3]/2, -1/2}, {Sqrt[3]/2, -1/2}}", "Input",
 CellLabel->
  "In[115]:=",ExpressionUUID->"594d52cf-7732-4294-989b-07e2221eaba6"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", "1"},
     {
      RowBox[{"-", 
       FractionBox[
        SqrtBox["3"], "2"]}], 
      RowBox[{"-", 
       FractionBox["1", "2"]}]},
     {
      FractionBox[
       SqrtBox["3"], "2"], 
      RowBox[{"-", 
       FractionBox["1", "2"]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0039395538296137`*^9},
 CellLabel->
  "Out[115]=",ExpressionUUID->"b88e87c6-d167-4876-ab10-aaad86e33454"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Two generators acting on the plane", "Subsubsection",ExpressionUUID->"dad021d0-c5cd-4c0c-b476-bec4b7a7e2ab"],

Cell[TextData[{
 "The symmetries of the triangle form the group ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "3"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9c9767e4-9ed3-43f8-b260-33fb891509f4"],
 ". As in lecture 1 it is generated by the rotation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", "(", "123", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"039388f6-780f-41d1-bc41-f2a91bcdcf9a"],
 " by 120\[Degree], counterclockwise, and the mirror ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "(", "23", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"04c8aa7e-96e3-4294-9b5e-4fa90b9d32e8"],
 " in the vertical axis, which reverses the ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "27e9e6bd-1999-43a0-8476-b000d622d69a"],
 "-coordinate."
}], "Text",ExpressionUUID->"5160940c-f10c-4717-b7f5-bad5a18ed039"],

Cell[CellGroupData[{

Cell["\<\
Rr = {{Cos[2 Pi/3], -Sin[2 Pi/3]}, {Sin[2 Pi/3], Cos[2 Pi/3]}}\
\>", "Input",
 CellChangeTimes->{{4.003976048783401*^9, 4.003976051756736*^9}},
 CellLabel->
  "In[152]:=",ExpressionUUID->"3f4820c9-36b1-46ae-aacb-10569cfb2923"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      RowBox[{"-", 
       FractionBox[
        SqrtBox["3"], "2"]}]},
     {
      FractionBox[
       SqrtBox["3"], "2"], 
      RowBox[{"-", 
       FractionBox["1", "2"]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0039760524324427`*^9},
 CellLabel->
  "Out[152]=",ExpressionUUID->"69a73717-4c4e-4256-99be-de2380ae56b2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Rt = {{-1, 0}, {0, 1}}", "Input",
 CellChangeTimes->{4.003976055774424*^9},
 CellLabel->
  "In[153]:=",ExpressionUUID->"673c4955-11fd-4a2d-9592-1bbfcbdd4c3e"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"-", "1"}], "0"},
     {"0", "1"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0039395541715813`*^9, 4.003976056087851*^9},
 CellLabel->
  "Out[153]=",ExpressionUUID->"166e02b6-43e4-4cac-8ffe-8bac088a1be8"]
}, Open  ]],

Cell[TextData[{
 "(Here ",
 StyleBox["R",
  FontSlant->"Italic"],
 " is for \[OpenCurlyDoubleQuote]Representation\[CloseCurlyDoubleQuote], \
whereas ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is for \[OpenCurlyDoubleQuote]rotation\[CloseCurlyDoubleQuote]). \nThe \
rotation carries corner 1 to corner 2, corner 2 to corner 3 and corner 3 to \
corner 1."
}], "Text",
 CellChangeTimes->{{4.0039873617041883`*^9, 
  4.0039873898680563`*^9}},ExpressionUUID->"7f0439e6-9d21-44b4-9443-\
2548f3d69de0"],

