Notebook[{

Cell[CellGroupData[{
Cell[TextData[StyleBox["Three polarizers: projection, order and transmitted \
intensity", "Subsubsection"]], "Title",ExpressionUUID->"dba18831-6416-43c9-\
95f3-16f0e32bc5ec"],

Cell[TextData[{
 "An initially unpolarized beam of light meets two ideal linear polarizers. \
If the two are at 90\:02da, they block the light, but a third polarizer \
inserted between them can reintroduce some light. The calculation is a short \
example of vectors, matrices and ",
 StyleBox["ordered composition ",
  FontSlant->"Italic"],
 "(to be explained below) Evaluate the cells from top to bottom."
}], "Text",
 CellChangeTimes->{{4.00286775022876*^9, 
  4.002867843755639*^9}},ExpressionUUID->"9d35e48c-663f-41f0-bf70-\
78bdb6eb9cb8"],

Cell["\<\
Source links: SMSA v7.7, \[Section]2.3.a \[OpenCurlyDoubleQuote]Wires and \
gates\[CloseCurlyDoubleQuote] (p.50), \[Section]2.3.b \
\[OpenCurlyDoubleQuote]Linear algebra\[CloseCurlyDoubleQuote] (p.52), \
especially (2.15)\[Dash](2.27), and \[Section]2.5.b \
\[OpenCurlyDoubleQuote]Dual vector space\[CloseCurlyDoubleQuote] (p.78). The \
notes supply the language of states, maps and composition. This polarizer \
example and its formulas are not themselves in the draft. \
\>", "Text",
 CellChangeTimes->{{4.002867865192071*^9, 
  4.0028678845372143`*^9}},ExpressionUUID->"7ec0e0b0-cd0c-4139-8034-\
e7e7f0de7fba"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1. Jones vectors and an ideal polarizer", \
"Subsubsection"]], "Section",ExpressionUUID->"f3c83df5-e67d-47b1-8dc1-\
d9395277cfd4"],

Cell[TextData[{
 "In optics, the usual horizontal and vertical basis vectors are called the \
",
 StyleBox["Jones basis:",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["e",
    FontWeight->"Bold"], "H"]], "InlineFormula",ExpressionUUID->
  "b92dd717-819e-4798-a692-445423430694"],
 " = (1,0) and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["e",
    FontWeight->"Bold"], "V"]], "InlineFormula",ExpressionUUID->
  "b5a2e3c7-1fb0-4125-90b2-5f0a34de9be8"],
 " = (0,1). The incident beam is horizontally polarized and has unit \
intensity. The angle is measured in radians, counterclockwise from horizontal."
}], "Text",
 CellChangeTimes->{{4.002868446783565*^9, 
  4.002868484251761*^9}},ExpressionUUID->"e2b5c52c-a1d9-4899-ae09-\
0709f68eceea"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", "]"}], "//", "Quiet"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"horizontal", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0"}], "}"}]}], ";", 
  RowBox[{"vertical", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"axis", "[", "angle_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", "angle", "]"}], ",", 
     RowBox[{"Sin", "[", "angle", "]"}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"intensity", "[", "vector_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Conjugate", "[", "vector", "]"}], ".", "vector"}]}], ";", 
  RowBox[{"{", 
   RowBox[{"horizontal", ",", "vertical", ",", 
    RowBox[{"intensity", "[", "horizontal", "]"}]}], "}"}]}]}], "Input",
 CellChangeTimes->{{4.002867899890491*^9, 4.002867904204987*^9}, 
   4.002867965882354*^9},
 CellLabel->
  "In[188]:=",ExpressionUUID->"c6e6c877-d349-4e22-9692-51403bfaa23b"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}], ",", "1"}], "}"}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{
  3.999910204882751*^9, 4.002867980833871*^9, 4.002868055460483*^9, 
   4.0028681096706257`*^9, 4.00286827184233*^9, 4.002868878405326*^9, {
   4.002990559370043*^9, 4.002990571174107*^9}},
 CellLabel->
  "Out[189]=",ExpressionUUID->"5f351206-c701-44a0-bb2d-4c6b6c15bfcb"]
}, Open  ]],

Cell[TextData[{
 "The ",
 StyleBox["polarizer operator",
  FontWeight->"Bold"],
 " with transmission axis ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["u",
    FontWeight->"Bold"], "\[Theta]"]], "InlineFormula",ExpressionUUID->
  "c4278c8a-96e9-4381-a66b-481d0d5331fc"],
 " is the real ",
 StyleBox["outer product",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P",
     FontWeight->"Bold"], "\[Theta]"], "=", 
   RowBox[{
    SubscriptBox[
     StyleBox["u",
      FontWeight->"Bold"], "\[Theta]"], 
    SuperscriptBox[
     SubscriptBox[
      StyleBox["u",
       FontWeight->"Bold"], "\[Theta]"], "T"]}]}]], "InlineFormula",
  ExpressionUUID->"da2277b7-1bd9-45e6-8469-326ce3688b04"],
 ". It ",
 StyleBox["keeps",
  FontSlant->"Italic"],
 " the component parallel to its axis, and ",
 StyleBox["removes",
  FontSlant->"Italic"],
 " the perpendicular component."
}], "Text",
 CellChangeTimes->{
  4.00286794606503*^9, {4.002868035043685*^9, 
   4.002868036043082*^9}},ExpressionUUID->"ddcc8053-8247-4e84-91c4-\
eec9142afa5a"],

Cell[BoxData[
 TagBox[
  RowBox[{
   RowBox[{
    RowBox[{"polarizer", "[", "angle_", "]"}], ":=", 
    RowBox[{"Outer", "[", 
     RowBox[{"Times", ",", 
      RowBox[{"axis", "[", "angle", "]"}], ",", 
      RowBox[{"axis", "[", "angle", "]"}]}], "]"}]}], ";"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Input",
 CellChangeTimes->{{4.002867967568191*^9, 4.0028679745931253`*^9}, 
   4.002868005158968*^9, {4.002868337851266*^9, 4.002868339010961*^9}, {
   4.002868412439495*^9, 4.002868419444235*^9}},
 CellLabel->
  "In[190]:=",ExpressionUUID->"b47e5a3e-cf27-4204-aaee-7f071294ed68"],

