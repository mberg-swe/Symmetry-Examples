Cell[CellGroupData[{

Cell[TextData[StyleBox["2. One polarizer gives Malus' law", \
"Subsubsection"]], "Section",ExpressionUUID->"2b51b7b6-93d3-4801-b4f7-\
735e469d9ee4"],

Cell[TextData[{
 "The output amplitude is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P",
     FontWeight->"Bold"], "\[Theta]"], 
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "H"]}]], "InlineFormula",ExpressionUUID->
  "9063c5d2-4782-4746-81ba-56569f056d25"],
 ". Physical intensity is Hermitian norm-squared, so if we had complex \
amplitudes, they would be conjugated. Note that this is different from the \
algebraic dual pairing in \[Section]2.5.b, which by itself has no \
conjugation.\nHere it\[CloseCurlyQuote]s real anyway:"
}], "Text",
 CellChangeTimes->{{4.002868623626652*^9, 
  4.002868651875575*^9}},ExpressionUUID->"d4bde577-794e-41fc-9e76-\
3ddee6ef8f9f"],

