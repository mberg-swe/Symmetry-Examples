Cell[TextData[{
 "This matrix ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["P",
    FontWeight->"Bold"], "\[Theta]"]],ExpressionUUID->
  "6fc7e02a-bf1d-41ee-bc95-88b16ee95010"],
 " is a projector, not a group element: it is Hermitian and idempotent, but \
it has rank one and is not invertible. Let\[CloseCurlyQuote]s make these \
statements explicit.\nProjector:"
}], "Text",
 CellChangeTimes->{{4.002868066165072*^9, 4.0028680838999367`*^9}, {
  4.0028685754429073`*^9, 
  4.0028685989245653`*^9}},ExpressionUUID->"d1af2efd-08e6-4bf8-a6a0-\
d06de3362e5f"],

