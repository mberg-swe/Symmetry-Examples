  3.9999102050006733`*^9, 4.002867981036667*^9, 4.002868055520159*^9, 
   4.0028681097474613`*^9, 4.0028682719066763`*^9, 4.0028686670700197`*^9, 
   4.002868878522156*^9, {4.002990559607193*^9, 4.002990571250502*^9}},
 CellLabel->
  "Out[200]=",ExpressionUUID->"f852ff06-bebc-4a16-b9f1-422dd4002274"]
}, Open  ]],

Cell[TextData[{
 "Thus the transmitted intensity is ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]], "InlineFormula",
  ExpressionUUID->"b7dfe182-5ef8-42af-9f54-b6bcd826388d"],
 ". This is Malus' law for an initially horizontal, already polarized beam. \
An unpolarized incident beam contributes an additional first-filter factor of \
",
 Cell[BoxData[
  FractionBox["1", "2"]], "InlineFormula",ExpressionUUID->
  "f3b62704-f643-4bd8-b8f2-3759a724dc6d"],
 "."
}], "Text",
 CellChangeTimes->{{4.002868689446941*^9, 
  4.002868697191914*^9}},ExpressionUUID->"e0889bbc-cbf8-4952-a3f2-\
0fa7b00e7e90"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["3. Two crossed polarizers", "Subsubsection"]], \
"Section",ExpressionUUID->"cf6b4e1f-3ca3-4c52-b720-053d4c651f00"],

Cell["\<\
Matrix multiplication represents a sequential apparatus, as in the \
composition rules around (2.15)\[Dash](2.27). Mathematica's Dot acts \
rightmost first. The following line means: horizontal input, then the \
horizontal polarizer, then the vertical polarizer.\
\>", "Text",
 CellChangeTimes->{{4.002868703242312*^9, 
  4.002868703278167*^9}},ExpressionUUID->"19ec30b4-c6a5-4913-b098-\
1cc199365357"],

Cell["horizontal beam  \[RightArrow]  P(0)  \[RightArrow]  P(\[Pi]/2)  \
\[RightArrow]  detector", "Text",ExpressionUUID->"a59b7222-1992-42f5-8519-\
d9caa750b457"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"crossedOutput", "=", 
  RowBox[{
   RowBox[{"polarizer", "[", 
    FractionBox["\[Pi]", "2"], "]"}], ".", 
   RowBox[{"polarizer", "[", "0", "]"}], ".", "horizontal"}]}]], "Input",
 CellChangeTimes->{4.002868760931381*^9},
 CellLabel->
  "In[201]:=",ExpressionUUID->"4be42144-e6f4-4497-b2df-a1f1f72ab009"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"0", ",", "0"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{{4.002868753490683*^9, 4.00286876218541*^9}, 
   4.002868878524619*^9, {4.0029905596091013`*^9, 4.0029905712529078`*^9}},
 CellLabel->
  "Out[201]=",ExpressionUUID->"a12d8b25-ceb9-4d25-b04f-df430bd346ab"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"intensity", "[", "crossedOutput", "]"}]], "Input",
 CellChangeTimes->{{4.00286874739227*^9, 4.002868766261587*^9}},
 CellLabel->
  "In[202]:=",ExpressionUUID->"334eb83a-5c08-438e-8694-1e69e7800bcd"],

Cell[BoxData[
 FormBox["0", TraditionalForm]], "Output",
 CellChangeTimes->{
  3.9999102050032787`*^9, 4.002867981039023*^9, 4.0028680555263968`*^9, 
   4.0028681097583857`*^9, 4.002868271908414*^9, {4.002868747760499*^9, 
   4.002868766655308*^9}, 4.002868878526507*^9, {4.002990559610839*^9, 
   4.0029905712546787`*^9}},
 CellLabel->
  "Out[202]=",ExpressionUUID->"2e837e0a-846b-4221-be30-31e5fc61b719"]
}, Open  ]],

Cell["\<\
The horizontal polarizer leaves the input unchanged, and the vertical \
polarizer then removes it completely.\
\>", "Text",ExpressionUUID->"6b68bfe1-9041-4515-9272-e548e1444f1e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["4. Insert a polarizer between them", \
"Subsubsection"]], "Section",ExpressionUUID->"5acbc978-8dbd-40a1-8a75-\
f990508819bc"],

Cell["\<\
Now replace the two-filter apparatus by a three-filter apparatus. The middle \
axis is at angle \[Theta].\
\>", "Text",ExpressionUUID->"105a67b6-4dbd-48df-8c57-92dcb1121f73"],

Cell["horizontal beam  \[RightArrow]  P(\[Theta])  \[RightArrow]  P(\[Pi]/2)  \
\[RightArrow]  detector", "Text",
 CellChangeTimes->{
  4.002868790155569*^9},ExpressionUUID->"91b429af-2608-4d78-8d37-\
325b2c0c5b66"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"threeFilterOutput", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"polarizer", "[", 
      FractionBox["\[Pi]", "2"], "]"}], ".", 
     RowBox[{"polarizer", "[", "\[Theta]", "]"}], ".", "horizontal"}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{"\[Theta]", "\[Element]", 
      TemplateBox[{},
       "Reals"]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.00286825947792*^9, 4.002868260374371*^9}, 
   4.002868779902519*^9},
 CellLabel->
  "In[203]:=",ExpressionUUID->"78d62847-9e9b-459e-8dfe-04d963661458"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"0", ",", 
    RowBox[{
     RowBox[{"sin", "(", "\[Theta]", ")"}], " ", 
     RowBox[{"cos", "(", "\[Theta]", ")"}]}]}], "}"}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{
  3.999910205005104*^9, 4.0028679810409927`*^9, 4.002868055528143*^9, 
   4.002868109760355*^9, 4.002868271910046*^9, {4.002868777163459*^9, 
   4.0028687805682364`*^9}, 4.0028688785381002`*^9, {4.002990559625189*^9, 
   4.002990571259223*^9}},
 CellLabel->
  "Out[203]=",ExpressionUUID->"fef28a5a-9477-4a23-9629-cc717accf58e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"threeFilterIntensity", " ", "=", " ", 
  RowBox[{"intensity", "[", "threeFilterOutput", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"%", ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"\[Theta]", "\[Element]", 
     TemplateBox[{},
      "Reals"]}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.002868823005947*^9, 4.002868823190093*^9}, {
  4.0028688740703907`*^9, 4.002868875026404*^9}},
 CellLabel->
  "In[204]:=",ExpressionUUID->"ec6cf301-cbe8-4650-aa0d-07852868ae0e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"sin", "(", "\[Theta]", ")"}], " ", 
   RowBox[{"cos", "(", "\[Theta]", ")"}], " ", 
   TemplateBox[{
     RowBox[{"(", 
       RowBox[{
         RowBox[{"cos", "(", "\[Theta]", ")"}], " ", 
         RowBox[{"sin", "(", "\[Theta]", ")"}]}], ")"}]},
    "Conjugate"]}], TraditionalForm]], "Output",
 CellChangeTimes->{{4.002868803222124*^9, 4.002868823356825*^9}, {
  4.002868875440754*^9, 4.0028688785406446`*^9}, {4.002990559627605*^9, 
  4.002990571261203*^9}},
 CellLabel->
  "Out[204]=",ExpressionUUID->"c3dda3a1-7e88-4c44-b9c4-0c31494f48cb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["sin", "2"], "(", "\[Theta]", ")"}], " ", 
   RowBox[{
    SuperscriptBox["cos", "2"], "(", "\[Theta]", ")"}]}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{{4.002868803222124*^9, 4.002868823356825*^9}, {
  4.002868875440754*^9, 4.0028688785406446`*^9}, {4.002990559627605*^9, 
  4.002990571261765*^9}},
 CellLabel->
  "Out[205]=",ExpressionUUID->"cb3df598-80d2-426a-a6c1-e275420f3ec4"]
}, Open  ]],

Cell[TextData[{
 "The final amplitude is vertical with size sin(\[Theta]) cos(\[Theta]). Its \
intensity is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["Sin", "2"], "[", "\[Theta]", "]", 
   SuperscriptBox["Cos", "2"], "[", "\[Theta]", "]"}]], "InlineFormula",
  ExpressionUUID->"2a5c66eb-15d6-4ab6-b0bb-5fd60944b401"],
 " = ",
 Cell[BoxData[
  FractionBox[
   SuperscriptBox[
    RowBox[{"Sin", "[", 
     RowBox[{"2", " ", "\[Theta]"}], "]"}], "2"], "4"]], "InlineFormula",
  ExpressionUUID->"9d03f790-ba4b-4c48-9269-c34a83abe471"],
 ". It vanishes at 0\[Degree] and 90\[Degree] and reaches ",
 Cell[BoxData[
  FractionBox["1", "4"]], "InlineFormula",ExpressionUUID->
  "2535f42a-b502-4d55-93dd-ff7a3b5ce8c1"],
 " at 45\[Degree]. No new light is created: changing the apparatus replaces \
one product of projection matrices by a different product."
}], "Text",ExpressionUUID->"3319bcaa-1a7f-4552-a010-ee42bb392844"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"specialAngles", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"threeFilterIntensity", "/.", "\[VeryThinSpace]", 
       RowBox[{"\[Theta]", "\[Rule]", "0"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["\[Pi]", "4"], ",", 
      RowBox[{"threeFilterIntensity", "/.", "\[VeryThinSpace]", 
       RowBox[{"\[Theta]", "\[Rule]", 
        FractionBox["\[Pi]", "4"]}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["\[Pi]", "2"], ",", 
      RowBox[{"threeFilterIntensity", "/.", "\[VeryThinSpace]", 
       RowBox[{"\[Theta]", "\[Rule]", 
        FractionBox["\[Pi]", "2"]}]}]}], "}"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{4.002868263023329*^9, 4.002868263873322*^9}},
 CellLabel->
  "In[206]:=",ExpressionUUID->"237434db-2ea3-462d-93f6-c425e8559429"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", "0"},
     {
      FractionBox["\[Pi]", "4"], 
      FractionBox["1", "4"]},
     {
      FractionBox["\[Pi]", "2"], "0"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{
  3.999910205024845*^9, 4.002867981061257*^9, 4.00286805554681*^9, 
   4.0028681097785597`*^9, 4.002868271928816*^9, 4.002868878543212*^9, {
   4.002990559639439*^9, 4.002990571267036*^9}},
 CellLabel->
  "Out[206]=",ExpressionUUID->"c0453ada-3ec8-460a-8bdc-931588ae8718"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["5. See the full angular dependence", \
"Subsubsection"]], "Section",ExpressionUUID->"ce0504a4-1bc8-4a93-8b6c-\
2d65181e35d7"],

Cell["\<\
The calculation uses radians. The tick labels below display the three \
familiar angles in degrees.\
\>", "Text",ExpressionUUID->"f0f360dc-314f-49ee-aca4-92dfb2f9094f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"transmissionPlot", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", "threeFilterIntensity", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", "0", ",", 
      FractionBox["\[Pi]", "2"]}], "}"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox["1", "4"]}], "}"}]}], ",", 
    RowBox[{"Filling", "\[Rule]", "Axis"}], ",", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<middle angle\>\"", ",", "\"\<transmitted intensity\>\""}], 
      "}"}]}], ",", 
    RowBox[{"Ticks", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "\"\<0\[Degree]\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           FractionBox["\[Pi]", "4"], ",", "\"\<45\[Degree]\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           FractionBox["\[Pi]", "2"], ",", "\"\<90\[Degree]\>\""}], "}"}]}], 
        "}"}], ",", "Automatic"}], "}"}]}], ",", 
    RowBox[{"PlotLabel", "\[Rule]", "\"\<Three ideal polarizers\>\""}], ",", 
    RowBox[{"ImageSize", "\[Rule]", "Large"}]}], "]"}]}]], "Input",
 CellChangeTimes->{4.002868264389799*^9},
 CellLabel->
  "In[207]:=",ExpressionUUID->"862fdafe-5f89-42d8-965d-06163c8c92bc"],

