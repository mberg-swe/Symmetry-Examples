Cell[CellGroupData[{

Cell[TextData[StyleBox["6. Order matters", "Subsubsection"]], "Section",ExpressionUUID->"ba81d983-b016-40f6-a271-3f41f3f83029"],

Cell[TextData[{
 "Projection matrices at different angles generally ",
 StyleBox["do not commute",
  FontWeight->"Bold"],
 ". Compare ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["P", 
    RowBox[{"45", "\[Degree]"}]], 
   SubscriptBox["P", 
    RowBox[{"0", "\[Degree]"}]], 
   SubscriptBox["e", "H"]}]], "InlineFormula",ExpressionUUID->
  "489e7c45-2920-40dc-aa7a-592e2f00d45e"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["P", 
    RowBox[{"0", "\[Degree]"}]], 
   SubscriptBox["P", 
    RowBox[{"45", "\[Degree]"}]], 
   SubscriptBox["e", "H"]}]], "InlineFormula",ExpressionUUID->
  "74821a10-c183-440a-ba7f-49b8e6970056"],
 ". The rightmost matrix acts first."
}], "Text",ExpressionUUID->"4db22380-9ed9-4d68-b7f1-5949dc9e9011"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"p0", "=", 
   RowBox[{"polarizer", "[", "0", "]"}]}], ";", 
  RowBox[{"p45", "=", 
   RowBox[{"polarizer", "[", 
    FractionBox["\[Pi]", "4"], "]"}]}], ";", 
  RowBox[{"orderedOutputs", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"p45", ".", "p0", ".", "horizontal"}], ",", 
     RowBox[{"p0", ".", "p45", ".", "horizontal"}]}], "}"}]}], ";", 
  RowBox[{"orderedIntensities", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"intensity", "/@", "orderedOutputs"}], "]"}]}], ";", 
  RowBox[{"{", 
   RowBox[{"orderedOutputs", ",", "orderedIntensities"}], "}"}]}]], "Input",
 CellLabel->
  "In[208]:=",ExpressionUUID->"9d5359e6-6d87-498b-b48a-093e16a8cc65"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"{", 
       RowBox[{
        FractionBox["1", "2"], ",", 
        FractionBox["1", "2"]}], "}"}], 
      RowBox[{"{", 
       RowBox[{
        FractionBox["1", "2"], ",", "0"}], "}"}]},
     {
      FractionBox["1", "2"], 
      FractionBox["1", "4"]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{
  3.999910205206946*^9, 4.002867981248069*^9, 4.002868055572987*^9, 
   4.0028681097973413`*^9, 4.0028682719534683`*^9, 4.002868878569792*^9, {
   4.0029905596754637`*^9, 4.0029905712909737`*^9}},
 CellLabel->
  "Out[208]=",ExpressionUUID->"1785e5ff-fff4-4659-b696-c1df254a45ba"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"p0", ".", "p45"}], "\[Equal]", 
    RowBox[{"p45", ".", "p0"}]}], ",", 
   TagBox[
    RowBox[{
     RowBox[{"p0", ".", "p45"}], "-", 
     RowBox[{"p45", ".", "p0"}]}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]]}], "}"}]], "Input",
 CellLabel->
  "In[209]:=",ExpressionUUID->"65e5cef4-abd0-4ff6-9f2d-f877aedf95b6"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"False", ",", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", 
        FractionBox["1", "2"]},
       {
        RowBox[{"-", 
         FractionBox["1", "2"]}], "0"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}]}], "}"}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{
  3.999910205211329*^9, 4.0028679812560463`*^9, 4.0028680555791683`*^9, 
   4.002868109807885*^9, 4.002868271960123*^9, 4.002868878577186*^9, {
   4.002990559681571*^9, 4.002990571297243*^9}},
 CellLabel->
  "Out[209]=",ExpressionUUID->"470961a0-d0f0-43c6-9770-026c6a6f53bd"]
}, Open  ]],

Cell["\<\
For the same horizontal input, the two orders give intensities 1/2 and 1/4. \
In the first order the final polarization is at 45\[Degree]. In the second, \
it is horizontal after a second projection. There is physical attenuation, \
i.e. here the ordering is not a harmless \[OpenCurlyDoubleQuote]change of \
coordinates\[CloseCurlyDoubleQuote] or something like that.\
\>", "Text",
 CellChangeTimes->{{4.002868920236155*^9, 
  4.0028689576053047`*^9}},ExpressionUUID->"395a04cf-a4f9-4985-a3ac-\
47a646adf810"],

Cell["\<\
Do not normalize the Jones vector after each filter: doing so would erase the \
probability or power lost at that filter and would give the wrong final \
intensity. If a photon is known to have passed a particular filter, its \
conditional transmitted polarization may be normalized separately, but that \
is a different question from the total transmission through the apparatus.\
\>", "Text",ExpressionUUID->"3c179313-84d8-48f8-8dd9-04179abf0eaf"]
}, Open  ]]
}, Open  ]]
},
WindowSize->{1430, 848},
WindowMargins->{{Automatic, 11}, {Automatic, 0}},
WindowTitle->"Three polarizers",
