Cell[TextData[{
 "The \[OpenCurlyDoubleQuote]2\[CloseCurlyDoubleQuote] comes from the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"H", ",", 
     SubscriptBox["E", "ij"]}]}], TraditionalForm]],ExpressionUUID->
  "fe8b9f1a-1ddc-4a77-8be5-e721b500faad"],
 "] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["\[Lambda]", "i"]}], TraditionalForm]],ExpressionUUID->
  "89d4df9f-9f1b-4f96-9a88-8cb01f203019"],
 " ",
 StyleBox["\[Dash]",
  FontSize->14],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "j"], TraditionalForm]],ExpressionUUID->
  "662c0a02-16c0-451a-86ac-d43ef8c3cc0f"],
 ")",
 StyleBox[" ",
  FontSize->14],
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "ij"], TraditionalForm]],ExpressionUUID->
  "1e82d10a-97f4-40f4-84b3-546b213a6ce3"],
 " above, since 1\[Dash](\[Dash]1) = 2.\nHere [",
 StyleBox["H,E",
  FontSlant->"Italic"],
 "] = 2",
 StyleBox["E",
  FontSlant->"Italic"],
 ", and [",
 StyleBox["H,F",
  FontSlant->"Italic"],
 "] = \[Dash]2",
 StyleBox["F",
  FontSlant->"Italic"],
 ", so sl(2) has two roots: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "1"], TraditionalForm]],ExpressionUUID->
  "b19b3774-3924-4541-843e-8c6f1bb7678d"],
 " = 2 and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "2"], " "}], TraditionalForm]],ExpressionUUID->
  "9c767340-2b7b-4fd4-8c1a-5a0d2d5c91a3"],
 "= \[Dash]2, and only one of them is positive. \n\nNow the Killing form ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Kappa]", "ab"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f68a9695-31d1-4b50-bbfa-ecf499d90cc9"],
 " = Tr(ad o ad). We need something to act on, so we write ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["ad", 
     SuperscriptBox["T", "a"]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ac020846-43ac-4e2c-a1ca-bf408482b72e"],
 " o ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ad", 
    SuperscriptBox["T", "b"]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "52e9661c-d0fd-433a-9909-0ceab205b968"],
 ")( ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "c"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b8ba98be-6f77-43e3-97d7-2055ee4262d1"],
 " ) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     SuperscriptBox["T", "a"], ",", 
     RowBox[{"[", 
      RowBox[{
       SuperscriptBox["T", "b"], ",", 
       SuperscriptBox["T", "c"]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ccc67fc2-6bf1-4ce0-99e7-484ebd5c672a"],
 "]] =  "
}], "Text",
 CellChangeTimes->{{3.914300365008733*^9, 3.914300377581016*^9}, {
   3.9143004358541193`*^9, 3.914300491296043*^9}, 3.9143005619992323`*^9, {
   3.914403996606677*^9, 3.914404065503477*^9}, 3.9144042091470346`*^9, {
   3.914404360092084*^9, 3.914404360255949*^9}, 3.914404590582362*^9, {
   3.914404663906062*^9, 3.91440470052328*^9}, 3.975125703818284*^9, {
   3.9751258263121433`*^9, 3.975125834907209*^9}, {3.975125893380764*^9, 
   3.975125949111229*^9}, {3.9751262910487823`*^9, 3.975126305819889*^9}, {
   3.9751332169483147`*^9, 3.97513325678878*^9}, {3.9751335585855722`*^9, 
   3.975133571976169*^9}, {3.975134293902829*^9, 3.9751342954631643`*^9}, {
   3.975147565677987*^9, 
   3.97514770887575*^9}},ExpressionUUID->"0684c59b-2206-4812-8d20-\
a3f2651cf84e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KillingForm", " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Tr", "[", 
     RowBox[{
      RowBox[{"genSL2", "[", 
       RowBox[{"[", "i", "]"}], "]"}], ".", 
      RowBox[{"genSL2", "[", 
       RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.975145843627576*^9, 3.975145885555613*^9}},
 CellLabel->
  "In[507]:=",ExpressionUUID->"e5d6db05-abc6-4bc1-a2b5-8a1adbe607d6"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", "1", "0"},
     {"1", "0", "0"},
     {"0", "0", "2"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.975145888519371*^9},
 CellLabel->
  "Out[507]=",ExpressionUUID->"f6867c17-b1ef-4206-a969-a066f80584d1"]
}, Open  ]],

Cell[TextData[{
 "As reviewed for example by Garrett (reference above), we can view ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Kappa]", "ab"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e1d78844-1d73-459c-bfe1-cafbd92a2ea6"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"tr", "(", 
    SubscriptBox["\[Rho]", "ad"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0501c3a9-0c40-4f9a-8f83-9fb235c39e0b"],
 "( ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "a"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b0683440-3628-4aaf-81f3-823fe8e3d658"],
 " )",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", "ad"], TraditionalForm]],ExpressionUUID->
  "f44c62ff-af8b-447c-9690-22e887c35a06"],
 "( ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "b"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b79e9c2c-d473-41af-b819-e0787be18b35"],
 ")) as providing a duality pairing, from which we can construct a dual basis \
 ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{"(", 
     SuperscriptBox["T", "a"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3b546a11-1a7c-40e7-a78e-9477032908cd"],
 ")*, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "a"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ee5c7173-96d4-413a-b648-aa62083f948b"],
 "\[RightAngleBracket]. :\[LineSeparator](We could use index up ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "a"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "86d1710c-75d2-40e5-9d48-ed8198534702"],
 " vs. down ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "a"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bb80d51e-549c-4015-80d9-d7942f5bb4db"],
 ", but this is not always done in this context. We could also have used \
other representations that the adjoint to get a pairing; that would only \
changes the overall normalization.)"
}], "Text",
 CellChangeTimes->{{3.915514277709317*^9, 3.9155142826425867`*^9}, {
  3.915514584467388*^9, 3.9155145873291817`*^9}, {3.975125951494006*^9, 
  3.975126009560053*^9}, {3.975133218571463*^9, 3.975133233069579*^9}, {
  3.975145931844441*^9, 3.97514609220816*^9}, {3.975147306692581*^9, 
  3.975147320575886*^9}, {3.9751474268458853`*^9, 
  3.975147438974311*^9}},ExpressionUUID->"e6179bc5-f8e7-4ef3-b35b-\
9a2ea24cbb78"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ruleDual", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"td", "[", "i", "]"}], " ", "->", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Inverse", "[", "KillingForm", "]"}], "[", 
          RowBox[{"[", "j", "]"}], "]"}], 
         RowBox[{"t", "[", "j", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}], "[", 
      RowBox[{"[", "i", "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9155140526739063`*^9, 3.915514057960692*^9}, {
  3.915514093806739*^9, 3.915514104804351*^9}, {3.915514136631362*^9, 
  3.915514168340541*^9}, {3.915514229356309*^9, 3.91551422953098*^9}, {
  3.915514264050057*^9, 3.91551428908416*^9}, {3.915514336015012*^9, 
  3.915514430701315*^9}, {3.915514467365861*^9, 3.915514495586319*^9}, {
  3.9155145317136297`*^9, 3.915514576806571*^9}, {3.915514681363721*^9, 
  3.915514691419626*^9}},
 CellLabel->
  "In[508]:=",ExpressionUUID->"0399082f-1b4d-4214-9c31-87fda149c864"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      SuperscriptBox["t", "d"], "1"], "\[Rule]", 
     SubscriptBox["t", "2"]}], ",", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["t", "d"], "2"], "\[Rule]", 
     SubscriptBox["t", "1"]}], ",", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["t", "d"], "3"], "\[Rule]", 
     FractionBox[
      SubscriptBox["t", "3"], "2"]}]}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{
  3.915514058278475*^9, {3.915514096923819*^9, 3.915514105386931*^9}, {
   3.915514148023197*^9, 3.915514173998871*^9}, 3.915514230179743*^9, 
   3.9155142894574413`*^9, 3.915514336378249*^9, {3.915514382536407*^9, 
   3.915514431218926*^9}, 3.915514468049849*^9, {3.915514517299933*^9, 
   3.915514577331815*^9}, {3.915514685818815*^9, 3.915514691814911*^9}, 
   3.915514765308042*^9, 3.9751260634049177`*^9, 3.975126282736145*^9, 
   3.975126363759774*^9, 3.975126398175879*^9, 3.975126659864955*^9, 
   3.975133293123897*^9, 3.975145888521564*^9},
 CellLabel->
  "Out[508]=",ExpressionUUID->"84ab9482-5d3f-4a53-87e2-19a8644f5028"]
}, Open  ]],

Cell[TextData[{
 "so the duals are ",
 StyleBox["H",
  FontSlant->"Italic"],
 "* = ",
 StyleBox["H/2, ",
  FontSlant->"Italic"],
 " ",
 StyleBox["E",
  FontSlant->"Italic"],
 "* = ",
 StyleBox["F, F* = E.",
  FontSlant->"Italic"],
 " Because of the switching of ",
 StyleBox["E",
  FontSlant->"Italic"],
 " and ",
 StyleBox["F",
  FontSlant->"Italic"],
 " in the dual, here ",
 StyleBox["E",
  FontSlant->"Italic"],
 " goes with ",
 StyleBox["F",
  FontSlant->"Italic"],
 ", not just itself as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", "2"], TraditionalForm]],ExpressionUUID->
  "38c3422f-9ce9-4250-8baa-33190ac14ff9"],
 ". (Obvious here, since ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", "2"], TraditionalForm]],ExpressionUUID->
  "27b87fb5-a570-42c3-86f5-9f4bda87bed1"],
 " is zero! But in e.g. sl(3), not necessarily.)\nThe Casimir operator ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "87c13fa3-f44a-4fe7-bf30-38700f8332b7"],
 " (\[OpenCurlyDoubleQuote]2\[CloseCurlyDoubleQuote] for quadratic in the \
generators) is:"
}], "Text",
 CellChangeTimes->{{3.914316349792617*^9, 3.914316354030561*^9}, 
   3.975061532991024*^9, {3.9751260173013678`*^9, 3.975126074032443*^9}, {
   3.975145913934883*^9, 
   3.975145922722268*^9}},ExpressionUUID->"15f08748-2732-4471-8260-\
ae8955a3aead"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"C2sl2", " ", "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{
       RowBox[{"t", "[", "i", "]"}], ".", 
       RowBox[{"td", "[", "i", "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{"%", "/.", " ", "ruleDual"}], "\[IndentingNewLine]", 
 RowBox[{"%", " ", "/.", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"t", "[", "i", "]"}], "->", 
     RowBox[{"genSL2", "[", 
      RowBox[{"[", "i", "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.914301168905197*^9, 3.9143012109306803`*^9}, {
  3.914301267408371*^9, 3.9143012814655247`*^9}, {3.914316425227648*^9, 
  3.914316433798998*^9}, {3.9155146786258307`*^9, 3.915514722952235*^9}, {
  3.915514786358944*^9, 3.915514839465095*^9}, {3.975126058006001*^9, 
  3.97512605812674*^9}, {3.975133379932705*^9, 3.975133432395733*^9}},
 CellLabel->
  "In[509]:=",ExpressionUUID->"1c9b8511-e808-4c38-a006-ddc9c1bee050"],

