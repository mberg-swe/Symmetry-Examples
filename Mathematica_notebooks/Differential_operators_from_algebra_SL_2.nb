Notebook[{
Cell[TextData[{
 StyleBox["Differential operators ", "Subsubsection"],
 StyleBox["R", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" from Lie algebra generators ", "Subsubsection"],
 StyleBox["T", "Subsubsection",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.9107528706782093`*^9, 3.910752919732606*^9}, {
  3.91380153254908*^9, 3.913801541313901*^9}, {3.975144159755156*^9, 
  3.975144184139317*^9}},ExpressionUUID->"92cf8806-9537-4ab5-8a84-\
2cb24ef943e8"],

Cell[TextData[{
 "Here I use this definition of a right-invariant differential operator of a \
Lie algebra:\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "a"], TraditionalForm]],ExpressionUUID->
  "f54e74ce-a2e2-45e3-98f3-dc78478f91a0"],
 " ",
 StyleBox["g",
  FontSlant->"Italic"],
 " = ",
 StyleBox["g ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "a"], TraditionalForm]],ExpressionUUID->
  "1eec9315-7521-4482-a306-101c6a4cd3c3"],
 StyleBox[" ",
  FontSlant->"Italic"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "a"], TraditionalForm]],ExpressionUUID->
  "2f8ba789-55ff-4229-8afe-28af678c65d5"],
 " is expanded as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "a"], TraditionalForm]],ExpressionUUID->
  "2d59cb8f-16fb-4a16-9e46-51606f037c66"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sum]", "a"], TraditionalForm]],ExpressionUUID->
  "94bfea18-0225-4b60-a04c-1d0036c39c18"],
 " ",
 StyleBox["f",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["", 
    StyleBox["ab",
     FontSlant->"Italic"]], TraditionalForm]],ExpressionUUID->
  "c8f980fc-d021-4fde-8b4c-a5a448505b52"],
 " ",
 Cell[BoxData[
  SubscriptBox["\[PartialD]", 
   StyleBox["b",
    FontSlant->"Italic"]]],ExpressionUUID->
  "29c86dab-05d3-4f59-9201-09904c702cb5"],
 ". \n",
 StyleBox["[Notation will be changed to the above, but below I use ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", 
    RowBox[{"i", " "}]], TraditionalForm]],
  FormatType->TraditionalForm,
  FontWeight->"Bold",ExpressionUUID->"96bce5f4-7f9f-4472-9ccb-f528dcd12fc8"],
 StyleBox[" for ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "a"], TraditionalForm]],
  FormatType->TraditionalForm,
  FontWeight->"Bold",ExpressionUUID->"654cbbab-ab1e-4df3-a1bb-ddbf75a78367"],
 StyleBox[".]",
  FontWeight->"Bold"],
 "\nUseful mathematics reference:\n\[Bullet]\[NonBreakingSpace] Garrett, \
\[OpenCurlyDoubleQuote]",
 StyleBox["Invariant differential operators",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote], \
https://www-users.cse.umn.edu/~garrett/m/mfms/notes/12_diffops.pdf\n\n",
 StyleBox["Basics",
  FontWeight->"Bold"],
 "\[LineSeparator]",
 StyleBox["Jacobson-Morozon triple",
  FontSlant->"Italic"],
 ": SL(2)   E,F, [E,F]   (https://en.wikipedia.org/wiki/Sl2-triple)\n\
(Sometimes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "\[Dash]"], TraditionalForm]],ExpressionUUID->
  "f3d615fe-dc72-4fe8-a8ff-411fba371a9d"],
 " is used for F. When it is, ",
 StyleBox["E ",
  FontSlant->"Italic"],
 "is called ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "+"], TraditionalForm]],ExpressionUUID->
  "1ff76750-ac74-4a96-85c0-fadbaf6da6b1"],
 "). Here, I use ",
 StyleBox["F",
  FontSlant->"Italic"],
 ". \n",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    SubscriptBox["E", "1"]}], TraditionalForm]],ExpressionUUID->
  "422799c1-4be8-494f-a43d-512a9b2e3b96"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "2"], TraditionalForm]],ExpressionUUID->
  "4a023a66-af6d-4e36-a03c-5dda962c67a8"],
 "] = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "3"], TraditionalForm]],ExpressionUUID->
  "7400117c-f489-422e-9ea7-b1f60eb222ff"],
 "  (highest, here drop \[OpenCurlyDoubleQuote]3\[CloseCurlyDoubleQuote], \
this is an SL(2) subalgebra)\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    SubscriptBox["F", "1"]}], TraditionalForm]],ExpressionUUID->
  "014d1c4b-a903-4087-9ab7-26158535edae"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "2"], TraditionalForm]],ExpressionUUID->
  "9803af79-b341-48b1-808b-6dd03fb15561"],
 "] = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "3"], TraditionalForm]],ExpressionUUID->
  "d4088de3-c99c-49eb-acd4-1a14c8a84ca7"],
 "  (highest)\nwhile ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    SubscriptBox["E", "1"]}], TraditionalForm]],ExpressionUUID->
  "6c712f44-c75e-4c67-9518-a8ad1df0c80b"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "1"], TraditionalForm]],ExpressionUUID->
  "98821c8f-97e8-40e8-8711-4619168983b8"],
 "] = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "1"], TraditionalForm]],ExpressionUUID->
  "f99f5cb1-facc-4406-be4d-6052314feeb5"],
 "  (possibly minus, see below). \nThe adjoint action of H on E is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"H", ",", 
     SubscriptBox["E", "ij"]}]}], TraditionalForm]],ExpressionUUID->
  "6d776852-1f33-42d4-abbf-0bfa08f2a861"],
 "] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["\[Lambda]", "i"]}], TraditionalForm]],ExpressionUUID->
  "61136dc0-5532-4218-b6f4-07c3b489ff34"],
 " ",
 StyleBox["\[Dash]",
  FontSize->14],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "i"], TraditionalForm]],ExpressionUUID->
  "8a58af78-3dfd-4062-9d8a-dc53e40c1185"],
 ")",
 StyleBox[" ",
  FontSize->14],
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "ij"], TraditionalForm]],ExpressionUUID->
  "ba25a89a-87e4-442b-98a6-e8c09be03edb"],
 StyleBox[", where ",
  FontSize->14],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "i"], TraditionalForm]],ExpressionUUID->
  "3ce4259c-13d7-43dd-b272-292ee7ecef59"],
 " are diagonal entries of ",
 StyleBox["H\n",
  FontSlant->"Italic"],
 "(see https://en.wikipedia.org/wiki/Root_system )\n\n",
 StyleBox["The Lie algebra sl(2)",
  FontWeight->"Bold"],
 "\nFor sl(2), we take as in e.g. Fuchs & Schweigert Ch.3 (where they are \
introduced as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "0"], TraditionalForm]],ExpressionUUID->
  "5a59bd60-2863-4a91-bfb1-e1c24c1f45d3"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "\[PlusMinus]"], TraditionalForm]],ExpressionUUID->
  "4116dcdb-b717-41f2-b63c-160b18605778"],
 ", anticipating their role in the Virasoro algebra).\nUse ",
 StyleBox["Eg",
  FontSlant->"Italic"],
 " (g for \[OpenCurlyDoubleQuote]generator\[CloseCurlyDoubleQuote]) since ",
 StyleBox["E",
  FontSlant->"Italic"],
 " is protected in Mathematica. "
}], "Text",
