Cell[TextData[{
 "As e.g. Garrett points out on p.12, if ",
 StyleBox["K ",
  FontSlant->"Italic"],
 "= SO(2) is specifically the isotropy group of the point",
 StyleBox[" ",
  FontSlant->"Italic"],
 "\[ImaginaryI], then"
}], "Text",
