Cell[TextData[{
 "It is conventional to call the variable in the",
 StyleBox[" H",
  FontSlant->"Italic"],
 " direction \[Nu] = Exp[2 x[3]], for the following reason."
}], "Text",
 CellChangeTimes->{{3.914302725418347*^9, 3.914302735653154*^9}, {
  3.9143114699002237`*^9, 3.9143114887233143`*^9}, {3.914317903329608*^9, 
