   3.97512626284731*^9},
 CellLabel->
  "In[506]:=",ExpressionUUID->"7cd0dde0-a4f6-40a2-910b-f1d873679e16"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"True", ",", "True", ",", "True"}], "}"}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{{3.910752696952012*^9, 3.9107527470618887`*^9}, 
   3.910752862778798*^9, 3.911273123531636*^9, 3.9136916636623983`*^9, {
   3.913802172209815*^9, 3.9138021820061197`*^9}, 3.9138022153722897`*^9, 
   3.91380231507075*^9, {3.9138026015145607`*^9, 3.913802615265627*^9}, 
   3.914292325308407*^9, 3.914292476045862*^9, 3.914292646401444*^9, 
