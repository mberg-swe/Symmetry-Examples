Cell[BoxData[
 RowBox[{"gE", " ", "=", " ", 
  RowBox[{
   RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", " ", 
   RowBox[{
    RowBox[{"x", "[", "1", "]"}], " ", "Eg", " "}]}]}]], "Input",
