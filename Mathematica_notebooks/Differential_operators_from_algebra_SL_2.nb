}, Open  ]],

Cell[TextData[{
 "so the exponentiation truncates: ",
 StyleBox["g",
  FontSlant->"Italic"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"\[Theta]", " ", "E"}]], TraditionalForm]],ExpressionUUID->
  "3c9af47e-136e-46b0-a52e-cfb8905923b5"],
 " = 1 + \[Theta] E. "
}], "Text",
 CellChangeTimes->{{3.913802836313074*^9, 3.913802872082967*^9}, {
  3.9138029224975557`*^9, 3.9138029235673447`*^9}, {3.913803075203566*^9, 
