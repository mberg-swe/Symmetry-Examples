      SubscriptBox["x", "1"], ",", 
      SubscriptBox["x", "3"]}], ")"}]}]}], TraditionalForm]], "Output",
 CellChangeTimes->{{3.914393666249302*^9, 3.9143937663339453`*^9}, 
