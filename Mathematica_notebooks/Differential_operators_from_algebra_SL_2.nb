Cell[TextData[{
 "So with the ordering {E,F,H} above,\nthe solution we get is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "1"], TraditionalForm]],ExpressionUUID->
  "673dc276-1f1d-4eb5-a4f7-9724b7cd041d"],
 " ",
 StyleBox["g",
  FontSlant->"Italic"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "4f50b5cf-3ee1-4cb8-8a34-f61011558322"],
 " D[",
 StyleBox["g",
  FontSlant->"Italic"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "56722bf2-dfb1-4217-9322-6914d010a71a"],
 "],   ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "3"], TraditionalForm]],ExpressionUUID->
  "a2e3011b-e6fd-4c50-8c8c-d0e70e309abf"],
 " ",
 StyleBox["g",
  FontSlant->"Italic"],
 " = D[",
 StyleBox["g",
  FontSlant->"Italic"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "89ba8e2a-afbe-4fdb-9ba2-f27e3d4991e1"],
 "].\n\nNote that I don\[CloseCurlyQuote]t get",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox["R", "2"]}], TraditionalForm]],ExpressionUUID->
  "d2dfd54a-51cc-44fa-88bf-0deaf9a24d8c"],
 " from this calculation, since I didn\[CloseCurlyQuote]t exponentiate ",
 StyleBox["F",
  FontSlant->"Italic"],
 " at all. Instead, I used the SO(2) identification in the quotient \
SL(2)/SO(2). There is an ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox["R", "2"]}], TraditionalForm]],ExpressionUUID->
  "3188fbf7-d2dd-4f87-8b74-9e5ffdd2fab0"],
 " and it does act on a more general ",
 StyleBox["g",
  FontSlant->"Italic"],
 ", in fact in the same way as ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox["R", "1"]}], TraditionalForm]],ExpressionUUID->
  "6d6cd08e-85de-42e4-9424-f0937f04eec5"],
 ". But it looks more complicated (e.g. Pioline-Persson eq.(2.4) for SL(3)). \
"
}], "Text",
 CellChangeTimes->{{3.91430151360128*^9, 3.914301565393664*^9}, {
   3.914301805162693*^9, 3.9143018077443542`*^9}, {3.914379430371353*^9, 
   3.9143796131399097`*^9}, {3.9143796992937937`*^9, 3.914379808158942*^9}, {
   3.9143878096840887`*^9, 3.9143878500924673`*^9}, 3.914389703946018*^9, {
   3.914389773307329*^9, 3.9143898111815157`*^9}, 3.9143924541234922`*^9, {
   3.9751264408874826`*^9, 
   3.9751264476328297`*^9}},ExpressionUUID->"60a26e92-a3fb-484c-af1d-\
949015a48246"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RExpl", "[", 
   RowBox[{"g_", ",", "i_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"i", ",", "j"}], "]"}], 
      RowBox[{"D", "[", 
       RowBox[{"g", ",", 
        RowBox[{"x", "[", "j", "]"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}], " ", "/.", " ", 
   "fSol"}]}]], "Input",
 CellChangeTimes->{{3.914301623573394*^9, 3.914301633885922*^9}},
 CellLabel->
  "In[530]:=",ExpressionUUID->"993ba63f-aa8f-4744-9a3e-f8d14521aca3"],

Cell[TextData[{
 "Check the representation of the commutation relation [H,E] =2E.\
\[LineSeparator]Indeed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     SubscriptBox["R", "3"], ",", " ", 
     SubscriptBox["R", "1"]}]}], TraditionalForm]],ExpressionUUID->
  "7b53dd1b-9fda-4d36-8e31-f2dd7b0e61fb"],
 "] ",
 StyleBox["g",
  FontSlant->"Italic"],
 " = 2 ",
