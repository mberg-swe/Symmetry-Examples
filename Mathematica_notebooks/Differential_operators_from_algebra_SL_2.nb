Cell[TextData[{
 "The naming of E being \[OpenCurlyDoubleQuote]upper\[CloseCurlyDoubleQuote] \
and F being \[OpenCurlyDoubleQuote]lower\[CloseCurlyDoubleQuote] generalizes \
to e.g. sl(3), where there are 3 \[OpenCurlyDoubleQuote]upper\
\[CloseCurlyDoubleQuote] E and 3 \[OpenCurlyDoubleQuote]lower\
\[CloseCurlyDoubleQuote] F matrices",
 StyleBox[".",
  FontWeight->"Bold"],
 "\nCheck that",
 StyleBox[" H,E,F",
  FontSlant->"Italic"],
 " satisfy the sl(2) Lie algebra:\[LineSeparator][",
 StyleBox["H,E",
  FontSlant->"Italic"],
 "] = 2",
 StyleBox["E",
  FontSlant->"Italic"],
 ", [",
 StyleBox["H,F",
  FontSlant->"Italic"],
 "] = \[Dash]2",
 StyleBox["F",
  FontSlant->"Italic"],
 ", [",
 StyleBox["E,F",
  FontSlant->"Italic"],
 "] = ",
 StyleBox["H",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.9112756443291283`*^9, 3.91127565809844*^9}, {
  3.913860122149164*^9, 3.913860227334321*^9}, {3.975125459143188*^9, 
  3.975125462513158*^9}, {3.975125721017774*^9, 
  3.975125744649893*^9}},ExpressionUUID->"12e14e48-20ba-40a8-a920-\
6444ae0a14ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MatrixCommutator", "[", 
    RowBox[{"A_", ",", "B_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"A", ".", "B"}], "-", 
    RowBox[{"B", ".", "A"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.910752674618153*^9, 3.9107526860248423`*^9}, {
  3.9751262006871967`*^9, 3.9751262012519913`*^9}},
 CellLabel->
  "In[505]:=",ExpressionUUID->"2deccf80-80c0-4b00-a87c-f2d2800e118d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"checkAlgebra", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"MatrixCommutator", "[", 
      RowBox[{"H", ",", "Eg"}], "]"}], "==", 
     RowBox[{"2", "Eg"}]}], ",", 
    RowBox[{
     RowBox[{"MatrixCommutator", "[", 
      RowBox[{"H", ",", "F"}], "]"}], "==", 
     RowBox[{
      RowBox[{"-", "2"}], "F"}]}], ",", " ", 
    RowBox[{
     RowBox[{"MatrixCommutator", "[", 
      RowBox[{"Eg", ",", "F"}], "]"}], "==", "H"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.91075266877427*^9, 3.910752746794621*^9}, {
   3.9107528572750673`*^9, 3.910752862389491*^9}, {3.9136901186529703`*^9, 
   3.913690120739779*^9}, {3.913802160272582*^9, 3.913802171784684*^9}, {
