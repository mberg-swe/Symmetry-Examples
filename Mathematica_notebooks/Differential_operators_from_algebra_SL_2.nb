Cell[TextData[{
 "So in the adjoint, the quadratic Casimir of sl(2) is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6ab20f1d-25e8-40d3-926b-7de5d358ed4a"],
 " = 3. (Note this is not the same as the trace of the Killing form above, \
which would be 2.) \nThere is no cubic invariant C3 for U(sl(2)), or higher, \
but there is C3 for sl(3). (According to \
https://en.wikipedia.org/wiki/Harish-Chandra_isomorphism, there are ",
 StyleBox["n",
  FontSlant->"Italic"],
 " fundamendal invariants for sl(",
 StyleBox["n",
  FontSlant->"Italic"],
 ").)\n\nNow implement the generators as differential operators on ",
 StyleBox["group",
  FontSlant->"Italic"],
 " elements ",
 StyleBox["g, ",
  FontSlant->"Italic"],
 "which for group components connected to the identity means the \
exponentiated generators."
}], "Text",
 CellChangeTimes->{{3.9138015518797073`*^9, 3.9138015596696873`*^9}, {
  3.913860234125907*^9, 3.913860427694223*^9}, {3.914300564157566*^9, 
  3.9143005989311934`*^9}, {3.9143006600297813`*^9, 3.914300689783864*^9}, {
  3.914301105718684*^9, 3.914301111482416*^9}, {3.914302534726514*^9, 
  3.9143025613037853`*^9}, {3.914316285973443*^9, 3.9143163489088287`*^9}, {
  3.914316474792533*^9, 3.91431649513729*^9}, {3.975126082312724*^9, 
  3.975126094386899*^9}, {3.9751334554491367`*^9, 3.975133508513035*^9}, {
  3.9751350066012707`*^9, 3.975135023925106*^9}, {3.975146106658622*^9, 
  3.975146112898196*^9}, {3.975147555680784*^9, 
  3.97514755636609*^9}},ExpressionUUID->"6d130153-1a5b-4e06-9b4b-\
7d7afb0fc8df"],

Cell[BoxData[
 RowBox[{
  RowBox[{"R", "[", 
   RowBox[{"g_", ",", "i_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"i", ",", "j"}], "]"}], 
     RowBox[{"D", "[", 
      RowBox[{"g", ",", 
       RowBox[{"x", "[", "j", "]"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.913802238863742*^9, 3.913802298859159*^9}, {
   3.91380235096522*^9, 3.913802366872694*^9}, {3.9138024087026987`*^9, 
   3.913802415985922*^9}, {3.913802599321124*^9, 3.913802609152287*^9}, 
   3.913802963125757*^9, {3.914292811516676*^9, 3.9142928155497513`*^9}, {
   3.914294458563093*^9, 3.9142944672300243`*^9}},
 CellLabel->
  "In[512]:=",ExpressionUUID->"6d364037-dda8-48b3-8ab4-db16730261cb"],

Cell[TextData[{
 "Since the group is non-Abelian we have some freedom how to write ",
 StyleBox["g",
  FontSlant->"Italic"],
 ". For example ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", "1", "]"}], " ", "E"}], " ", "+", " ", 
     RowBox[{
      RowBox[{"x", "[", "2", "]"}], " ", "F"}]}]], TraditionalForm]],
  ExpressionUUID->"69818827-e971-4d45-b868-962bc032858b"],
 " is not the same as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{
     RowBox[{"x", "[", "1", "]"}], " ", "E", " "}]], TraditionalForm]],
  ExpressionUUID->"ae0896e8-40f9-493f-845a-b69ed652fd0e"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{
     RowBox[{"x", "[", "2", "]"}], " ", "F", " "}]], TraditionalForm]],
  ExpressionUUID->"ab5c85c7-a7bc-43f8-a256-40a2575ba0fe"],
 ". (If we would try to differentiate with respect to one variable \
\[OpenCurlyDoubleQuote]at a time\[CloseCurlyDoubleQuote], we cannot get any \
non-Abelian structure.) Here, for later use, I want to use the ",
 StyleBox["Iwasawa-decomposition",
  FontSlant->"Italic"],
 " form, which is usually taken as the 2nd version."
}], "Text",
 CellChangeTimes->{{3.913802667305935*^9, 3.913802692378519*^9}, {
  3.913802912898303*^9, 3.913802913110214*^9}, {3.9138604441530313`*^9, 
  3.913860453223981*^9}, {3.9143025927556047`*^9, 3.914302705187607*^9}, {
  3.975126100387635*^9, 
  3.9751261325276823`*^9}},ExpressionUUID->"7ceb9840-196f-439f-a9b5-\
9578b5670419"],

Cell[TextData[{
 StyleBox["E",
  FontSlant->"Italic"],
 " is (also for higher rank) represented as an upper triangular matrix. So ",
 StyleBox["some ",
  FontSlant->"Italic"],
 "power ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", "n"], TraditionalForm]],ExpressionUUID->
  "47338612-bb55-448b-915e-747de2497519"],
 " becomes zero. Here in the 2x2 case, the power at which this happens is \
immediately at ",
 StyleBox["n ",
  FontSlant->"Italic"],
 "= 2:"
}], "Text",
 CellChangeTimes->{{3.913802799708908*^9, 3.913802833272976*^9}, 
   3.913802916109236*^9, {3.9142921092880173`*^9, 3.914292160653975*^9}, {
   3.975126137920624*^9, 
   3.975126165037222*^9}},ExpressionUUID->"b7e470c5-c6bc-4cfa-b204-\
2e86bf902611"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Eg", ".", "Eg"}]], "Input",
 CellChangeTimes->{{3.9138026952923527`*^9, 3.913802712148223*^9}, {
  3.9138027454053173`*^9, 3.9138027456529512`*^9}, {3.913802784320726*^9, 
