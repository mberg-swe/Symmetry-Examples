Cell["\<\
Garrett does a somewhat roundabout rearrangement to H^2/2 + 2EF -H.
Putting in the R differential operators, I get:\
\>", "Text",
 CellChangeTimes->{{3.914393925735837*^9, 3.914393939337667*^9}, {
  3.9143941020515633`*^9, 3.91439411653642*^9}, {3.914394229980289*^9, 
  3.914394249534588*^9}, {3.914394310826516*^9, 3.914394316581873*^9}, {
  3.9751265371697493`*^9, 3.975126541374652*^9}, {3.9751266736254053`*^9, 
  3.9751266856178703`*^9}},ExpressionUUID->"6c068001-53a7-463d-b329-\
536c4c59fcf6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"2", 
    RowBox[{"RExpl", "[", 
     RowBox[{
      RowBox[{"RExpl", "[", 
       RowBox[{
        RowBox[{"fGen", "[", 
         RowBox[{
          RowBox[{"x", "[", "1", "]"}], ",", 
          RowBox[{"x", "[", "3", "]"}]}], "]"}], ",", "1"}], "]"}], ",", 
      "1"}], "]"}]}], " ", "+", " ", 
   RowBox[{
    RowBox[{"RExpl", "[", 
     RowBox[{
      RowBox[{"RExpl", "[", 
       RowBox[{
        RowBox[{"fGen", "[", 
         RowBox[{
          RowBox[{"x", "[", "1", "]"}], ",", 
          RowBox[{"x", "[", "3", "]"}]}], "]"}], ",", "3"}], "]"}], ",", 
      "3"}], "]"}], "/", "2"}]}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.914393671749249*^9, 3.914393765888804*^9}, {
  3.914394019408464*^9, 3.9143940201250467`*^9}, {3.914394291271864*^9, 
  3.914394298701782*^9}},
 CellLabel->
  "In[549]:=",ExpressionUUID->"8b48adc4-6341-422b-8bfa-a81c941d6cea"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{
     SuperscriptBox["fGen", 
      TagBox[
       RowBox[{"(", 
        RowBox[{"0", ",", "2"}], ")"}],
       Derivative],
      MultilineFunction->None], "(", 
     RowBox[{
      SubscriptBox["x", "1"], ",", 
      SubscriptBox["x", "3"]}], ")"}]}], "+", 
   RowBox[{"2", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"4", " ", 
      SubscriptBox["x", "3"]}]], " ", 
    RowBox[{
     SuperscriptBox["fGen", 
      TagBox[
       RowBox[{"(", 
        RowBox[{"2", ",", "0"}], ")"}],
       Derivative],
      MultilineFunction->None], "(", 
