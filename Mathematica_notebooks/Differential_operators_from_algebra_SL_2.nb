Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "d"}], "}"}]}], "}"}], " ", "=", " ", 
   "\[CapitalGamma]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Expand", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"a", " ", "\[ImaginaryI]"}], " ", "+", " ", "b"}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"c", " ", "\[ImaginaryI]"}], " ", "+", " ", "d"}], ")"}]}], 
  "]"}]}], "Input",
