Cell[BoxData[
 FormBox["3", TraditionalForm]], "Output",
 CellChangeTimes->{
  3.914316434196097*^9, 3.914319039343884*^9, 3.914391906035304*^9, 
   3.9143921132362423`*^9, {3.9143922500188828`*^9, 3.914392283624186*^9}, 
   3.914406075407734*^9, 3.91440612240558*^9, 3.915514043880961*^9, {
   3.9155141553214197`*^9, 3.915514174003755*^9}, {3.9155146766964083`*^9, 
