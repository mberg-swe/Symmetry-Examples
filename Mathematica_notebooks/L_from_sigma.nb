Cell[CellGroupData[{

Cell["3. Why the Casimir is not a scalar on all four states", "Section",ExpressionUUID->"2505976f-e5da-4acd-8983-85ecc1a97777"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"pTriplet", "=", 
   RowBox[{"Q", ".", 
    TemplateBox[{"Q"},
     "ConjugateTranspose"]}]}], ";", 
  RowBox[{"pSinglet", "=", 
   RowBox[{"Outer", "[", 
    RowBox[{"Times", ",", "singlet", ",", 
     RowBox[{"Conjugate", "[", "singlet", "]"}]}], "]"}]}], ";", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"pTriplet", "+", "pSinglet"}], "\[Equal]", 
     RowBox[{"IdentityMatrix", "[", "4", "]"}]}], ",", 
    RowBox[{
     RowBox[{"pTriplet", ".", "pSinglet"}], "\[Equal]", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}]}], "}"}]}]], "Input",
 CellLabel->
  "In[135]:=",ExpressionUUID->"1f600be4-c69a-4fcf-af9c-071985b555f1"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"True", ",", "True"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.999773541367138*^9, 4.0032251368900633`*^9, 
  4.003225177939805*^9},
 CellLabel->
  "Out[135]=",ExpressionUUID->"baad21a3-c0d3-4a21-9d99-93ac9f537e57"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"casimirFull", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Total", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
        "totalSpin", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ".", 
        RowBox[{
        "totalSpin", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}],
        ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "3"}], "}"}]}], "]"}], "]"}], "]"}]}], ";", 
  RowBox[{"casimirTriplet", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Total", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
        "Ltriplet", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ".", 
        RowBox[{
        "Ltriplet", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "3"}], "}"}]}], "]"}], "]"}], "]"}]}], ";", 
  RowBox[{"Column", "[", 
   RowBox[{"MatrixForm", "/@", 
    RowBox[{"{", 
     RowBox[{"casimirFull", ",", "casimirTriplet"}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[136]:=",ExpressionUUID->"009fcbb2-fdfd-4bda-8522-4b3273be96bb"],

