    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
       "totalSpin", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ".",
        "Q"}], "-", 
      RowBox[{"Q", ".", 
       RowBox[{
       "Ltriplet", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}]}],
      "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "3"}], "}"}]}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[134]:=",ExpressionUUID->"d4630acd-ee43-4c73-8818-56465d962640"],

