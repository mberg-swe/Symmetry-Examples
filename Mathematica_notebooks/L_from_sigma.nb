Cell[TextData[{
 "Read off ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["J", "z"], "\[LongEqual]", 
   RowBox[{"\[HBar]", " ", "diag", 
    RowBox[{"(", 
     RowBox[{"1", ",", "0", ",", 
      RowBox[{"-", "1"}]}], ")"}]}]}]], "InlineFormula",ExpressionUUID->
  "4d8d4cfc-cc4f-4850-b8f8-eee9ab7cf8a0"],
 ". A change of state basis acts by similarity on every generator; it is \
different from mixing the labels x, y and z."
}], "Text",
 CellChangeTimes->{{4.0033085972191477`*^9, 
  4.0033086052543697`*^9}},ExpressionUUID->"b2d8d744-1481-4245-9744-\
f3c3656edde5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. A basis that transforms as a Cartesian vector", "Section",ExpressionUUID->"0867cc63-0c06-4ece-8512-c341aacfa8d9"],

Cell[TextData[{
 "Choose ",
 Cell[BoxData[
  RowBox[{"x", "\[LongEqual]", 
   RowBox[{"-", 
    SubscriptBox["T", "3"]}]}]], "InlineFormula",ExpressionUUID->
  "aacb0ffb-ca28-47fb-b4b8-d35611156eff"],
 ", ",
 Cell[BoxData[
  RowBox[{"y", "\[LongEqual]", 
   RowBox[{"\[ImaginaryI]", " ", 
    SubscriptBox["T", "2"]}]}]], "InlineFormula",ExpressionUUID->
  "17d77597-9743-4b54-ab7f-9889732881e4"],
 ", ",
 Cell[BoxData[
  RowBox[{"z", "\[LongEqual]", 
   SubscriptBox["T", "1"]}]], "InlineFormula",ExpressionUUID->
  "f184b468-115c-4e24-9140-14c85f111f2c"],
 " as state vectors. The phase i in the second vector makes the finite \
rotations real in this basis."
}], "Text",ExpressionUUID->"a537576f-c037-4b24-a683-f44f8cfca366"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"cartesianBasis", "=", 
   TemplateBox[{
     RowBox[{"{", 
       RowBox[{
         RowBox[{"-", 
           
           RowBox[{"triplet", "\[LeftDoubleBracket]", "3", 
             "\[RightDoubleBracket]"}]}], ",", 
         RowBox[{"\[ImaginaryI]", " ", 
           
           RowBox[{"triplet", "\[LeftDoubleBracket]", "2", 
             "\[RightDoubleBracket]"}]}], ",", 
         RowBox[{
          "triplet", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
        "}"}]},
    "Transpose"]}], ";", 
  RowBox[{"changeCartesian", "=", 
   RowBox[{
    TemplateBox[{"Q"},
     "ConjugateTranspose"], ".", "cartesianBasis"}]}], ";", 
  TagBox["changeCartesian",
   Function[BoxForm`e$, 
    MatrixForm[BoxForm`e$]]]}]], "Input",
 CellLabel->
