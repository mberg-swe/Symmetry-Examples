Cell[CellGroupData[{

Cell["7. Two spinor rotations give one vector rotation", "Section",ExpressionUUID->"d00414aa-369f-4fb7-9aca-fa7dae9c9f03"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"spinorZ", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", "\[Theta]", " ", 
      RowBox[{
      "sigma", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], 
     "]"}], "]"}]}], ";", 
  TagBox["spinorZ",
   Function[BoxForm`e$, 
    MatrixForm[BoxForm`e$]]]}]], "Input",
 CellChangeTimes->{{4.003225173994608*^9, 4.003225173999366*^9}},
 CellLabel->
  "In[150]:=",ExpressionUUID->"c30ded1d-a3f2-4fd8-a2d0-a047efc05940"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}], "2"]}]], "0"},
     {"0", 
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}], "2"]]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.999773541449306*^9, 4.0032251369799223`*^9, 
  4.0032251780298233`*^9},
 CellLabel->
  "Out[150]=",ExpressionUUID->"db6d5294-260d-4418-875e-4bf51fa2cba2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"rotationFromSpinors", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     TemplateBox[{"cartesianBasis"},
      "ConjugateTranspose"], ".", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"spinorZ", ",", "spinorZ"}], "]"}], ".", "cartesianBasis"}], 
    "]"}]}], ";", 
  TagBox["rotationFromSpinors",
   Function[BoxForm`e$, 
    MatrixForm[BoxForm`e$]]]}]], "Input",
 CellLabel->
  "In[151]:=",ExpressionUUID->"71a1acf1-310a-4196-9018-ef726198ec8d"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"cos", "(", "\[Theta]", ")"}], 
      RowBox[{"-", 
       RowBox[{"sin", "(", "\[Theta]", ")"}]}], "0"},
     {
      RowBox[{"sin", "(", "\[Theta]", ")"}], 
      RowBox[{"cos", "(", "\[Theta]", ")"}], "0"},
     {"0", "0", "1"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.999773541464036*^9, 4.003225136999464*^9, 
  4.0032251780444813`*^9},
 CellLabel->
  "Out[151]=",ExpressionUUID->"cb992a2a-460d-44d9-9d8b-7ddc3a757730"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"rotationFromSpinors", "\[Equal]", "rotationZ"}], "]"}]], "Input",
 CellLabel->
  "In[152]:=",ExpressionUUID->"ce4e8494-f5cd-43e3-bd50-5fc7d69809f5"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{3.999773541465966*^9, 4.0032251370014257`*^9, 
  4.003225178046823*^9},
 CellLabel->
  "Out[152]=",ExpressionUUID->"4067e268-11df-489e-afd3-920786beb142"]
}, Open  ]],

Cell[TextData[{
 "After a ",
 Cell[BoxData[
  RowBox[{"2", " ", "\[Pi]"}]], "InlineFormula",ExpressionUUID->
  "0f910360-e3fc-4f21-9802-78723b9c4ac9"],
 " rotation one spinor changes sign. Two spinors give two minus signs, so the \
triplet returns to itself. This is why it defines a representation of SO(3)."
}], "Text",ExpressionUUID->"0c018915-2c02-4a92-94e2-dfb7b8fbbd53"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"spinorZ", "/.", "\[VeryThinSpace]", 
      RowBox[{"\[Theta]", "\[Rule]", 
       RowBox[{"2", " ", "\[Pi]"}]}]}], "]"}], "\[Equal]", 
    RowBox[{"-", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ",", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"rotationZ", "/.", "\[VeryThinSpace]", 
      RowBox[{"\[Theta]", "\[Rule]", 
       RowBox[{"2", " ", "\[Pi]"}]}]}], "]"}], "\[Equal]", 
    RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "}"}]], "Input",
 CellChangeTimes->{4.003225174001309*^9},
 CellLabel->
  "In[153]:=",ExpressionUUID->"323932ac-ef02-4372-b2ce-be4f6e7cf95c"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"True", ",", "True"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.999773541467482*^9, 4.0032251370111227`*^9, 
  4.003225178053125*^9},
 CellLabel->
  "Out[153]=",ExpressionUUID->"92e92446-5f5a-48af-aa81-f18cde5ae93c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. The connection with p orbitals", "Section",ExpressionUUID->"b6d9c8fc-35bb-47ee-acbf-230d24479cfb"],

Cell[TextData[{
 "For orbitals with a common radial factor, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["p", "x"], "\[LongEqual]", 
   RowBox[{"x", " ", 
    RowBox[{"f", "(", "r", ")"}]}]}]], "InlineFormula",ExpressionUUID->
  "359c5b33-30f3-4af5-a6d1-0aa8b9a022c8"],
 " and similarly for y and z, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["L", "z"], "\[LongEqual]", 
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", "\[HBar]", " ", 
    RowBox[{"(", 
     RowBox[{"x", " ", 
      RowBox[{
       SubscriptBox["\[PartialD]", "y"], 
       RowBox[{"-", "y"}]}], " ", 
      SubscriptBox["\[PartialD]", "x"]}], ")"}]}]}]], "InlineFormula",
  ExpressionUUID->"82940a1f-e513-4157-b607-0417496ee0b7"],
 ". A radial factor is unchanged by rotations, so we can check the angular \
action using x, y and z alone."
}], "Text",
 CellChangeTimes->{{4.003225257838298*^9, 
  4.0032252607209053`*^9}},ExpressionUUID->"57897758-fd27-42f7-a159-\
bb528bc249c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"orbitalLz", "[", "expression_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", "\[HBar]", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"x", " ", 
       RowBox[{
        SubscriptBox["\[PartialD]", "y"], "expression"}]}], "-", 
      RowBox[{"y", " ", 
       RowBox[{
        SubscriptBox["\[PartialD]", "x"], "expression"}]}]}], ")"}]}]}], ";", 
  
  RowBox[{"orbitalImages", "=", 
   RowBox[{"orbitalLz", "/@", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z"}], "}"}]}]}]}]], "Input",
 CellChangeTimes->{{4.0032251549922857`*^9, 4.003225154993808*^9}},
 CellLabel->
  "In[154]:=",ExpressionUUID->"f4eaef7b-1fc6-4810-97e3-bd17fb8e0b15"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[ImaginaryI]", " ", "y", " ", "\[HBar]"}], ",", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "x", " ", "\[HBar]"}], ",", "0"}], 
   "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.999773541483033*^9, 4.0032251370133953`*^9, 
  4.00322517805726*^9},
 CellLabel->
  "Out[154]=",ExpressionUUID->"6bdb5117-f6d4-4921-8409-6a1c1af19bdb"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"orbitalMatrix", "=", 
   TemplateBox[{
     RowBox[{"Table", "[", 
       RowBox[{
         RowBox[{"Coefficient", "[", 
           RowBox[{
             
             RowBox[{"orbitalImages", "\[LeftDoubleBracket]", "k", 
               "\[RightDoubleBracket]"}], ",", 
             RowBox[{"{", 
               RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
           RowBox[{"k", ",", "3"}], "}"}]}], "]"}]},
    "Transpose"]}], ";", 
  RowBox[{"orbitalMatrix", "\[Equal]", 
   RowBox[{
   "Jcartesian", "\[LeftDoubleBracket]", "3", 
    "\[RightDoubleBracket]"}]}]}]], "Input",
 CellLabel->
  "In[155]:=",ExpressionUUID->"1f6ef3c1-1741-43ad-b981-27321f7bd881"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{3.9997735414945707`*^9, 4.003225137019155*^9, 
  4.00322517806439*^9},
 CellLabel->
  "Out[155]=",ExpressionUUID->"cc7e3dfc-8796-4da7-941e-a295a1397a37"]
}, Open  ]],

Cell["\<\
The same matrix acts on the three p orbitals and on our Cartesian triplet. \
This is an equivalence of rotation representations; it does not require two \
physical spins to generate orbital motion. Try repeating the orbital \
calculation for the other two axes.\
\>", "Text",ExpressionUUID->"d9de6cb5-7615-4e77-8d0f-81c225b8f4c5"],

Cell[CellGroupData[{

Cell["Checks", "Subsubsection",ExpressionUUID->"193b8312-70c9-44c9-97cf-f2510472c2a6"],

Cell["The three triplet states are orthonormal.", "Text",ExpressionUUID->"bb898b75-d73d-44ee-878f-479a1c573fb4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   TemplateBox[{"Q"},
    "ConjugateTranspose"], ".", "Q"}], "\[Equal]", 
  RowBox[{"IdentityMatrix", "[", "3", "]"}]}]], "Input",
 CellTags->
  "spin1-check-1",ExpressionUUID->"59b99d60-e790-4fda-b1ad-a3388d26a37c"],

Cell[BoxData["True"], "Output",ExpressionUUID->"097995b7-9719-4988-ba12-3bc3f8164117"]
}, Open  ]],

Cell["Every component of total spin annihilates the singlet.", "Text",ExpressionUUID->"4ffb6dcc-1957-4dd8-8b5d-99a33ee9c28d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"And", "@@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
       "totalSpin", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ".",
        "singlet"}], "]"}], "\[Equal]", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "4"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "3"}], "}"}]}], "]"}]}]], "Input",
 CellTags->
  "spin1-check-2",ExpressionUUID->"e4d75769-e320-4515-9483-16186df66d0b"],

Cell[BoxData["True"], "Output",ExpressionUUID->"d20b7cc1-3807-4fcc-9018-905b8d00d54e"]
}, Open  ]],

Cell[TextData[{
 "The full total-spin-squared operator is ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox["\[HBar]", "2"]}]], "InlineFormula",ExpressionUUID->
  "bbaf7ee3-a6b0-432d-90dc-b2e063259e0d"],
 " times the triplet projector, and vanishes on the singlet."
}], "Text",ExpressionUUID->"054cb541-ce30-4033-8a6f-d01f271f032e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"casimirFull", "\[Equal]", 
  RowBox[{"2", " ", 
   SuperscriptBox["\[HBar]", "2"], " ", "pTriplet"}]}]], "Input",
 CellTags->
  "spin1-check-3",ExpressionUUID->"bb56cb5e-e168-4e55-8dab-7a3fecc8b20e"],

Cell[BoxData["True"], "Output",ExpressionUUID->"013efbee-3e39-4f24-8841-22f26a7314f8"]
}, Open  ]],

Cell[TextData[{
 "On the triplet, total spin squared is ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox["\[HBar]", "2"]}]], "InlineFormula",ExpressionUUID->
  "b5da1909-5162-4b89-984e-abb19a4d7928"],
 " times the identity."
}], "Text",ExpressionUUID->"7acc25f7-55cf-4e04-86dd-c2e4ca8a437b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"casimirTriplet", "\[Equal]", 
  RowBox[{"2", " ", 
   SuperscriptBox["\[HBar]", "2"], " ", 
   RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}]], "Input",
 CellTags->
  "spin1-check-4",ExpressionUUID->"27e67637-9c2f-4ec1-9731-f4c0e3ea0630"],

Cell[BoxData["True"], "Output",ExpressionUUID->"03bc46d4-6d02-4715-b8a3-26c074c967b3"]
}, Open  ]],

Cell["\<\
The Pauli-matrix construction gives the Cartesian basis states.\
\>", "Text",ExpressionUUID->"e90e5a73-af75-49d9-97a1-fa10cadba2a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pauliBasis", "\[Equal]", "cartesianBasis"}]], "Input",
 CellTags->
  "spin1-check-5",ExpressionUUID->"b8997be7-a103-455f-9ece-181c72b58fce"],

Cell[BoxData["True"], "Output",ExpressionUUID->"e3524ade-4695-4fb0-8082-b5621caea1ed"]
}, Open  ]],

Cell["\<\
The rotation constructed from the two spinors agrees with the vector rotation \
about the z axis.\
\>", "Text",ExpressionUUID->"96986529-068b-4bf3-9ff3-a3e453093fad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"rotationFromSpinors", "\[Equal]", "rotationZ"}], "]"}]], "Input",
 CellTags->
  "spin1-check-6",ExpressionUUID->"c5f89b2a-89a4-46f4-a1e9-18139d4291a5"],

Cell[BoxData["True"], "Output",ExpressionUUID->"c1a6f3bc-6b9e-4826-8165-3df667bcb018"]
}, Open  ]],

Cell["\<\
The orbital generator agrees with the z component of the Cartesian spin-one \
generator.\
\>", "Text",ExpressionUUID->"8f87a080-f445-47fe-8521-d26fe8d81154"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"orbitalMatrix", "\[Equal]", 
  RowBox[{
  "Jcartesian", "\[LeftDoubleBracket]", "3", 
   "\[RightDoubleBracket]"}]}]], "Input",
 CellTags->
  "spin1-check-7",ExpressionUUID->"244d0d11-61bc-4631-8cf8-d7655b4d6046"],

Cell[BoxData["True"], "Output",ExpressionUUID->"c36a20a2-f989-4c6a-8a34-19ce31423e54"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]]
},
