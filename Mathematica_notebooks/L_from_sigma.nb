}, Open  ]],

Cell[TextData[{
 "On the triplet, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["L", "2"], "\[LongEqual]", 
   RowBox[{"2", " ", 
    SubscriptBox["I", "3"], " ", 
    SuperscriptBox["\[HBar]", "2"]}]}]], "InlineFormula",ExpressionUUID->
  "638dcdac-3a35-43df-a299-66f8fcf8e2ce"],
 ". On the singlet it is zero. On the full space the correct statement is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["L", "2"], "\[LongEqual]", 
   RowBox[{"2", " ", 
    SuperscriptBox["\[HBar]", "2"], " ", 
    SubscriptBox["P", "triplet"]}]}]], "InlineFormula",ExpressionUUID->
  "6ad74f47-7406-4197-9288-f2d1b6f0b372"],
 ". A scalar on each irreducible piece need not be scalar on their direct sum."
}], "Text",
 CellChangeTimes->{{4.003308573025597*^9, 
  4.0033085740212183`*^9}},ExpressionUUID->"4b4bcce3-e1e9-4347-b977-\
c1e7ded0157c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"casimirFull", "\[Equal]", 
    RowBox[{"2", " ", 
     SuperscriptBox["\[HBar]", "2"], " ", "pTriplet"}]}], ",", 
   RowBox[{"casimirTriplet", "\[Equal]", 
    RowBox[{"2", " ", 
     SuperscriptBox["\[HBar]", "2"], " ", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}]}], "}"}]], "Input",
 CellChangeTimes->{{4.003225154982707*^9, 4.003225154989472*^9}},
 CellLabel->
  "In[137]:=",ExpressionUUID->"10b804bd-f49c-4ae1-944b-0c600034430d"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"True", ",", "True"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.9997735413762836`*^9, 4.003225136898892*^9, 
  4.003225177950082*^9},
 CellLabel->
  "Out[137]=",ExpressionUUID->"c9cc7da6-2dd5-4842-84af-106aa2481432"]
}, Open  ]],

Cell[TextData[{
 "Exercise: is ",
 StyleBox["ud", "Input"],
 " a singlet? Decompose it into the symmetric and antisymmetric states. The \
following calculation gives the probabilities for obtaining total spin one \
and zero."
}], "Text",
 CellChangeTimes->{{4.003308584495632*^9, 
  4.003308585095573*^9}},ExpressionUUID->"6635207f-eeed-4180-aa23-\
0e65ed620c92"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", "ud", "]"}], ".", "pTriplet", ".", "ud"}], ",", 
    RowBox[{
     RowBox[{"Conjugate", "[", "ud", "]"}], ".", "pSinglet", ".", "ud"}]}], 
   "}"}], "]"}]], "Input",
 CellLabel->
  "In[138]:=",ExpressionUUID->"cdc05ae5-61b4-4f01-a245-5c33a702ff27"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    FractionBox["1", "2"], ",", 
    FractionBox["1", "2"]}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.99977354137794*^9, 4.003225136901081*^9, 
  4.003225177951756*^9},
 CellLabel->
  "Out[138]=",ExpressionUUID->"fdfc61e3-7db2-4af8-b22e-0b5344b281e4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Recover the familiar magnetic basis", "Section",ExpressionUUID->"f41cd54c-273d-48c7-9a31-9baeb7dfcb6f"],

Cell[TextData[{
 "The usual ordered basis is ",
 "{|1,1\:27e9, |1,0\:27e9, |1,\[Minus]1\:27e9}",
 ", namely {uu, ",
 Cell[BoxData[
  SubscriptBox["T", "1"]], "InlineFormula",ExpressionUUID->
  "7d5e1c59-b4aa-4c89-b94e-6ad2c8753993"],
 ", dd}. Compute its coordinates in our triplet basis. These coordinate \
vectors become the columns of the change-of-basis matrix."
}], "Text",ExpressionUUID->"a321df6f-30ea-4aed-af12-626c3b8a5e13"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"magneticBasis", "=", 
   TemplateBox[{
     RowBox[{"{", 
       RowBox[{"uu", ",", 
         RowBox[{
          "triplet", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
         ",", "dd"}], "}"}]},
    "Transpose"]}], ";", 
  RowBox[{"changeMagnetic", "=", 
   RowBox[{
    TemplateBox[{"Q"},
     "ConjugateTranspose"], ".", "magneticBasis"}]}], ";", 
  TagBox["changeMagnetic",
   Function[BoxForm`e$, 
    MatrixForm[BoxForm`e$]]]}]], "Input",
 CellLabel->
  "In[139]:=",ExpressionUUID->"eed2963f-2d07-4190-aa4d-139d542fde31"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", "1", "0"},
     {
      FractionBox["1", 
       SqrtBox["2"]], "0", 
      FractionBox["1", 
       SqrtBox["2"]]},
     {
      FractionBox["1", 
       SqrtBox["2"]], "0", 
      RowBox[{"-", 
       FractionBox["1", 
        SqrtBox["2"]]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.9997735413805943`*^9, 4.003225136907151*^9, 
  4.003225177962521*^9},
 CellLabel->
  "Out[139]=",ExpressionUUID->"f893b51a-c512-4bf6-a463-98f0d1223d3d"]
}, Open  ]],

