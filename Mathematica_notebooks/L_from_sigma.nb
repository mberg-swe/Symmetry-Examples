    },
    DefaultBaseStyle->"Column",
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Column"], TraditionalForm]], "Output",
 CellChangeTimes->{3.999773541345975*^9, 4.003225136872637*^9, 
  4.003225177920147*^9},
 CellLabel->
  "Out[132]=",ExpressionUUID->"13d495d5-78ef-4e2b-bccd-194c799f1cad"]
}, Open  ]],

Cell[TextData[{
 "For example, the first column of the first matrix says ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["T", "1"], " ", 
    SubscriptBox["L", "x"]}], "\[LongEqual]", 
   RowBox[{
    SubscriptBox["T", "2"], " ", "\[HBar]"}]}]], "InlineFormula",
  ExpressionUUID->"244f304f-08af-4aac-bfda-b645d022ceb8"],
 ". Check this directly in the four-dimensional space."
}], "Text",ExpressionUUID->"b73393f8-9a3d-4c14-bcfc-a91c3f4a8f7f"],

Cell[CellGroupData[{

