    "triplet", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], "-", 
   
   RowBox[{"\[HBar]", " ", 
    RowBox[{
    "triplet", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], 
  "]"}]], "Input",
