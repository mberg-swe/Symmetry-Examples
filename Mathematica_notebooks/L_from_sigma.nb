  4.003225178000183*^9},
 CellLabel->
  "Out[145]=",ExpressionUUID->"d21cb4b6-5ff0-4a40-b34f-8019652e9d4b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Why the Pauli formula needs an antisymmetric tensor", "Section",ExpressionUUID->"94167a7c-b196-4747-816f-bdedb9fb355f"],

Cell[TextData[{
 "One might try to use the entries of ",
 Cell[BoxData[
  SubscriptBox["\[Sigma]", "i"]], "InlineFormula",ExpressionUUID->
  "16158d9f-710e-4ca8-b647-70d83749736f"],
 " directly as two-spin coefficients. But ",
 Cell[BoxData[
  SubscriptBox["\[Sigma]", "y"]], "InlineFormula",ExpressionUUID->
  "213a893a-4c43-43ce-812e-7ba8d79ab881"],
 " is antisymmetric, so it would produce the singlet! Insert ",
 Cell[BoxData[
  RowBox[{"\[Epsilon]", "\[LongEqual]", 
   RowBox[{"\[ImaginaryI]", " ", 
    SubscriptBox["\[Sigma]", "y"]}]}]], "InlineFormula",ExpressionUUID->
  "32c06a58-3d13-4885-83f2-df8f1fa53048"],
 " on the second index instead."
}], "Text",ExpressionUUID->"53bf4f1d-c6ca-4362-83a2-dcbde62822bd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"epsilon", "=", 
   RowBox[{"\[ImaginaryI]", " ", 
    RowBox[{
    "sigma", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], ";", 
  
  RowBox[{"pairMatrices", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"sigma", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
       ".", "epsilon"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "3"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"Column", "[", 
   RowBox[{"MatrixForm", "/@", "pairMatrices"}], "]"}]}]], "Input",
 CellLabel->
  "In[146]:=",ExpressionUUID->"2b3255a1-9fac-424a-ab91-2f7748a9a9b6"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {
      TagBox[
       RowBox[{"(", "\[NoBreak]", GridBox[{
          {
           RowBox[{"-", "1"}], "0"},
          {"0", "1"}
         },
         GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
         GridBoxSpacings->{"Columns" -> {
             Offset[0.27999999999999997`], {
              Offset[0.7]}, 
             Offset[0.27999999999999997`]}, "Rows" -> {
             Offset[0.2], {
              Offset[0.4]}, 
             Offset[0.2]}}], "\[NoBreak]", ")"}],
       Function[BoxForm`e$, 
        MatrixForm[BoxForm`e$]]]},
     {
