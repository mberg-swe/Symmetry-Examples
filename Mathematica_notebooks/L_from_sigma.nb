 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"rotationZ", "/.", "\[VeryThinSpace]", 
     RowBox[{"\[Theta]", "\[Rule]", 
      FractionBox["\[Pi]", "2"]}]}], ")"}], ".", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{4.003225173993388*^9},
 CellLabel->
  "In[145]:=",ExpressionUUID->"5e96a97f-d15d-4a1e-8ccf-8efdbf024e1b"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"0", ",", "1", ",", "0"}], "}"}], TraditionalForm]], "Output",
