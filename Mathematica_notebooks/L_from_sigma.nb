Cell[TextData[{
 "The entries are ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    SubscriptBox["J", "i"], "jk"], "\[LongEqual]", 
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", "\[HBar]", " ", 
    SubscriptBox["\[Epsilon]", "ijk"]}]}]], "InlineFormula",ExpressionUUID->
  "6e1fc9ec-2fde-47df-ac16-356cd39b9e4b"],
 ". These are precisely the generators of vector rotations. Check the \
commutator, then exponentiate the z generator."
}], "Text",ExpressionUUID->"5ffce444-c68a-4a59-945c-e2803798a67b"],

