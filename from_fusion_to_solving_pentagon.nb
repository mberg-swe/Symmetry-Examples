       RowBox[{"2", ",", "3", ",", "2", ",", "3", ",", "2", ",", "2"}], "}"}], 
      RowBox[{"-", "1"}]},
     {
      RowBox[{"{", 
       RowBox[{"2", ",", "3", ",", "3", ",", "2", ",", "2", ",", "1"}], "}"}],
       "1"},
