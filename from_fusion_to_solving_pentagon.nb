Cell["\<\
So, for this fusion ring, there are 14 unknowns, after picking unit gauge.\
\>", "Text",
 CellChangeTimes->{{3.9960448786438293`*^9, 3.996044885689043*^9}, {
  3.9960476866296377`*^9, 3.9960476887184057`*^9}, {3.99812403629515*^9, 
  3.9981240434907217`*^9}},ExpressionUUID->"8e14e698-c9ed-4b07-8724-\
77d7db7131b0"],

Cell[TextData[{
 StyleBox["Generate the complete pentagon system",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 "\[LineSeparator]The initial tree is (((a b)_p c)_q d)_t and the final tree \
is (a (b (c d)_s)_r)_t. For every admissible choice of labels we equate the \
three-F \[OpenCurlyDoubleQuote]long route\[CloseCurlyDoubleQuote] with the \
two-F \[OpenCurlyDoubleQuote]short route\[CloseCurlyDoubleQuote]."
}], "Text",
 CellChangeTimes->{{3.996043251633037*^9, 3.9960432522318*^9}, {
  3.998124051142991*^9, 
  3.9981240560983887`*^9}},ExpressionUUID->"9a475447-64f6-4cfd-81ef-\
d2bdebc55f52"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pentagonTupleQ", "[", 
    RowBox[{"{", 
     RowBox[{
     "a_", ",", "b_", ",", "c_", ",", "d_", ",", "t_", ",", "p_", ",", "q_", ",",
       "r_", ",", "s_"}], "}"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"allowedQ", "[", 
     RowBox[{"a", ",", "b", ",", "p"}], "]"}], "\[And]", 
    RowBox[{"allowedQ", "[", 
     RowBox[{"p", ",", "c", ",", "q"}], "]"}], "\[And]", 
    RowBox[{"allowedQ", "[", 
     RowBox[{"q", ",", "d", ",", "t"}], "]"}], "\[And]", 
    RowBox[{"allowedQ", "[", 
     RowBox[{"c", ",", "d", ",", "s"}], "]"}], "\[And]", 
    RowBox[{"allowedQ", "[", 
     RowBox[{"b", ",", "s", ",", "r"}], "]"}], "\[And]", 
    RowBox[{"allowedQ", "[", 
     RowBox[{"a", ",", "r", ",", "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pentagonEquation", "[", 
    RowBox[{"{", 
     RowBox[{
     "a_", ",", "b_", ",", "c_", ",", "d_", ",", "t_", ",", "p_", ",", "q_", ",",
       "r_", ",", "s_"}], "}"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "longRoute", ",", "shortRoute"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"longRoute", "=", "\[IndentingNewLine]", 
       RowBox[{"Total", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Fsymbol", "[", 
            RowBox[{"a", ",", "b", ",", "c", ",", "q", ",", "p", ",", "x"}], 
            "]"}], 
           RowBox[{"Fsymbol", "[", 
            RowBox[{"a", ",", "x", ",", "d", ",", "t", ",", "q", ",", "r"}], 
            "]"}], 
           RowBox[{"Fsymbol", "[", 
            RowBox[{"b", ",", "c", ",", "d", ",", "r", ",", "x", ",", "s"}], 
            "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "labels"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"shortRoute", "=", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Fsymbol", "[", 
         RowBox[{"p", ",", "c", ",", "d", ",", "t", ",", "q", ",", "s"}], 
         "]"}], 
        RowBox[{"Fsymbol", "[", 
         RowBox[{"a", ",", "b", ",", "s", ",", "t", ",", "p", ",", "r"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"longRoute", "==", "shortRoute"}]}]}], "]"}]}], ";"}]}], "Input",\

 CellChangeTimes->{{3.996043809686922*^9, 3.996043812809717*^9}, {
