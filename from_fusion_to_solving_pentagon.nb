       RowBox[{"3", ",", "2", ",", "2", ",", "1", ",", "2", ",", "3"}], "}"}],
       "1"},
     {
      RowBox[{"{", 
       RowBox[{"3", ",", "2", ",", "2", ",", "3", ",", "2", ",", "1"}], "}"}],
       "1"},
     {
      RowBox[{"{", 
       RowBox[{"3", ",", "2", ",", "3", ",", "2", ",", "2", ",", "2"}], "}"}], 
      RowBox[{"-", "1"}]},
     {
      RowBox[{"{", 
       RowBox[{"3", ",", "3", ",", "2", ",", "2", ",", "1", ",", "2"}], "}"}],
       "1"},
     {
      RowBox[{"{", 
       RowBox[{"3", ",", "3", ",", "3", ",", "3", ",", "1", ",", "1"}], "}"}],
       "1"}
    },
    AutoDelete->False,
    GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Grid"], TraditionalForm]], "Output",
 CellChangeTimes->{
  3.996043391326096*^9, 3.996043434480179*^9, 3.996043912972075*^9, 
   3.996044254549704*^9, {3.9960442874189262`*^9, 3.996044323696072*^9}, {
   3.996044360292919*^9, 3.996044376009362*^9}, 3.9960450881813517`*^9, {
   3.9960468673106937`*^9, 3.996046879811592*^9}, {3.996046943577568*^9, 
   3.996046967970593*^9}, 3.9960470794996643`*^9, 3.998124105764208*^9},
 CellLabel->
  "Out[1405]=",ExpressionUUID->"8f1e4458-76b6-47c4-be6b-9926c5ae14ea"]
}, Open  ]],

Cell["Pick the branch with positive upper-left entry in F^{222}_2:", "Text",
 CellChangeTimes->{{3.9960445172404137`*^9, 3.996044517602264*^9}, {
  3.996045284478569*^9, 
  3.9960452908065777`*^9}},ExpressionUUID->"8d1b4294-d1dc-4daf-81a2-\
47f9740cec39"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", " ", "=", " ", 
  RowBox[{"solutions", "[", 
   RowBox[{"[", "2", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.996045259509548*^9, 3.996045265405134*^9}, 
   3.996046877498064*^9},
 CellLabel->
  "In[1406]:=",ExpressionUUID->"56d72ddd-c1ef-4345-bb76-e58dd2c57418"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"f222211", "\[Rule]", 
     FractionBox["1", 
      SqrtBox["2"]]}], ",", 
    RowBox[{"f222213", "\[Rule]", 
     FractionBox["1", 
      SqrtBox["2"]]}], ",", 
    RowBox[{"f222231", "\[Rule]", 
     FractionBox["1", 
      SqrtBox["2"]]}], ",", 
    RowBox[{"f222233", "\[Rule]", 
     RowBox[{"-", 
      FractionBox["1", 
       SqrtBox["2"]]}]}], ",", 
    RowBox[{"f223132", "\[Rule]", "1"}], ",", 
    RowBox[{"f223312", "\[Rule]", "1"}], ",", 
    RowBox[{"f232122", "\[Rule]", "1"}], ",", 
    RowBox[{"f232322", "\[Rule]", 
     RowBox[{"-", "1"}]}], ",", 
    RowBox[{"f233221", "\[Rule]", "1"}], ",", 
    RowBox[{"f322123", "\[Rule]", "1"}], ",", 
    RowBox[{"f322321", "\[Rule]", "1"}], ",", 
    RowBox[{"f323222", "\[Rule]", 
     RowBox[{"-", "1"}]}], ",", 
    RowBox[{"f332212", "\[Rule]", "1"}], ",", 
    RowBox[{"f333311", "\[Rule]", "1"}]}], "}"}], TraditionalForm]], "Output",\

 CellChangeTimes->{{3.996045262563376*^9, 3.996045265635816*^9}, {
   3.996046867312579*^9, 3.996046879815099*^9}, {3.996046943591604*^9, 
   3.996046967972485*^9}, 3.99604707950152*^9, 3.9981241057670097`*^9},
 CellLabel->
  "Out[1406]=",ExpressionUUID->"0a0c0920-6abe-4e74-9ca9-99d946849445"]
}, Open  ]],

Cell["\<\
Now assemble the four scalar entries of F^{222}_2, with intermediate channels \
ordered as {1,3}.\
\>", "Text",ExpressionUUID->"62c85542-8d9c-467d-9acd-b0899ac7e1c6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"channels", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"F", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Fsymbol", "[", 
       RowBox[{"2", ",", "2", ",", "2", ",", "2", ",", "e", ",", "f"}], "]"}],
       ",", 
      RowBox[{"{", 
       RowBox[{"e", ",", "channels"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"f", ",", "channels"}], "}"}]}], "]"}], "/.", "sol"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.9960452222467537`*^9, 3.996045233397993*^9}},
 CellLabel->
  "In[1407]:=",ExpressionUUID->"99749a19-0265-44f9-90db-1cc4742d1dfd"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      FractionBox["1", 
       SqrtBox["2"]], 
      FractionBox["1", 
       SqrtBox["2"]]},
     {
      FractionBox["1", 
       SqrtBox["2"]], 
      RowBox[{"-", 
       FractionBox["1", 
        SqrtBox["2"]]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{
  3.9960432107312737`*^9, 3.9960433333004417`*^9, 3.9960433913345423`*^9, 
   3.996043434487411*^9, 3.996043912980763*^9, 3.99604428742642*^9, 
   3.996045088185096*^9, {3.996045231344514*^9, 3.996045233750882*^9}, {
   3.996046867320106*^9, 3.996046879821887*^9}, {3.996046943598855*^9, 
   3.996046967974258*^9}, 3.996047079503252*^9, 3.998124105770885*^9},
 CellLabel->
  "Out[1408]=",ExpressionUUID->"f49d2036-2813-4319-b4d5-d22b6de8fe91"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Extract one four-particle pentagon: F Z F = X\[LineSeparator]",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 "Specialize to four external 2's with total channel 3. The middle long-route \
recoupling is diagonal in the intermediate channel."
}], "Text",
 CellChangeTimes->{{3.996044528295405*^9, 
  3.996044528704423*^9}},ExpressionUUID->"b42724c7-7d52-44fd-9f38-\
f8592af891d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Z", "=", "\[IndentingNewLine]", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Fsymbol", "[", 
        RowBox[{"2", ",", "x", ",", "2", ",", "3", ",", "2", ",", "2"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "channels"}], "}"}]}], "]"}], "]"}], "/.", "sol"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.996044539139752*^9, 3.996044546856923*^9}, {
  3.996045237298663*^9, 3.9960452379719267`*^9}},
 CellLabel->
  "In[1409]:=",ExpressionUUID->"9419c3f2-d171-42bc-a76d-678fa5d1601b"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"1", "0"},
     {"0", 
      RowBox[{"-", "1"}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{
  3.996043210738884*^9, 3.996043333307951*^9, 3.9960433913402853`*^9, 
   3.996043434490529*^9, 3.996043912982737*^9, 3.996044287429288*^9, 
   3.996044547532322*^9, 3.996045088186838*^9, 3.99604523835946*^9, {
   3.996046867323882*^9, 3.996046879823826*^9}, {3.996046943605646*^9, 
   3.996046967975828*^9}, 3.9960470795048237`*^9, 3.998124105779002*^9},
 CellLabel->
  "Out[1409]=",ExpressionUUID->"56538c0c-700f-4ffd-b5ed-5646114590a9"]
}, Open  ]],

Cell["\<\
The complete short route is obtained from the two scalar F-symbols on that \
side of the pentagon.\
\>", "Text",ExpressionUUID->"8245aec8-dd05-40aa-b387-5d6e45c426a0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"X", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Fsymbol", "[", 
        RowBox[{"p", ",", "2", ",", "2", ",", "3", ",", "2", ",", "s"}], 
        "]"}], 
       RowBox[{"Fsymbol", "[", 
        RowBox[{"2", ",", "2", ",", "s", ",", "3", ",", "p", ",", "2"}], 
        "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"p", ",", "channels"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "channels"}], "}"}]}], "]"}], "/.", "sol"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.996044551416048*^9, 3.9960445682876797`*^9}, {
  3.996045241309764*^9, 3.9960452417776957`*^9}},
 CellLabel->
  "In[1410]:=",ExpressionUUID->"1660437c-a0d8-4b90-abf9-2b6bb319207c"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", "1"},
     {"1", "0"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{
  3.996043210747498*^9, 3.996043333315147*^9, 3.996043391344632*^9, 
   3.996043434496019*^9, 3.996043912987486*^9, 3.9960442874310904`*^9, 
   3.996044574124168*^9, 3.996045088190135*^9, 3.996045242126473*^9, {
   3.9960468673295803`*^9, 3.9960468798255663`*^9}, {3.9960469436119823`*^9, 
   3.996046967979663*^9}, 3.996047079506362*^9, 3.998124105781384*^9},
 CellLabel->
  "Out[1410]=",ExpressionUUID->"67259fb1-dad4-4ae9-be7f-5c40bcb82834"]
}, Open  ]],

Cell["\<\
Finally check the selected component of the pentagon. It is not an extra \
assumption: it is one small block extracted from the full solved pentagon \
system.\
\>", "Text",ExpressionUUID->"8553ccf9-9f89-4518-a3d1-698bb8a5774f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", "F", ".", "Z", ".", "F", "==", "X", 
  "]"}]], "Input",
 CellLabel->
  "In[1411]:=",ExpressionUUID->"09d14d67-f87c-4094-85b2-4a0b28d1f754"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{
  3.9960432107710867`*^9, 3.9960433333259907`*^9, 3.996043391355554*^9, 
   3.9960434345067387`*^9, 3.996043912989071*^9, 3.996044287432671*^9, 
   3.996044576211719*^9, 3.996045088196424*^9, {3.996046867344935*^9, 
   3.996046879826984*^9}, {3.996046943619638*^9, 3.996046967983121*^9}, 
   3.996047079512652*^9, 3.9981241057913218`*^9},
 CellLabel->
  "Out[1411]=",ExpressionUUID->"be8b4fc5-f36d-4ce9-ab39-f47694a8f34b"]
}, Open  ]],

Cell[TextData[{
 "Expected result: ",
 StyleBox["F",
  FontSlant->"Italic"],
 " is the Hadamard matrix, ",
 StyleBox["Z",
  FontSlant->"Italic"],
 " = diag(1,-1), ",
 StyleBox["X",
  FontSlant->"Italic"],
 " swaps the two channels, and the last command returns ",
 StyleBox["True", "Input"],
 ". The fusion ring supplies the allowed vertices, while the pentagon \
constrains the additional recoupling data.\n\nMore \
\[OpenCurlyDoubleQuote]advanced\[CloseCurlyDoubleQuote] references:\n\
\[Bullet] ",
 StyleBox["Aboumrad",
  FontSlant->"Italic"],
 " (SageMath) https://arxiv.org/abs/2212.00831\n\[Bullet] ",
 StyleBox["Anyonica",
  FontSlant->"Italic"],
 " (Mathematica package)"
}], "Text",
 CellChangeTimes->{{3.9960447553806868`*^9, 3.996044760224855*^9}, {
   3.9960451251287746`*^9, 3.9960451445066853`*^9}, 
   3.998124128376788*^9},ExpressionUUID->"8aa2df00-a4b5-4fa4-af0f-\
61a65463ff48"]
},
