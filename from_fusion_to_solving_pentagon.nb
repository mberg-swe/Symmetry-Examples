Notebook[{
Cell[TextData[StyleBox["From fusion rules to solving the pentagon identity", \
"Subsubsection"]], "Text",
 CellChangeTimes->{{3.9960432683538313`*^9, 3.996043269645293*^9}, {
  3.996047633503146*^9, 
  3.996047634375413*^9}},ExpressionUUID->"eb3d26b0-4880-4f61-8d13-\
7c20786b6007"],

Cell[TextData[{
 "This notebook starts from the (multiplicity-free) fusion rules shared by \
the Ising and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"SU", "(", "2", ")"}], "2"], TraditionalForm]],ExpressionUUID->
  "97bf44b8-840c-48c0-b540-14bb6d1f171b"],
 " fusion rings. It creates every admissible ",
 StyleBox["F",
  FontSlant->"Italic"],
 "-symbol, fixes a simple real gauge, generates (all components of) the \
pentagon identity, solves the full system, and extracts the ",
 StyleBox["F Z F = X",
  FontSlant->"Italic"],
 " block.\[LineSeparator]",
 StyleBox["References",
  FontVariations->{"Underline"->True}],
 "\[LineSeparator]\[Bullet] Simon\[CloseCurlyQuote]s book\[LineSeparator]\
\[Bullet] Bonderson\[CloseCurlyQuote]s thesis: \
https://thesis.caltech.edu/2447\[LineSeparator]Bonderson uses Mathematica, \
but gives no code. More references at the end of this notebook."
}], "Text",
 CellChangeTimes->{{3.996042901633213*^9, 3.9960429328951073`*^9}, 
   3.996043271910317*^9, {3.996044669904462*^9, 3.996044791963468*^9}, {
   3.996045158141906*^9, 3.996045184226205*^9}, {3.996047637065236*^9, 
   3.996047638621068*^9}, {3.998123921195216*^9, 
   3.99812394861423*^9}},ExpressionUUID->"a4907b0a-4658-4d7b-90de-\
bbb98fb8b424"],

Cell[TextData[{
 StyleBox["Fusion rules",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 "\[LineSeparator]The labels 1, 2, 3 correspond to the three simple sectors. \
The only input here is the fusion table."
}], "Text",
 CellChangeTimes->{{3.996042981059326*^9, 
  3.996042983902322*^9}},ExpressionUUID->"e8b7457c-e04b-4c43-b530-\
43e0995fc48e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", "]"}], " ", "//", "Quiet"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"labels", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fusion", "[", 
    RowBox[{"1", ",", "a_"}], "]"}], ":=", 
   RowBox[{"{", "a", "}"}]}], ";", " ", 
  RowBox[{
   RowBox[{"fusion", "[", 
    RowBox[{"a_", ",", "1"}], "]"}], ":=", 
   RowBox[{"{", "a", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fusion", "[", 
    RowBox[{"2", ",", "2"}], "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}]}], ";", " ", 
  RowBox[{
   RowBox[{"fusion", "[", 
    RowBox[{"2", ",", "3"}], "]"}], "=", 
   RowBox[{"{", "2", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fusion", "[", 
    RowBox[{"3", ",", "2"}], "]"}], "=", 
   RowBox[{"{", "2", "}"}]}], ";", " ", 
  RowBox[{
   RowBox[{"fusion", "[", 
    RowBox[{"3", ",", "3"}], "]"}], "=", 
   RowBox[{"{", "1", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"allowedQ", "[", 
    RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
   RowBox[{"MemberQ", "[", 
    RowBox[{
     RowBox[{"fusion", "[", 
      RowBox[{"a", ",", "b"}], "]"}], ",", "c"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.996043003704391*^9, {3.996043377875675*^9, 3.996043384032736*^9}, {
   3.996044808852714*^9, 3.996044812672885*^9}},
 CellLabel->
  "In[1381]:=",ExpressionUUID->"0be4935e-8f09-4d1d-a16c-5f97d8f9fe40"],

Cell["A quick sanity check: 2 x 2 has the two channels 1 and 3.", "Text",ExpressionUUID->"d1abfd0e-a830-4a2f-9ed7-55415252636f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fusion", "[", "2", ",", "2", "]"}]], "Input",
 CellLabel->
  "In[1387]:=",ExpressionUUID->"cf8345a9-b221-4ec2-8acc-ae74a6eef29e"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"1", ",", "3"}], "}"}], TraditionalForm]], "Output",
