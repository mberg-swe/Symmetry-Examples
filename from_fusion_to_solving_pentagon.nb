   3.9960469678748207`*^9}, 3.996047079406142*^9, 3.998124105550374*^9},
 CellLabel->
  "Out[1387]=",ExpressionUUID->"f2945f8a-a915-4b15-97c9-b0076737b038"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Admissible F-symbols",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 "\[LineSeparator]Write ",
 StyleBox["f[a,b,c,d,e,f]", "Input"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["F", "d"]}], TraditionalForm]],ExpressionUUID->
  "41ff88f4-185e-4b28-9aa8-ebad849e5121"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["", 
    StyleBox["abc",
     FontSlant->"Italic"]], TraditionalForm]],ExpressionUUID->
  "70f06486-3f6f-4af0-b751-25a8682aff83"],
 ")",
 Cell[BoxData[
  FormBox[
   SubscriptBox["", 
    StyleBox["ef",
     FontSlant->"Italic"]], TraditionalForm]],ExpressionUUID->
  "82b5f591-25eb-49a4-b89f-29399cf16330"],
 " .  It relates the combination ((",
 StyleBox["a",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"b", ")"}], "e"], TraditionalForm]],ExpressionUUID->
  "1b98f424-0a65-47c3-8a13-d80e302799ce"],
 " ",
 StyleBox["c",
  FontSlant->"Italic"],
 ")",
 Cell[BoxData[
  FormBox[
   SubscriptBox["", "d"], TraditionalForm]],ExpressionUUID->
  "ad20be42-54d8-419e-9285-d859a837838e"],
 " to the combination (",
 StyleBox["a",
  FontSlant->"Italic"],
 " (",
 StyleBox["b ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"c", ")"}], "f"], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "debbbcd2-a9e6-4423-ac5b-3166ada10f43"],
 " f)",
 Cell[BoxData[
  FormBox[
   SubscriptBox["", "d"], TraditionalForm]],ExpressionUUID->
  "542042f1-8d0a-4bfd-8599-3d0f661494ee"],
 ". An entry makes sense (is admissible) only when both fusion trees are \
allowed."
}], "Text",
 CellChangeTimes->{{3.996043029697953*^9, 3.996043159111561*^9}, {
  3.996047657720037*^9, 3.996047658711837*^9}, {3.9981239575629663`*^9, 
  3.9981239975504704`*^9}},ExpressionUUID->"0558d475-6e5b-4ef1-85a4-\
b95c0fcacfd4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"admissibleFQ", "[", 
    RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_", ",", "e_", ",", "f_"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allowedQ", "[", 
     RowBox[{"a", ",", "b", ",", "e"}], "]"}], "\[And]", 
    RowBox[{"allowedQ", "[", 
     RowBox[{"e", ",", "c", ",", "d"}], "]"}], "\[And]", 
    RowBox[{"allowedQ", "[", 
     RowBox[{"b", ",", "c", ",", "f"}], "]"}], "\[And]", 
    RowBox[{"allowedQ", "[", 
     RowBox[{"a", ",", "f", ",", "d"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fName", "[", 
    RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_", ",", "e_", ",", "f_"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Symbol", "[", 
    RowBox[{"\"\<f\>\"", "<>", 
     RowBox[{"StringJoin", "[", 
      RowBox[{"Map", "[", 
       RowBox[{"ToString", ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], 
         "}"}]}], "]"}], "]"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.996043128271195*^9, 3.996043131233605*^9}, {
  3.996043175091181*^9, 3.996043203526005*^9}, {3.9960438962476387`*^9, 
  3.996043901522196*^9}},
 CellLabel->
  "In[1388]:=",ExpressionUUID->"56d5666a-5dbb-44ad-86c3-7ef0ab5df9bb"],

Cell["\<\
First fix the standard unit gauge: inadmissible entries are zero, while an \
associator involving the vacuum 1 is set to 1. All other admissible entries \
remain independent real unknowns.\
\>", "Text",ExpressionUUID->"d9ebbdef-8b60-4cc2-99ea-1ece18b2a0ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Fsymbol", "[", 
    RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_", ",", "e_", ",", "f_"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"!", 
      RowBox[{"admissibleFQ", "[", 
       RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], 
       "]"}]}], ",", "0", ",", 
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", "1"}], "]"}], ",", "1",
      ",", "True", ",", 
     RowBox[{"fName", "[", 
      RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.996043431388892*^9, {3.996043905280439*^9, 3.996043909536997*^9}, {
   3.996044849020075*^9, 3.99604485372508*^9}, 3.996047676529104*^9},
 CellLabel->
  "In[1390]:=",ExpressionUUID->"a9196d63-d4c2-42bf-bd6b-908bcd48b487"],

Cell["\<\
(Here the symbol \[OpenCurlyDoubleQuote]!\[CloseCurlyDoubleQuote] stands for \
\[OpenCurlyDoubleQuote]not\[CloseCurlyDoubleQuote])\[LineSeparator]Enumerate \
all remaining unknown F-symbols:\
\>", "Text",
 CellChangeTimes->{{3.99604486140093*^9, 3.9960448755043173`*^9}, {
  3.998124017794112*^9, 
  3.998124030392336*^9}},ExpressionUUID->"e9027aa7-5e23-4eaa-9ab5-\
2a57a8d6c269"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"admissibleNonUnitTupleQ", "[", "t_List", "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"admissibleFQ", "[", 
    RowBox[{
     RowBox[{"t", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", 
     RowBox[{"t", "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", 
     RowBox[{"t", "[", 
      RowBox[{"[", "3", "]"}], "]"}], ",", 
     RowBox[{"t", "[", 
      RowBox[{"[", "4", "]"}], "]"}], ",", 
     RowBox[{"t", "[", 
      RowBox[{"[", "5", "]"}], "]"}], ",", 
     RowBox[{"t", "[", 
      RowBox[{"[", "6", "]"}], "]"}]}], "]"}], "\[And]", 
   "\[IndentingNewLine]", 
   RowBox[{"FreeQ", "[", 
    RowBox[{
     RowBox[{"Take", "[", 
      RowBox[{"t", ",", "3"}], "]"}], ",", "1"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fVariableFromTuple", "[", "t_List", "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"fName", "[", 
   RowBox[{
    RowBox[{"t", "[", 
     RowBox[{"[", "1", "]"}], "]"}], ",", 
    RowBox[{"t", "[", 
     RowBox[{"[", "2", "]"}], "]"}], ",", 
    RowBox[{"t", "[", 
     RowBox[{"[", "3", "]"}], "]"}], ",", 
    RowBox[{"t", "[", 
     RowBox[{"[", "4", "]"}], "]"}], ",", 
    RowBox[{"t", "[", 
     RowBox[{"[", "5", "]"}], "]"}], ",", 
    RowBox[{"t", "[", 
     RowBox[{"[", "6", "]"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"unknownTuples", "=", 
  RowBox[{"Select", "[", 
   RowBox[{
    RowBox[{"Tuples", "[", 
     RowBox[{"labels", ",", "6"}], "]"}], ",", "admissibleNonUnitTupleQ"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"unknowns", "=", 
  RowBox[{"Map", "[", 
   RowBox[{"fVariableFromTuple", ",", "unknownTuples"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "unknowns", "]"}]}], "Input",
 CellChangeTimes->{{3.996043220267404*^9, 3.99604324216608*^9}, {
  3.996043493215708*^9, 3.9960435006783133`*^9}, {3.996043771346078*^9, 
