Cell[TextData[{
 StyleBox["Fix the residual real gauge",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 "\[LineSeparator]The one-dimensional fusion vertices still have basis \
freedom. We choose three convenient real conventions below. These are ",
 StyleBox["gauge choices",
  FontSlant->"Italic"],
 ", not consequences of the pentagon. "
}], "Text",
 CellChangeTimes->{{3.996044212991407*^9, 3.9960442139327097`*^9}, {
  3.9960450274047318`*^9, 
  3.9960450295711184`*^9}},ExpressionUUID->"d5df2453-b100-4b05-8e99-\
3431d4f331b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gaugeEquations", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"fName", "[", 
       RowBox[{"2", ",", "3", ",", "2", ",", "3", ",", "2", ",", "2"}], "]"}],
       "==", 
      RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"fName", "[", 
       RowBox[{"3", ",", "2", ",", "2", ",", "3", ",", "2", ",", "1"}], "]"}],
       "==", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"fName", "[", 
       RowBox[{"3", ",", "3", ",", "2", ",", "2", ",", "1", ",", "2"}], "]"}],
       "==", "1"}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellLabel->
  "In[1401]:=",ExpressionUUID->"1153667c-201d-4a24-83cf-4db14a57c44a"],

Cell[TextData[{
 StyleBox["Solve all pentagons\[LineSeparator]",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 "Solve the full polynomial system over the reals. In this gauge Mathematica \
finds two discrete coherent solutions.\n\nDisplay all 14 solved entries for \
either branch. The two branches differ in the sign of the nontrivial \
F^{222}_2 block."
}], "Text",
 CellChangeTimes->{{3.9960442288405027`*^9, 3.996044229313957*^9}, {
  3.996044503533655*^9, 
