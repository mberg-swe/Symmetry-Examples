Notebook[{
Cell[TextData[StyleBox["From arithmetic to groups and algebras", \
"Subsubsection"]], "Text",
 CellChangeTimes->{{4.000869389226603*^9, 
  4.000869392820512*^9}},ExpressionUUID->"ee277c85-991e-4dee-9040-\
58b6584a0758"],

Cell[TextData[{
 StyleBox["If you are not used to Mathematica",
  FontSlant->"Italic"],
 ": evaluate one input cell at a time, from top to bottom, with Shift+Enter. \
\[LineSeparator]You can read the outputs below first, and then try evaluating \
each cell yourself (Shift+Enter). \n\n",
 StyleBox["Arithmetic",
  FontSlant->"Italic"],
 " is the familiar system of rules for combining numbers by operations such \
as addition and multiplication that you learned in school, from Greek \
\[OpenCurlyDoubleQuote]",
 StyleBox["arithmetike tekhne\[CloseCurlyDoubleQuote]",
  FontSlant->"Italic"],
 ", meaning \[OpenCurlyDoubleQuote]",
 StyleBox["the art of counting\[CloseCurlyDoubleQuote]",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{4.000869429755928*^9, 4.0008694876134577`*^9}, {
  4.0008712936287737`*^9, 4.000871311600163*^9}, {4.000877387459517*^9, 
  4.000877389524963*^9}, {4.0008774340114937`*^9, 
  4.000877498648641*^9}},ExpressionUUID->"6a271cd6-b694-440d-970f-\
0b271de75d86"],

Cell[TextData[StyleBox["1. Two familiar operations",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{4.000869405395198*^9, 
  4.0008694067016582`*^9}},ExpressionUUID->"c9ea6ba9-35d2-4816-82f6-\
6b14a4923f79"],

Cell["Addition combines numbers: 2 + 3 = 5. ", "Text",
 CellChangeTimes->{{4.0008695274753513`*^9, 4.000869597588459*^9}, 
   4.000871324129594*^9},ExpressionUUID->"3a3f94f8-c36a-4a38-b8cd-\
2b727a14cb4e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"2", "+", "3"}]], "Input",
 CellLabel->
  "In[4071]:=",ExpressionUUID->"b9ba4ffe-74fe-479a-bc9f-396eddd84594"],

Cell[BoxData[
 FormBox["5", TraditionalForm]], "Output",
 CellChangeTimes->{4.0008725985053473`*^9},
 CellLabel->
  "Out[4071]=",ExpressionUUID->"df690362-d76f-4a98-9be2-94212a1421a6"]
}, Open  ]],

Cell["\<\
In Mathematica, we usually write multiplication with a space, which is shown \
as a grayed-out cross \[OpenCurlyDoubleQuote]\[Cross]\[CloseCurlyDoubleQuote]:\
\>", "Text",
 CellChangeTimes->{{4.000871325309804*^9, 4.0008713282557163`*^9}, {
  4.000877517051062*^9, 
  4.000877517796472*^9}},ExpressionUUID->"bc49ac94-c893-4a0b-beef-\
06c6e5bf81cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"2", " ", "3"}]], "Input",
 CellLabel->
  "In[4072]:=",ExpressionUUID->"86cc9ccb-d3de-420b-ae1a-e8f685ec6905"],

Cell[BoxData[
 FormBox["6", TraditionalForm]], "Output",
 CellChangeTimes->{4.000872598537521*^9},
 CellLabel->
  "Out[4072]=",ExpressionUUID->"5be6b709-e88d-44b9-ac09-59462e1490e0"]
}, Open  ]],

Cell[TextData[{
 "Multiplication can also be written \[OpenCurlyDoubleQuote]\[Star]\
\[CloseCurlyDoubleQuote], it\[CloseCurlyQuote]s the same as the above (try \
exchanging the symbol). \n\nAn ",
 StyleBox["identity operation",
  FontSlant->"Italic"],
 ", like an identity matrix, is the operation that does nothing.\
\[LineSeparator]For addition, identity is addition by 0. For multiplication, \
identity is multiplying by 1. Note that these two identity operations are \
different in detail."
}], "Text",
 CellChangeTimes->{{4.0008696094066057`*^9, 4.0008696818808737`*^9}, {
  4.000869768761874*^9, 4.000869810842045*^9}, {4.000877520939472*^9, 
  4.000877550108643*^9}},ExpressionUUID->"5d6729e5-2087-445e-9a13-\
1a0050191ac0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"0", "+", "7"}], ",", 
   RowBox[{"1", " ", "7"}]}], "}"}]], "Input",
 CellLabel->
  "In[4073]:=",ExpressionUUID->"2b01608d-42d2-490a-8e33-8eb8dc709ec6"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"7", ",", "7"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.000872598541045*^9},
 CellLabel->
  "Out[4073]=",ExpressionUUID->"a8bad121-62e5-4372-8d04-bc094f16faaa"]
}, Open  ]],

Cell[TextData[{
 "Here { } denotes a \[OpenCurlyDoubleQuote]list\[CloseCurlyDoubleQuote]: as \
it sounds, a list of objects with no additional structure. For now, think of \
a list as a \[OpenCurlyDoubleQuote]computer science thing\
\[CloseCurlyDoubleQuote], not a physics thing in itself. (Later, we will \
actually ascribe some more meaning to lists.)\n\nIf you\[CloseCurlyQuote]re \
not used to Mathematica, try replacing \[OpenCurlyDoubleQuote]7\
\[CloseCurlyDoubleQuote] above with another integer, and run that cell again \
(Shift+Enter) to get started experimenting. \n\nAn ",
 StyleBox["inverse operation",
  FontSlant->"Italic"],
 ", like an inverse matrix, reverses an operation, i.e. performs it \
backwards. An additive inverse of 3 is ",
 StyleBox["\[Dash]",
  FontSize->14],
 "3 because their sum is 0:"
}], "Text",
 CellChangeTimes->{{4.00086949485257*^9, 4.000869495981729*^9}, {
  4.00086968481918*^9, 4.0008698308383102`*^9}, {4.000871344505518*^9, 
  4.000871493640215*^9}, {4.000877562770597*^9, 
  4.000877624663931*^9}},ExpressionUUID->"220d8aec-2fe5-443c-b83c-\
c97b7673ffa6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"3", "-", "3"}]], "Input",
 CellLabel->
  "In[4074]:=",ExpressionUUID->"1f2d5977-fe00-49cc-8819-985480570551"],

Cell[BoxData[
 FormBox["0", TraditionalForm]], "Output",
 CellChangeTimes->{4.000872598549116*^9},
 CellLabel->
  "Out[4074]=",ExpressionUUID->"a6abcc36-3755-4cb0-b4d9-510b4e4f883a"]
}, Open  ]],

Cell["\<\
A multiplicative inverse of 3 is 1/3 because their product is 1:\
\>", "Text",
 CellChangeTimes->{{4.00087760783346*^9, 
  4.000877622032215*^9}},ExpressionUUID->"29061a8a-52fd-4b88-91f1-\
16e21a7c7784"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"3", "/", "3"}]], "Input",
 CellChangeTimes->{{4.0008776285483017`*^9, 4.000877629526154*^9}},
 CellLabel->
  "In[4104]:=",ExpressionUUID->"ea3c854d-9168-4d71-b754-5409424694af"],

Cell[BoxData[
 FormBox["1", TraditionalForm]], "Output",
 CellChangeTimes->{4.000872598556737*^9, 4.000877629753302*^9},
 CellLabel->
  "Out[4104]=",ExpressionUUID->"3fc55687-7222-4b78-911e-a8607667e9fc"]
}, Open  ]],

Cell[TextData[{
 "Note that again, the details of the two inverse operations are quite \
different.\n\nIn Mathematica (as in many programming languages), the symbol \
== is a ",
 StyleBox["test",
  FontSlant->"Italic"],
 " whether two expressions are equal, whereas a single = is ",
 StyleBox["assignment",
  FontSlant->"Italic"],
 ", i.e. assigns a name to a value. \nThe next cells use the \
\[OpenCurlyDoubleQuote]equal test\[CloseCurlyDoubleQuote] == to compare two \
ways to put parentheses:"
}], "Text",
 CellChangeTimes->{{4.0008698377547817`*^9, 4.00086991946012*^9}, {
  4.000877613346155*^9, 4.0008776142200537`*^9}, {4.0008776461968727`*^9, 
  4.000877655614045*^9}},ExpressionUUID->"3e8c4f23-093c-482f-9261-\
f1218e02623a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"associativityTest", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "+", "3"}], ")"}], "+", "4"}], "\[Equal]", 
     RowBox[{"2", "+", 
      RowBox[{"(", 
       RowBox[{"3", "+", "4"}], ")"}]}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", " ", "3"}], ")"}], " ", "4"}], "\[Equal]", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{"3", " ", "4"}], ")"}]}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{4.000870119405966*^9, 4.0008701234318447`*^9}},
 CellLabel->
  "In[4076]:=",ExpressionUUID->"47944c0f-ffc9-4f17-b58c-af16f7b48639"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"True", ",", "True"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.000870123877694*^9, 4.0008725985651207`*^9},
 CellLabel->
  "Out[4076]=",ExpressionUUID->"056a668b-5d87-4636-8102-3257e7b9301b"]
}, Open  ]],

Cell["and two ways to order the objects: ", "Text",
 CellChangeTimes->{{4.0008776566829*^9, 
  4.000877666111616*^9}},ExpressionUUID->"f5119514-b09b-4941-9024-\
f36f00aef9e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"commutativityTest", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"2", "+", "3"}], "\[Equal]", 
     RowBox[{"3", "+", "2"}]}], ",", 
    RowBox[{
     RowBox[{"2", " ", "3"}], "\[Equal]", 
     RowBox[{"3", " ", "2"}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{4.000870124887783*^9, 4.0008701282994223`*^9}},
 CellLabel->
  "In[4077]:=",ExpressionUUID->"6a5e1ed7-12ad-4334-b910-a436afff3b23"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"True", ",", "True"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.00087012867502*^9, 4.000872598576551*^9},
 CellLabel->
  "Out[4077]=",ExpressionUUID->"180d46f6-a8d9-4563-92e4-05990ee545af"]
}, Open  ]],

Cell[TextData[{
 "The first pair tests ",
 StyleBox["associativity",
  FontWeight->"Bold"],
 ": moving parentheses. The second tests ",
 StyleBox["commutativity",
  FontWeight->"Bold"],
 ": swapping order. \n\nBoth properties are true for ordinary numbers. But \
they don\[CloseCurlyQuote]t always hold, i.e. for other objects than ordinary \
numbers. You should be familiar with the non-commutativity of matrices. \
Non-associativity is probably less familiar. \nAlso keep in mind that \
examples illustrate a law, but of course don\[CloseCurlyQuote]t prove it for \
every number. We will typically not prove statements like the above in \
general, but invite you to try examples to get a feeling. Proofs would be \
discussed in courses in \[OpenCurlyDoubleQuote]abstract algebra\
\[CloseCurlyDoubleQuote] (at KaU, the course ",
 StyleBox["Algebraiska strukturer",
  FontSlant->"Italic"],
 "), which typical physics students never take. "
}], "Text",
 CellChangeTimes->{{4.000869922802023*^9, 4.000870016073697*^9}, {
  4.000870060528908*^9, 4.0008701021947193`*^9}, {4.000870136417254*^9, 
  4.000870221288307*^9}, {4.000877678788612*^9, 
  4.000877751680173*^9}},ExpressionUUID->"26e5cc4c-5c9d-4f83-b90e-\
6ae5de33b04a"],

Cell[TextData[StyleBox["2a. The chosen set matters",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{4.000870225580888*^9, 4.0008702267105417`*^9}, 
   4.0008704509925823`*^9},ExpressionUUID->"54274751-ff18-4971-9209-\
8e02096d81fb"],

Cell[TextData[{
 "A set is a \[OpenCurlyDoubleQuote]collection of allowed values\
\[CloseCurlyDoubleQuote]. An operation is ",
 StyleBox["closed",
  FontSlant->"Italic"],
 " on a set when applying it to two allowed values always gives another \
allowed value. To call a set with an operation a ",
 StyleBox["group",
  FontWeight->"Bold"],
 ", we also need an ",
 StyleBox["identity",
  FontWeight->"Bold"],
 ", an inverse inside the set for every member, and associativity. (Note that \
commutativity is an ",
 StyleBox["additional",
  FontSlant->"Italic"],
 " requirement, not part of the group requirement.)"
}], "Text",
 CellChangeTimes->{{4.0008702475907097`*^9, 4.0008702799096937`*^9}, {
  4.000877761114952*^9, 
  4.0008777816404953`*^9}},ExpressionUUID->"375de0df-aea7-4323-ba32-\
8baafecbd837"],

Cell[TextData[{
 "For addition, the integers ",
 Cell[BoxData[
 "\[DoubleStruckCapitalZ]"], "InlineFormula",ExpressionUUID->
  "9a08915e-d9ed-4802-82e2-8f60b9b61cde"],
 " form a group: sums of integers stay integer, 0 is the identity, and every \
integer has a negative. For multiplication, the integers have no inverse: for \
example, the inverse of 2 is 1/2, not an integer. \nOn the other hand, the \
nonzero rational numbers ",
 Cell[BoxData[
  SuperscriptBox["\[DoubleStruckCapitalQ]", "\[Times]"]], "InlineFormula",
  ExpressionUUID->"314fa1fc-4102-43ac-95ac-1cfb6492574b"],
 " do form a group under multiplication. We exclude 0 because no number \
multiplied by 0 gives 1."
}], "Text",
 CellChangeTimes->{{4.000870292994598*^9, 4.000870310773797*^9}, {
  4.000870350808667*^9, 
  4.000870397649105*^9}},ExpressionUUID->"f0412def-ced6-47fe-891f-\
0388bde3d33f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"2", "-", "2"}], ",", 
   FractionBox["2", "2"]}], "}"}]], "Input",
 CellLabel->
  "In[4078]:=",ExpressionUUID->"b2dbf298-31a9-4dbe-919c-b94989929059"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"0", ",", "1"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.000872598589385*^9},
 CellLabel->
  "Out[4078]=",ExpressionUUID->"bc4a88fe-e808-4fa1-87b7-e37a0e9dbc92"]
}, Open  ]],

Cell["\<\
Both calculations reach the identity appropriate to their operation. But \
again, 1/2 is outside the integers, so it cannot serve as a multiplicative \
inverse there. Multiplication by 0 always gives 0. Changing the number we \
multiply by cannot make 1.\
\>", "Text",
 CellChangeTimes->{{4.000870344601647*^9, 4.000870345870751*^9}, {
  4.000870407408074*^9, 
  4.000870421294156*^9}},ExpressionUUID->"27544439-f3b5-42a3-9c90-\
c4d9a210a2b3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"0", " ", "2"}], ",", 
   FractionBox["0", "2"], ",", 
   RowBox[{"0", " ", "100"}]}], "}"}]], "Input",
 CellLabel->
  "In[4079]:=",ExpressionUUID->"e9d0821b-2888-4213-ac25-8ad42f9cd79c"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"0", ",", "0", ",", "0"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0008725986036997`*^9},
 CellLabel->
  "Out[4079]=",ExpressionUUID->"99f211f3-454c-4196-b574-84c47f007e18"]
}, Open  ]],

Cell[TextData[StyleBox["2b. Two very small examples",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{4.000870427392088*^9, 4.000870449309935*^9}, {
  4.000870557563507*^9, 
  4.000870561378422*^9}},ExpressionUUID->"aabeccef-f1d7-4cf2-82ed-\
5bf0c7ab5860"],

Cell["\<\
Example: choose just the set {\[Dash]1, 1} and multiplication. Its four \
possible products are shown in the order (-1)\[CenterDot](-1), (-1)\
\[CenterDot]1, 1\[CenterDot](-1), 1 \[CenterDot] 1. Every answer is still in \
the set. The identity is 1, and each member is its own inverse.\
\>", "Text",
 CellChangeTimes->{{4.0008704563383017`*^9, 4.0008705292654467`*^9}, {
  4.000870565413711*^9, 4.000870569276002*^9}, {4.000873818120399*^9, 
  4.000873822007041*^9}},ExpressionUUID->"7a57260a-1163-4423-934a-\
6eb29983f1f2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}]}], ",", 
   RowBox[{"-", "1"}], ",", 
   RowBox[{"1", " ", 
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}]}], ",", 
   RowBox[{"1", " ", "1"}]}], "}"}]], "Input",
 CellLabel->
  "In[4080]:=",ExpressionUUID->"e145a26b-1ebf-4af1-acb4-4915a73483a8"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"1", ",", 
    RowBox[{"-", "1"}], ",", 
    RowBox[{"-", "1"}], ",", "1"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.000872598619794*^9},
 CellLabel->
  "Out[4080]=",ExpressionUUID->"0efb9e0a-9974-4b1d-a3d7-3f2faa55e644"]
}, Open  ]],

Cell["\<\
Example: {0,1} with addition is not closed: 1+1 leaves that set. \
\>", "Text",
 CellChangeTimes->{{4.000870572071105*^9, 4.000870575973363*^9}, 
   4.000873776854147*^9, 
   4.000873827628088*^9},ExpressionUUID->"67929f0c-14fe-464b-886d-\
a5a77ca67df0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"0", "+", "1"}], ",", 
   RowBox[{"1", "+", "1"}]}], "}"}]], "Input",
 CellLabel->
  "In[4081]:=",ExpressionUUID->"57532b3a-1110-4f59-b64e-3b105095ceb3"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"1", ",", "2"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.000872598630653*^9},
 CellLabel->
  "Out[4081]=",ExpressionUUID->"bad61931-1d20-49f0-93c4-a7f9306b6e41"]
}, Open  ]],

Cell[TextData[StyleBox["3. Preparation for lecture 3: small matrices",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{4.000870589045597*^9, 4.00087059419482*^9}, 
   4.000871522334353*^9},ExpressionUUID->"cbb47e48-291f-4d82-ab6a-\
0009619ff97a"],

Cell[TextData[{
 "Although we shouldn\[CloseCurlyQuote]t look forward ",
 StyleBox["too",
  FontSlant->"Italic"],
 " much, the following can help to understand the point of the discussion of \
arithmetic above, that might have seemed very boring. You are already \
familiar with the generalization of ordinary numbers to matrices. But maybe \
you haven\[CloseCurlyQuote]t thought very much about the choices that were \
made in this generalization. Thinking about those choices might help us see \
what ",
 StyleBox["other kinds of generalizations could be interesting",
  FontWeight->"Bold"],
 ", than specifically going from numbers to matrices (that you already know).\
\n\nConsider 2\[Times]2 matrices. Here ",
 StyleBox["\[OpenCurlyDoubleQuote]id\[CloseCurlyDoubleQuote]",
  FontSlant->"Italic"],
 " is the identity matrix (capital I in Mathematica is reserved for the \
imaginary unit), ",
 StyleBox["x",
  FontSlant->"Italic"],
 " swaps the two coordinate positions (as the Pauli matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "x"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "817e4de7-a970-4650-a8c7-6477cbd3925a"],
 "), and ",
 StyleBox["z ",
  FontSlant->"Italic"],
 "changes the sign of the second (as the Pauli matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "z"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "831460f4-5b84-4740-8d5b-5867069cf79a"],
 "). A matrix is stored as a list of lists . (The semicolon \
\[OpenCurlyDoubleQuote];\[CloseCurlyDoubleQuote] below separates assignments \
and hides their immediate output.)"
}], "Text",
 CellChangeTimes->{{4.0008706085011787`*^9, 4.000870734822405*^9}, {
  4.0008715185909023`*^9, 4.000871539021913*^9}, {4.000872173182797*^9, 
  4.0008723930717793`*^9}, {4.000876412159317*^9, 4.000876448896789*^9}, {
  4.000877811899152*^9, 
  4.000877840228404*^9}},ExpressionUUID->"60d81792-63b4-4467-ba91-\
a9954d8a7b37"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"id", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"x", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"z", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"-", "1"}]}], "}"}]}], "}"}]}]}], "Input",
 CellChangeTimes->{{4.0008723998092337`*^9, 4.0008724107125263`*^9}},
 CellLabel->
  "In[4082]:=",ExpressionUUID->"796971ce-fc8a-47b0-8fcc-12c86a6e0d38"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"1", "0"},
     {"0", "1"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{
  4.0008707379415693`*^9, {4.000872401488441*^9, 4.000872411057342*^9}, 
   4.000872598674752*^9},
 CellLabel->
  "Out[4082]=",ExpressionUUID->"32364148-977d-4c65-8ee5-0019848f45fd"],

Cell[BoxData[
 FormBox[
