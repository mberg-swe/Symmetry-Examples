Cell[TextData[{
 "Note the assignment of the grouping of the list of lists as rows vs. \
columns.\nAs you know, ",
 StyleBox["matrix addition",
  FontSlant->"Italic"],
 " adds the corresponding entries of each matrix:"
}], "Text",
 CellChangeTimes->{{4.000870756170558*^9, 4.000870789056518*^9}, {
  4.0008724164644403`*^9, 
  4.0008724551025953`*^9}},ExpressionUUID->"29de087a-fdfe-44c5-aced-\
bc72800afec9"],

