}, Open  ]],

Cell["\<\
The product of two lists, unlike matrix multiplication, works entry by entry:\
\
\>", "Text",
 CellChangeTimes->{{4.0008726127795773`*^9, 4.000872625662549*^9}, {
  4.000872719800596*^9, 4.00087272387566*^9}, {4.0008765515423727`*^9, 
  4.000876558409286*^9}},ExpressionUUID->"6a0c5652-d5e7-4365-83c9-\
1df24554a9b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"a", ",", "b"}], "}"}], "*", 
  RowBox[{"{", 
   RowBox[{"c", ",", "d"}], "}"}]}]], "Input",
 CellChangeTimes->{{4.000872615653672*^9, 4.00087262166621*^9}, {
  4.000872682456602*^9, 4.0008726842468567`*^9}, {4.0008747661684504`*^9, 
  4.000874767672797*^9}},
 CellLabel->
  "In[4101]:=",ExpressionUUID->"4e4769ea-c10f-4a3c-b775-d9916b0ed233"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"a", " ", "c"}], ",", 
    RowBox[{"b", " ", "d"}]}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0008726221705503`*^9, 4.000872684740995*^9, 
  4.000874775151582*^9},
 CellLabel->
  "Out[4101]=",ExpressionUUID->"aa296485-914a-4a2e-b19a-0a8d0ec4925f"]
}, Open  ]],

Cell[TextData[{
 "If you think Mathematica is crazy for making this choice for the meaning of \
\[OpenCurlyDoubleQuote]\[Star]\[CloseCurlyDoubleQuote], because you think \
matrix multiplication is more important than multiplication of lists, you \
would be missing the point: it is useful to have ",
 StyleBox["both",
  FontSlant->"Italic"],
 " of these operations available. (In Python, there are much crazier, and \
also useful, choices like this!) In particular: ",
 StyleBox["conventional matrix multiplication is a choice",
  FontWeight->"Bold"],
 ". \n\nAs you know, matrix multiplication is not commutative, in general. \
The order of x and z matters, i.e. they don\[CloseCurlyQuote]t commute. As \
above, the test \[OpenCurlyDoubleQuote]==\[CloseCurlyDoubleQuote] reports \
whether each claim holds."
}], "Text",
 CellChangeTimes->{{4.0008709141235027`*^9, 4.0008711475071783`*^9}, {
  4.000872612198345*^9, 4.0008726586334*^9}, {4.000872692945874*^9, 
  4.000872768911236*^9}, {4.000874667908619*^9, 4.000874722585887*^9}, {
  4.000876568670327*^9, 
  4.00087657064506*^9}},ExpressionUUID->"c62be642-294a-4bd8-890f-\
57a8eeabcb69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"x", ".", "z"}], "\[Equal]", 
  RowBox[{"z", ".", "x"}]}]], "Input",
 CellChangeTimes->{
  4.000872777288394*^9, {4.0008728110549307`*^9, 4.000872812224525*^9}},
 CellLabel->
  "In[4097]:=",ExpressionUUID->"8422755a-db6b-4baf-826f-39cb34d1def7"],

Cell[BoxData[
 FormBox["False", TraditionalForm]], "Output",
 CellChangeTimes->{4.000872598755712*^9, 4.000872812615994*^9},
 CellLabel->
  "Out[4097]=",ExpressionUUID->"b0839efe-339c-4181-a9ad-b37239c8f418"]
}, Open  ]],

Cell["\<\
(With the other meaning of multiplication of lists above, clearly it is \
commutative)\
\>", "Text",
 CellChangeTimes->{{4.000874735519677*^9, 4.000874749462965*^9}, {
  4.000874792017363*^9, 4.000874797500277*^9}, {4.000876599931995*^9, 
  4.000876601586297*^9}},ExpressionUUID->"fac0a9b8-b559-45e3-b4e5-\
671ad53557b8"],

