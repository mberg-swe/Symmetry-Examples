 CellChangeTimes->{4.0008725987367*^9},
 CellLabel->
  "Out[4087]=",ExpressionUUID->"d821e7c4-40a9-4638-99ef-40be0c1d8d44"]
}, Open  ]],

Cell[TextData[{
 "But now, contrast ordinary multiplication (\[OpenCurlyDoubleQuote]\[Star]\
\[CloseCurlyDoubleQuote] in Mathematica, or just the \
\[OpenCurlyDoubleQuote]space\[CloseCurlyDoubleQuote] key), which is ",
 StyleBox["not",
  FontSlant->"Italic"],
 " matrix multiplication, but the product of two lists:"
}], "Text",
 CellChangeTimes->{{4.000870898081839*^9, 4.000870912271282*^9}, {
  4.000871016379306*^9, 4.000871035385601*^9}, {4.000872575597375*^9, 
  4.000872585990197*^9}, {4.0008726695631943`*^9, 4.000872674887321*^9}, {
  4.000876525719162*^9, 
  4.000876543266533*^9}},ExpressionUUID->"371b6fe2-bd08-43b5-8054-\
450a0a185d25"],

