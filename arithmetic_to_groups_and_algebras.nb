Cell[BoxData[
 RowBox[{
  RowBox[{"x", "*", "z"}], " ", "==", " ", 
  RowBox[{"z", "*", "x"}]}]], "Input",
 CellChangeTimes->{{4.000874729110413*^9, 4.000874731471983*^9}, {
  4.000874784436409*^9, 4.0008747897373343`*^9}},
 CellLabel->
  "In[4102]:=",ExpressionUUID->"7db918ea-cc69-4aaa-af09-c9678097105d"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.000874731879579*^9, 4.000874790253343*^9},
 CellLabel->
  "Out[4102]=",ExpressionUUID->"b9915863-7bac-4f9d-91f4-e021d9ef674e"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Distributivity",
  FontSlant->"Italic"],
 " connects addition and multiplication, here matrix multiplication. The next \
equality says that multiplying a sum by ",
 StyleBox["z",
  FontSlant->"Italic"],
 " on the right gives the same result as multiplying each summand by Z and \
adding."
}], "Text",
 CellChangeTimes->{{4.000871162358397*^9, 
  4.000871175165103*^9}},ExpressionUUID->"eb7791e7-5a72-46b2-9d85-\
1e360ca5880a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"id", "+", "x"}], ")"}], ".", "z"}], "\[Equal]", 
  RowBox[{"z", "+", 
   RowBox[{"x", ".", "z"}]}]}]], "Input",
 CellLabel->
  "In[4090]:=",ExpressionUUID->"058cbe5e-9952-4c05-86df-4d467c9043b7"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.0008725987648773`*^9},
 CellLabel->
  "Out[4090]=",ExpressionUUID->"02b58680-ee24-4f61-9872-e500b8e637a1"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Groups and algebras: transformations and linear combinations",
  FontWeight->"Bold"],
 "\n\nInspired by matrices, we can now see at least two different \
generalizations of ordinary arithmetic, that have names.\n\nA ",
 StyleBox["group",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " essentially uses the idea of multiplication but leaves out addition. \
Operations can be combined (multiplied), there is an identity, and every \
operation can be undone (has an inverse). An example is rotations. If we \
first rotate something and then rotate it again, the two rotations compose to \
give another rotation. Every rotation can also be undone. But \
\[OpenCurlyDoubleQuote]linear combination\[CloseCurlyDoubleQuote] of \
rotations is not defined. It would be like performing several ",
 StyleBox["different",
  FontSlant->"Italic"],
 " rotations ",
 StyleBox["simultaneously",
  FontSlant->"Italic"],
 ", as opposed to in sequence. (See below for more comments on this.) \n\nAn ",
 StyleBox["algebra",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " contains more structure. Its elements can be added and multiplied by \
ordinary numbers, as in a vector space. They can also be multiplied with each \
other. Matrices are the main example for us.\n\nMore specifically, ",
 StyleBox["all 2\[Times]2 complex matrices together form an a \
(noncommutative) ",
  FontWeight->"Bold"],
 StyleBox["algebra",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ": we can add matrices, multiply them by complex numbers, and multiply \
matrices among each other. \n\nHowever, ",
 StyleBox["all matrices do ",
  FontWeight->"Bold"],
 StyleBox["not",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" form a",
  FontWeight->"Bold"],
 StyleBox[" group",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" under multiplication",
  FontWeight->"Bold"],
 ". Obviously, the zero matrix has no inverse. But the key new thing is that \
there are nonzero matrices that also have no inverse, as operations: for \
example, id \[Dash] ",
 StyleBox["x",
  FontSlant->"Italic"],
 " is a nonzero matrix without an inverse."
}], "Text",
 CellChangeTimes->{{4.0008711832135897`*^9, 4.000871236331629*^9}, {
  4.000872870765923*^9, 4.000872903998921*^9}, {4.000874495592955*^9, 
  4.000874511761957*^9}, {4.000874557763772*^9, 4.000874616897341*^9}, {
  4.0008748131143827`*^9, 4.000874858063347*^9}, {4.000875273633751*^9, 
  4.0008753133523283`*^9}, {4.0008753433554697`*^9, 4.000875439752698*^9}, {
  4.00087661075004*^9, 4.000876758759354*^9}, {4.0008778729201393`*^9, 
  4.0008778787386847`*^9}},ExpressionUUID->"a96dfa63-edf7-43f3-b7b0-\
4bbb8720d5c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"(", 
  RowBox[{"id", "-", "x"}], ")"}]], "Input",
 CellLabel->
  "In[4091]:=",ExpressionUUID->"3ab4d1d7-4970-4c6b-97d5-8680d96b35da"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"1", 
      RowBox[{"-", "1"}]},
     {
      RowBox[{"-", "1"}], "1"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.000871246494438*^9, 4.000872598785344*^9},
 CellLabel->
  "Out[4091]=",ExpressionUUID->"9872da57-3dd8-4c71-b731-d38dd09f2bb4"]
}, Open  ]],

Cell[TextData[{
 "Multiplying id \[Dash] ",
 StyleBox["x",
  FontSlant->"Italic"],
 " and the nonzero matrix id + ",
 StyleBox["x",
  FontSlant->"Italic"],
 " gives the zero matrix:"
}], "Text",
 CellChangeTimes->{{4.000875440676153*^9, 
  4.000875443235817*^9}},ExpressionUUID->"9fea6d70-b7db-4178-9530-\
396540ac4ead"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"id", "-", "x"}], ")"}], ".", 
  RowBox[{"(", 
   RowBox[{"id", "+", "x"}], ")"}]}]], "Input",
 CellChangeTimes->{{4.0008712454493523`*^9, 4.00087128028307*^9}},
 CellLabel->
  "In[4092]:=",ExpressionUUID->"c922b316-a58b-4ac1-93b5-339e25de7c22"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", "0"},
     {"0", "0"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{{4.000871253661058*^9, 4.000871280795335*^9}, 
   4.0008725987928047`*^9},
 CellLabel->
  "Out[4092]=",ExpressionUUID->"fc66f0e4-5bb1-4d46-bb8e-d135e4405b46"]
}, Open  ]],

Cell[TextData[{
 "Since there exists at least one matrix (here id\[Dash]",
 StyleBox["x",
  FontSlant->"Italic"],
 ") that sends a nonzero matrix to the zero matrix, we can \
\[OpenCurlyDoubleQuote]get stuck\[CloseCurlyDoubleQuote], i.e. we cannot \
recover the original matrix we multiplied (here id+x). In other words, we \
\[OpenCurlyDoubleQuote]lost information\[CloseCurlyDoubleQuote] of what the \
original matrix we multiplied was, since the transformation cannot be \
inverted. Information loss appears in many places in physics (e.g. entropy), \
so don\[CloseCurlyQuote]t view it as something \[OpenCurlyDoubleQuote]wrong\
\[CloseCurlyDoubleQuote] in itself. Just note this as a fact, something \
possibly interesting.\n\nActually, you already know how to proceed. ",
 StyleBox["How can we restrict 2x2 matrices to make them invertible?",
  FontSlant->"Italic"],
 " Require nonzero determinant. The \[OpenCurlyDoubleQuote]det \[NotEqual] 0\
\[CloseCurlyDoubleQuote] matrices do form a group, that we will call \
\[OpenCurlyDoubleQuote]GL(2)\[CloseCurlyDoubleQuote], for \
\[OpenCurlyDoubleQuote]General Linear\[CloseCurlyDoubleQuote] (2 x 2 \
transformation). This restriction excludes the matrix example above:"
}], "Text",
 CellChangeTimes->{{4.000871260679344*^9, 4.000871273399742*^9}, {
  4.000872919351657*^9, 4.0008729364098186`*^9}, {4.000872997788179*^9, 
  4.000873015614621*^9}, {4.000873061263382*^9, 4.000873169995008*^9}, {
  4.000873239419949*^9, 4.000873300171555*^9}, {4.00087333768825*^9, 
  4.0008737002776203`*^9}, {4.000874441139587*^9, 4.000874442158778*^9}, {
  4.000874869818112*^9, 4.000874954853283*^9}, {4.000875464924137*^9, 
  4.000875469929867*^9}, {4.000876794477324*^9, 4.0008768119979553`*^9}, {
  4.000877919786317*^9, 
  4.000877920954153*^9}},ExpressionUUID->"3dd09c1e-b113-4288-b47f-\
1e8991e4a7fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Det", "[", 
  RowBox[{"id", "-", "x"}], "]"}]], "Input",
 CellChangeTimes->{{4.000875456825995*^9, 4.0008754609049873`*^9}},
 CellLabel->
  "In[4103]:=",ExpressionUUID->"b37c6421-ce3a-4c0b-b72a-8e663705f064"],

Cell[BoxData[
 FormBox["0", TraditionalForm]], "Output",
 CellChangeTimes->{4.0008754620077972`*^9},
 CellLabel->
  "Out[4103]=",ExpressionUUID->"cf9bcf51-cc49-40eb-b5e6-85b9375222d5"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Summary and outlook: group algebra",
  FontWeight->"Bold"],
 "\nThe extra \[OpenCurlyDoubleQuote]linear structure\[CloseCurlyDoubleQuote] \
of addition (linear combination) that algebras have, but groups do not, is \
often very useful in physics. Quantum states can be superposed, differential \
equations used in physics are often linear, and operators can be added and \
multiplied. If ",
 StyleBox["A",
  FontSlant->"Italic"],
 " and ",
 StyleBox["B",
  FontSlant->"Italic"],
 " are matrices, then 3",
 StyleBox["A ",
  FontSlant->"Italic"],
 "\[Dash] 2",
 StyleBox["B",
  FontSlant->"Italic"],
 " is another matrix. There is no analogous operation in an abstract group: \
if ",
 StyleBox["g",
  FontSlant->"Italic"],
 " and ",
 StyleBox["h",
  FontSlant->"Italic"],
 " are two group elements, then as noted above, a \
\[OpenCurlyDoubleQuote]linear combination of operations\
\[CloseCurlyDoubleQuote], such as 3",
 StyleBox["g \[Dash] ",
  FontSlant->"Italic"],
 "2",
 StyleBox["h,",
  FontSlant->"Italic"],
 " has no meaning. As mentioned above, for rotations, a \
\[OpenCurlyDoubleQuote]linear combination\[CloseCurlyDoubleQuote] would be \
something like performing several ",
 StyleBox["different",
  FontSlant->"Italic"],
 " rotations ",
 StyleBox["simultaneously",
  FontSlant->"Italic"],
 ", as opposed to in sequence. \[OpenCurlyDoubleQuote]Simultaneous rotation\
\[CloseCurlyDoubleQuote] (or more precisely, superposition of different \
possible rotations) does not seem to make sense.\n\nAs you can maybe guess \
from this formulation, we will in fact assign meaning to superpositions of \
operations. This is called a ",
 StyleBox["group algebra,",
  FontSlant->"Italic"],
 " to be defined. Here the point is not to define this new thing, but to \
point out that such structure is ",
 StyleBox["not",
  FontSlant->"Italic"],
 " included in ordinary groups or algebras, in the sense that neither groups \
nor algebras separately describe everything that a group algebra is. Instead, \
understanding ordinary groups and algebras is a necessary starting point.",
 "\n\n"
}], "Text",
 CellChangeTimes->{{4.0008742965755653`*^9, 4.000874446354239*^9}, {
  4.00087448996163*^9, 4.000874491200439*^9}, {4.000874969202334*^9, 
  4.000875268103168*^9}, {4.000875482382131*^9, 4.000875605077437*^9}, {
  4.0008768454901943`*^9, 4.000876891960064*^9}, {4.0008771203811483`*^9, 
  4.00087712684643*^9}, {4.0008771598073187`*^9, 4.00087720235625*^9}, {
  4.000877240869494*^9, 4.000877345266214*^9}, {4.00087793478675*^9, 
  4.000877975676251*^9}},ExpressionUUID->"0c8e0791-e168-45cc-9e0c-\
e135e0731656"]
},
