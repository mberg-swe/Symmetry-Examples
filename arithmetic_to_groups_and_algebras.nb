Cell[TextData[{
 "Reflect for a moment that these two operations, ",
 StyleBox["matrix addition",
  FontSlant->"Italic"],
 " and ",
 StyleBox["scalar multiplication",
  FontSlant->"Italic"],
 ", are the obvious generalizations of the elementary operations ",
 StyleBox["addition",
  FontSlant->"Italic"],
 " and ",
 StyleBox["multiplication",
  FontSlant->"Italic"],
 " on ordinary numbers, now used on a different (here \
\[OpenCurlyDoubleQuote]bigger\[CloseCurlyDoubleQuote]) object.\nBut how to \
generalize ",
 StyleBox["multiplication by matrices",
  FontWeight->"Bold"],
 " (as opposed to scalar multiplication) is less obvious. \n\nOf course, you \
know the answer. A lower dot between matrices, as ",
 StyleBox["x.z", "Input"],
 ", means matrix multiplication in the usual sense:"
}], "Text",
 CellChangeTimes->{{4.000870797631578*^9, 4.00087089709908*^9}, {
  4.000872475955415*^9, 4.000872594041403*^9}, {4.000876477793347*^9, 
  4.0008765213155947`*^9}},ExpressionUUID->"e4820bd5-d3d0-482b-be0a-\
97661fc90ab5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"x", ".", "z"}]], "Input",
 CellLabel->
  "In[4087]:=",ExpressionUUID->"a1129033-0b82-4264-b720-cafb115389d4"],

