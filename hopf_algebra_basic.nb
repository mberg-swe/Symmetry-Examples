Cell[TextData[{
 "This is a ",
 StyleBox["Graph", "Input"],
 " data structure, as in ",
 StyleBox["finite_groups_basic.nb",
  FontSlant->"Italic"],
 ".\nActually, ",
 StyleBox["Tree", "Input"],
 " is its own data structure, in computer science more generally. Think an \
actual tree with root and branches, but ",
 StyleBox["upside down",
  FontSlant->"Italic"],
 ". Or, a ",
 StyleBox["family tree",
  FontSlant->"Italic"],
 " going downwards, with grandparent, children, and so on). We convert with \
",
 StyleBox["GraphTree", "Input"],
 ":"
}], "Text",
 CellChangeTimes->{{3.972530197459607*^9, 3.9725302098551903`*^9}, {
   3.9725397386072397`*^9, 3.972539765718358*^9}, {3.972697272735824*^9, 
   3.972697313361659*^9}, {3.972697406772868*^9, 3.9726974342703323`*^9}, {
   3.972697779681613*^9, 3.9726978404602213`*^9}, {3.972698208952641*^9, 
   3.97269824945891*^9}, {3.9743382705401382`*^9, 3.974338321165187*^9}, 
   3.974338498466551*^9},ExpressionUUID->"518747f9-2933-4113-8eba-\
5a5dd8cf4e29"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"exampleTree", " ", "=", " ", 
  RowBox[{"GraphTree", "[", "%", "]"}]}]], "Input",
