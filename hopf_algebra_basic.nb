fcc8bfc8fef4"]
}, Open  ]],

Cell[TextData[{
 "where \[OpenCurlyDoubleQuote]",
 StyleBox["None", "Input"],
 "\[CloseCurlyDoubleQuote] means \[OpenCurlyDoubleQuote]no child\
\[CloseCurlyDoubleQuote] (using the terminology of ",
 StyleBox["family",
  FontSlant->"Italic"],
 " trees).\n\nNow, to make a bialgebra, we cut the tree branches, and keep \
the fallen pieces separate from the root-connected piece by the tensor \
product symbol \[TensorProduct]. An ",
 StyleBox["admissible cut",
  FontWeight->"Bold"],
 " is one where no path through the original tree meets more than one cut. \
Let\[CloseCurlyQuote]s get started.\n\nCut the edge 1 \[DirectedEdge] 2, and \
put the \[OpenCurlyDoubleQuote]pruned\[CloseCurlyDoubleQuote] piece that \
falls down first:"
}], "Text",
 CellChangeTimes->{{3.972531895226946*^9, 3.9725319086492662`*^9}, {
  3.972532005443564*^9, 3.972532012063067*^9}, {3.972537793111856*^9, 
  3.972537823874878*^9}, {3.972538163238736*^9, 3.9725381713008413`*^9}, {
  3.9726975894919786`*^9, 3.9726977061873903`*^9}, {3.97269775755569*^9, 
  3.972697773531967*^9}, {3.97269791439426*^9, 3.972697930824287*^9}, {
  3.972698264936531*^9, 3.972698334274878*^9}, {3.974338511136145*^9, 
  3.9743385497634706`*^9}},ExpressionUUID->"28541fa0-9cf7-40ca-8ec7-\
158c09a0afaf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"cut1", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Tree", "[", 
     RowBox[{"2", ",", "None"}], "]"}], ",", 
    RowBox[{"TreeDelete", "[", 
     RowBox[{"exampleTree", ",", "1"}], "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.972537040202711*^9, 3.9725370549216623`*^9}, {
  3.97253812313544*^9, 3.972538126512583*^9}},
 CellLabel->
  "In[1770]:=",ExpressionUUID->"b60bb292-8349-45bb-9d0f-6d0f27c7b764"],

