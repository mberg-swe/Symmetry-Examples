Cell[TextData[{
 "Note that cutting the edge 3 \[DirectedEdge] 4 in these last things is not \
admissible anymore, since we already cut one edge on the same path: 1 \
\[DirectedEdge] 3.\n\nThere is now only one admissible cut left, that I leave \
for you as exercise.\n\nThe coproduct \[CapitalDelta] of the bialgebra is:\
\[LineSeparator]",
 StyleBox["e",
  FontSlant->"Italic"],
 " \[TensorProduct] ",
 StyleBox["t",
  FontSlant->"Italic"],
 " + ",
 StyleBox["t",
  FontSlant->"Italic"],
 " \[TensorProduct] ",
 StyleBox["e",
  FontSlant->"Italic"],
 " + (what falls down \[TensorProduct] what is left), \[LineSeparator]where \
\[OpenCurlyDoubleQuote]e\[CloseCurlyDoubleQuote] is the empty tree. The role \
of \[TensorProduct] is simply to keep the two pieces apart.\nThis bialgebra \
becomes ",
 StyleBox["Hopf",
  FontWeight->"Bold"],
 " by finding an \[OpenCurlyDoubleQuote]inverse\[CloseCurlyDoubleQuote]: the ",
 StyleBox["antipode",
  FontWeight->"Bold"],
 " ",
 StyleBox["s",
  FontSlant->"Italic"],
 ".\n\nFirst for just a single node \[Bullet], call it \[Bullet] = ",
 StyleBox["a",
  FontSlant->"Italic"],
 " to make it easier to type. "
}], "Text",
 CellChangeTimes->{{3.972537778512191*^9, 3.9725377791262302`*^9}, {
  3.972537840759446*^9, 3.9725378810507402`*^9}, {3.972696829026781*^9, 
  3.972696909973908*^9}, {3.9726969551287947`*^9, 3.972696962598681*^9}, {
  3.9726981091568737`*^9, 3.972698139593502*^9}, {3.9726984103992453`*^9, 
  3.972698497525298*^9}, {3.973154609257936*^9, 3.973154637633333*^9}, {
  3.974338642929154*^9, 
  3.974338767767661*^9}},ExpressionUUID->"b9719d6f-6f58-4917-b8a3-\
98e6a7572023"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalDelta]a", " ", "=", "  ", 
   RowBox[{
    RowBox[{"e", " ", "\[TensorProduct]", " ", "a"}], "+", " ", 
    RowBox[{"a", " ", "\[TensorProduct]", " ", "e"}]}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sId\[CapitalDelta]a", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"s", "[", "e", "]"}], "\[TensorProduct]", " ", "a"}], " ", "+", 
    " ", 
    RowBox[{
     RowBox[{"s", "[", "a", "]"}], " ", "\[TensorProduct]", " ", "e"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rule\[Mu]", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a_", " ", "\[TensorProduct]", " ", "b_"}], ")"}], "->", " ", 
      RowBox[{"a", " ", "b"}]}], "}"}]}], ";", " ", 
   RowBox[{"ruleS", " ", "=", " ", 
    RowBox[{
     RowBox[{"s", "[", "e", "]"}], "->", "e"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sId\[CapitalDelta]a", "  ", "/.", " ", "rules"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", " ", "//.", "rule\[Mu]"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", " ", "==", "0"}], "/.", " ", 
  RowBox[{"e", "->", "1"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{"%", ",", 
    RowBox[{"s", "[", "a", "]"}]}], "]"}], "//", "First"}]}], "Input",
 CellChangeTimes->{{3.972539370713579*^9, 3.972539546610724*^9}, {
  3.9725395862927237`*^9, 3.972539592119323*^9}, {3.97269693520858*^9, 
