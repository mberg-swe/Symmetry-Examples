Cell[TextData[{
 "This is the automated cutting procedure, use ",
 StyleBox["EdgeDelete", "Input"],
 ".\nAgain, ",
 StyleBox["Graphs", "Input"],
 " don\[CloseCurlyQuote]t have a root, but we can easily display them as ",
 StyleBox["Trees", "Input"],
 ":"
}], "Text",
