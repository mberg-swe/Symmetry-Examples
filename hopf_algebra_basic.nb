Cell["Tree[1, {Tree[2, None], Tree[3, {Tree[4, None]}]}]", "Output",
 CellChangeTimes->{
  3.972536941771167*^9, 3.972538540540085*^9, {3.972539853362626*^9, 
   3.972539876682046*^9}, 3.972697996225368*^9, 3.9731354950085917`*^9, 
