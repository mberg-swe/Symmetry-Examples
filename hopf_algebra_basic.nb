Notebook[{
Cell[TextData[StyleBox["Hopf algebra basics: rooted trees", \
"Subsubsection"]], "Text",
 CellChangeTimes->{{3.9725259838504467`*^9, 3.972525985546777*^9}, {
  3.9725260185421247`*^9, 3.972526019427751*^9}, {3.972527392593976*^9, 
  3.9725273949334297`*^9}, {3.973154775097678*^9, 
  3.973154779547008*^9}},ExpressionUUID->"43f521bd-c8ae-4c3e-96f2-\
aa6d79b2f5e9"],

Cell["\<\
You don\[CloseCurlyQuote]t need to read the following notes by Foissy, but I \
refer to them a few times here, for completeness:
http://loic.foissy.free.fr/pageperso/preprint3.pdf\
\>", "Text",
 CellChangeTimes->{{3.972533694156989*^9, 3.9725337074362307`*^9}, {
  3.9725396425579243`*^9, 3.97253965758902*^9}, {3.9726973578186197`*^9, 
  3.972697371409593*^9}},ExpressionUUID->"85d7ac1c-7cd0-41dc-bb45-\
f1ec4d44db27"],

Cell[TextData[{
 "In a way, what I do here is the \[OpenCurlyDoubleQuote]complement\
\[CloseCurlyDoubleQuote] of what I did with the symmetric group in ",
 StyleBox["finite_groups_basic.nb",
  FontSlant->"Italic"],
 ", where we focused on the ",
 StyleBox["cycles",
  FontSlant->"Italic"],
 " (think of the Cayley graph). Here we focus on ",
 StyleBox["graphs ",
  FontWeight->"Bold"],
 StyleBox["without cycles, called trees",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[". ",
  FontSlant->"Italic"],
 "They are also a special kind of tree graphs: trees that have a ",
 StyleBox["root",
  FontWeight->"Bold"],
 ". "
}], "Text",
 CellChangeTimes->{{3.972527424057089*^9, 3.9725274613699007`*^9}, {
  3.972539660463724*^9, 3.972539723959416*^9}, {3.972697386490243*^9, 
  3.972697397799223*^9}, {3.974338215811328*^9, 
  3.974338243151919*^9}},ExpressionUUID->"d95902b4-31c3-4e5e-b9fe-\
e6ccba3ac862"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", "]"}], "//", "Quiet"}]], "Input",\

 CellLabel->
  "In[1766]:=",ExpressionUUID->"d26911f0-080a-4b07-bb02-21a0d934e299"],

Cell["Here\[CloseCurlyQuote]s the example in Foissy:", "Text",
 CellChangeTimes->{{3.972539729358759*^9, 
  3.9725397346799498`*^9}},ExpressionUUID->"a523bf31-39e8-4cbe-ac5d-\
c3f4b2df4fc0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"example", " ", "=", 
  RowBox[{"TreeGraph", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "\[DirectedEdge]", "2"}], ",", 
      RowBox[{"1", "\[DirectedEdge]", "3"}], ",", 
      RowBox[{"3", "\[DirectedEdge]", "4"}]}], "}"}], ",", 
    RowBox[{"VertexLabels", "->", 
     RowBox[{"Placed", "[", 
      RowBox[{"\"\<Name\>\"", ",", "Center"}], "]"}]}], ",", 
    RowBox[{"VertexSize", "->", "0.3"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.972528252264757*^9, 3.972528252266417*^9}, {
   3.972528315011609*^9, 3.97252832982663*^9}, {3.9725319540731163`*^9, 
   3.972531954750698*^9}, 3.9725355440386457`*^9, {3.972535585354678*^9, 
