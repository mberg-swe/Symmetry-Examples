Cell[BoxData[
 RowBox[{"Groupings", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], ",", 
   RowBox[{"CircleTimes", "->", "2"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9725304809910297`*^9, 3.9725304809919853`*^9}, {
