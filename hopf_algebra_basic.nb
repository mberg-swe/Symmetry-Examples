Cell[TextData[{
 "As mentioned above, the \
\[OpenCurlyDoubleQuote]lines\[CloseCurlyDoubleQuote] in this ",
 StyleBox["Tree", "Input"],
 " data structure aren\[CloseCurlyQuote]t their own objects, so it\
\[CloseCurlyQuote]s more natural to cut edges in the corresponding ",
 StyleBox["Graph", "Input"],
 ":"
}], "Text",
