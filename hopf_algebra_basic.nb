Cell[TextData[{
 "OK. \nNow the tree with two nodes, call it ",
 StyleBox["t. ",
  FontSlant->"Italic"],
 "As is intuitive, cutting it produces two pieces",
 StyleBox[" a",
  FontSlant->"Italic"],
 " \[TensorProduct] ",
 StyleBox["a, ",
  FontSlant->"Italic"],
 "where again ",
 StyleBox["a",
  FontSlant->"Italic"],
 " = \[Bullet].\nThe coproduct is:"
}], "Text",
 CellChangeTimes->{{3.97315464872974*^9, 3.973154743061162*^9}, 
   3.974338780210935*^9},ExpressionUUID->"74522416-50be-4254-b275-\
