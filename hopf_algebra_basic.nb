Cell[TextData[{
 "This is number 4 in Foissy\[CloseCurlyQuote]s table. \n(I did it by hand; \
below is an automated version.)\nIt\[CloseCurlyQuote]s not admissible to cut \
this again (cf. definition of ",
 StyleBox["admissible",
  FontSlant->"Italic"],
 " above).\nNow cut the edge 1 \[DirectedEdge] 3:"
}], "Text",
