  3.976956542517959*^9}, {3.9769565896362133`*^9, 3.976956647480194*^9}, {
  3.976956680425522*^9, 3.976956682331321*^9}, {3.976957648491901*^9, 
  3.9769576776664248`*^9}, {3.9769577241309032`*^9, 3.976957738334505*^9}, {
