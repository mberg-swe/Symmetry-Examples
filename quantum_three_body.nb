Cell[TextData[{
 "(One can mean different things by \[OpenCurlyDoubleQuote]braid operator\
\[CloseCurlyDoubleQuote]. Think of this as a simple example, ",
 StyleBox["not ",
  FontWeight->"Bold"],
 "some universal meaning of \[OpenCurlyDoubleQuote]braid operator\
\[CloseCurlyDoubleQuote] in quantum physics: we will see other examples \
below.)\nAs a matrix in this basis, ",
 StyleBox["B",
  FontSlant->"Italic"],
 " looks like:"
}], "Text",
