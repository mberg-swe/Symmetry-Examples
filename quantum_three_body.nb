Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"R12", "@", 
    RowBox[{"R23", "@", "R12"}]}], ")"}], "==", 
  RowBox[{"(", 
   RowBox[{"R23", "@", 
    RowBox[{"R12", "@", "R23"}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.976894542571775*^9, 3.976894548894507*^9}, {
  3.9769493991398783`*^9, 3.976949411552421*^9}, {3.97694964377382*^9, 
  3.9769496646127863`*^9}},
 CellLabel->
  "In[208]:=",ExpressionUUID->"aa65f171-1929-4a9a-a6f9-9ff922100466"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{
  3.976894195370677*^9, 3.9768943291262703`*^9, 3.97689454951816*^9, {
