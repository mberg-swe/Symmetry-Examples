        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.976957283847237*^9},
 CellLabel->
  "Out[234]=",ExpressionUUID->"a24c9948-5163-46c8-a22d-64233da8d182"]
}, Open  ]],

Cell[TextData[{
 "So quantum particles can have \[OpenCurlyDoubleQuote]memory\
\[CloseCurlyDoubleQuote] that they have been exchanged: it is as if they had \
strings attached to them, like braids. This should not be too surprising if \
you have heard of the ",
 StyleBox["Aharonov-Bohm effect",
  FontWeight->"Bold"],
 " in a magnetic field, although here there is not necessarily a magnetic \
field.  \n\n(Indeed, the information in the Nobel Prize for 2022 illustrates \
entanglement as strings attached between particles. However, there is no \
experimental evidence that there are any actual ",
 StyleBox["physical",
  FontSlant->"Italic"],
 " strings. The strings provide a way to illustrate quantum information with \
a classical drawing.) \n\nIf we keep going, we see that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["B", "4"], TraditionalForm]],ExpressionUUID->
  "5b14e86e-70ac-4fc8-94d7-70c3f0fd91d2"],
 " = \[Dash]",
 StyleBox["I :",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.976957309040107*^9, 3.9769573571555347`*^9}, {
  3.976957413977826*^9, 3.976957483649419*^9}, {3.976957530588016*^9, 
  3.976957549977312*^9}, {3.976958763392136*^9, 
  3.9769590162988977`*^9}},ExpressionUUID->"a81f0db5-3509-4f0c-ab36-\
1ca3f98eec69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BMatrix", ".", "BMatrix", ".", "BMatrix", ".", "BMatrix"}]], "Input",\

 CellChangeTimes->{{3.976957299736586*^9, 3.9769573064746428`*^9}},
 CellLabel->
  "In[236]:=",ExpressionUUID->"598126e9-1e92-4765-bd8c-8f64734d1f68"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"-", "1"}], "0", "0", "0"},
     {"0", 
      RowBox[{"-", "1"}], "0", "0"},
     {"0", "0", 
      RowBox[{"-", "1"}], "0"},
     {"0", "0", "0", 
      RowBox[{"-", "1"}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{{3.976957301242437*^9, 3.976957306917172*^9}},
 CellLabel->
  "Out[236]=",ExpressionUUID->"c3fa2d17-df2b-426f-a53f-417452d7ae4f"]
}, Open  ]],

Cell[TextData[{
 " so we\[CloseCurlyQuote]d need ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["B", "8"], TraditionalForm]],ExpressionUUID->
  "c4008e70-4101-4d5f-b461-4fde6265238f"],
 " to literally get to the identity (we can identify the state with an \
overall sign with itself, so it depends on what we want to do). This is like \
a root of unity, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["q", "8"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "54af69b2-d338-41a8-a091-f3922ce10ebf"],
 " = 1.\n\nA more general way to characterize the generalization from 2 \
classical to 2 quantum particles is by replacing the symmetric group ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "361ccc03-02a9-46b2-af88-f1f1e3333dea"],
 " with the",
 StyleBox[" braid group",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "43ae85cd-2236-4e8c-8bed-74e01b008043"],
 " \[TildeEqual] \[DoubleStruckCapitalZ], which has an infinite number of \
elements: a braid remembers how many times you twisted it. So ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "84e3cdc3-ca80-4bbf-a700-7b5431b28a49"],
 " is quite a lot more complicated than ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "87406df7-1701-4e08-a64d-960bc697bc5d"],
 " which is isomorphic to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[DoubleStruckCapitalZ]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ed993141-3129-4d4d-b904-975d1e3da579"],
 ", and forgets immediately that it was ever applied, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[DoubleStruckCapitalZ]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "797098d3-94f8-4359-8bfd-e04f48ada112"],
 ": {",
 StyleBox["g,e",
  FontSlant->"Italic"],
 "} with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fe6dd401-729b-41a7-8ff1-393484666c06"],
 " = ",
 StyleBox["e",
  FontSlant->"Italic"],
 ". (The representation on qubits above, that terminates at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["B", "8"], TraditionalForm]],ExpressionUUID->
  "b1c0da07-a539-4f68-a2b1-72012cd10ffb"],
 " = ",
 StyleBox["I,",
  FontSlant->"Italic"],
 " is not a representation of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5895f7fa-28ea-43f2-baed-6b81c777ec4b"],
 ", but of a quotient",
 ".)"
}], "Text",
 CellChangeTimes->{{3.9769573587373466`*^9, 3.9769573952527227`*^9}, {
  3.976959054919381*^9, 3.9769590551654043`*^9}, {3.976959436219467*^9, 
  3.976959451363969*^9}, {3.9769595074242563`*^9, 3.976959713183967*^9}, {
  3.976959959689518*^9, 
  3.976960184796476*^9}},ExpressionUUID->"3674211d-4939-4e0b-97de-\
67054851e4d2"],

Cell[TextData[{
 StyleBox["Three (quasi-)particles",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 "\nIn the symmetric group ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "n"], TraditionalForm]],ExpressionUUID->
  "5833e075-1303-430e-b736-20c7b6032fcd"],
 ", everything can be built up from \[OpenCurlyDoubleQuote]",
 StyleBox["local moves",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote] among two particles at a time. Even then, \
something new appears compared to just two particles: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "3"], TraditionalForm]],ExpressionUUID->
  "832da67a-7927-44c5-8a94-152c3293947c"],
 " is noncommutative. If we want a state to be uniquely described by \
specifying the numbering of the three particles, then we should demand \
(12)(23)(12)=(23)(12)(23), since both take the numbering 123 to 321. \n\
\[LineSeparator]",
 StyleBox["Comment",
  FontSlant->"Italic"],
 ": why \[OpenCurlyDoubleQuote]if\[CloseCurlyDoubleQuote] we want the state \
to be specified by the numbering? In local classical kinematics, with \
\[OpenCurlyDoubleQuote]no strings attached\[CloseCurlyDoubleQuote], \
specifying the state by the numbering seems like a logical necessity. But in \
quantum mechanics, it could be viewed as a restriction that we choose to \
ignore whatever \[OpenCurlyDoubleQuote]memory\[CloseCurlyDoubleQuote] the \
strings might carry.\n\nConsider ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "12"], TraditionalForm]],ExpressionUUID->
  "4d517fd4-9cd3-468d-a464-597740b67f67"],
 " : braid qubit 1 and 2, but do nothing to qubit 3. \[LineSeparator]So ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "12"], TraditionalForm]],ExpressionUUID->
  "95064112-2ea2-41cd-ab72-016d9050b4c2"],
 "  = ",
 StyleBox["B",
  FontSlant->"Italic"],
 " \[TensorProduct] id:"
}], "Text",
 CellChangeTimes->{{3.976894302056407*^9, 3.9768943154789953`*^9}, {
   3.976894507575521*^9, 3.976894535162818*^9}, {3.9769486362977743`*^9, 
