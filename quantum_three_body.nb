Notebook[{
Cell[TextData[StyleBox["The quantum three-body problem", "Subsubsection"]], \
"Text",
 CellChangeTimes->{{3.9768517554020853`*^9, 3.976851760489758*^9}, {
  3.97693807691506*^9, 3.976938081398752*^9}, {3.976938686730297*^9, 
  3.97693869173424*^9}},ExpressionUUID->"409c5e99-19db-4d2f-bdd1-\
95a0b6f155cb"],

Cell[TextData[{
 "In a basic course like ",
 StyleBox["Introduction to Modern Physics",
  FontSlant->"Italic"],
 " (that uses the Susskind pocket-book introduction to quantum physics), we \
put a lot of effort into describing and trying to understand ",
 StyleBox["two",
  FontSlant->"Italic"],
 " quantum particles, for example electrons. Here we start discussing the \
quantum ",
 StyleBox["three",
  FontSlant->"Italic"],
 "-body problem. \n\n(The word \[OpenCurlyDoubleQuote]",
 StyleBox["body",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote] from mechanics is better than the word \
\[OpenCurlyDoubleQuote]particle\[CloseCurlyDoubleQuote] here, since in \
quantum physics, particles can usually not be precisely localized, so think \
of them as \[OpenCurlyDoubleQuote]fuzzy\[CloseCurlyDoubleQuote], which means \
effectively ",
 StyleBox["extended",
  FontWeight->"Bold"],
 ", even if they are point particles when measured.)"
}], "Text",
 CellChangeTimes->{{3.976851762285963*^9, 3.9768517686657*^9}, {
   3.97685185004566*^9, 3.976851863518251*^9}, {3.976851898883193*^9, 
   3.976852036935384*^9}, 3.9768955427527018`*^9, {3.976938131466695*^9, 
   3.9769387708999367`*^9}, {3.976956752994722*^9, 3.9769567877292633`*^9}, 
   3.976958723811985*^9},ExpressionUUID->"8117d640-1581-476c-b70c-\
9ff78c3400fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`\>\"", "]"}], "//", 
  "Quiet"}]], "Input",
