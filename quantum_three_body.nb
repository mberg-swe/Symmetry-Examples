Cell[TextData[{
 "Now consider ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "23"], TraditionalForm]],ExpressionUUID->
  "e461c199-f772-41c3-afb4-389a578aa16a"],
 " : braid qubit 2 and 3, but do nothing to qubit 1. \[LineSeparator]So ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "23"], TraditionalForm]],ExpressionUUID->
  "9aa03306-3327-4e1f-97bc-6d4e92af5a85"],
