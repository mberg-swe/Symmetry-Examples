Cell[TextData[{
 "The ",
 StyleBox["Braid", "Input"],
 " operator can be viewed as a transformation from the standard basis of \
00,01,10,11 (called \[OpenCurlyDoubleQuote]computational basis\
\[CloseCurlyDoubleQuote] in quantum computing) to superposition (Bell) states:"
}], "Text",
