Cell[TextData[{
 "In the permutation group ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],ExpressionUUID->
  "8461264d-6fa6-4b8c-8961-abf3ad826674"],
 ", we of course know that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", "12", ")"}], "2"], TraditionalForm]],ExpressionUUID->
  "c65bd2f1-d8d8-4ac0-9292-1dc327570bd1"],
 " = ",
 StyleBox["e:",
  FontSlant->"Italic"],
 " if you exchange two particles ",
 StyleBox["twice",
  FontSlant->"Italic"],
 ", they have no memory of having been exchanged at all. \
\[LineSeparator]Applying the braid operator twice, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["B", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e08488b2-491c-4046-8260-8074d604a4a0"],
 ", does ",
 StyleBox["not",
  FontSlant->"Italic"],
 " produce the identity:"
}], "Text",
 CellChangeTimes->{{3.97695728598798*^9, 3.9769572941934547`*^9}, {
  3.976957402677794*^9, 3.976957412126539*^9}, {3.9769574667060347`*^9, 
  3.976957525280884*^9}, {3.976959028393816*^9, 
  3.976959035462853*^9}},ExpressionUUID->"9e2a904a-15b3-4809-908c-\
43ad74b0551c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BMatrix", ".", "BMatrix"}]], "Input",
 CellChangeTimes->{{3.976957281446506*^9, 3.976957283397334*^9}},
 CellLabel->
  "In[234]:=",ExpressionUUID->"be951eb9-1c0a-4714-a31c-42e9224af478"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", "0", "0", "1"},
     {"0", "0", "1", "0"},
     {"0", 
      RowBox[{"-", "1"}], "0", "0"},
     {
      RowBox[{"-", "1"}], "0", "0", "0"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
