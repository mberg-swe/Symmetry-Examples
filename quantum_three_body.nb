Cell["Check the Yang-Baxter equation:", "Text",
 CellChangeTimes->{{3.976894345481193*^9, 3.976894353126601*^9}, {
  3.97694946785137*^9, 
  3.9769494693262863`*^9}},ExpressionUUID->"254a5840-07ba-4f82-8076-\
