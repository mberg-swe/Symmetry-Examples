Notebook[{
Cell[TextData[StyleBox["Finite groups in Mathematica: basics", \
"Subsubsection"]], "Text",
 CellChangeTimes->{{3.9724515030254507`*^9, 3.972451513202277*^9}, 
   3.973150642614555*^9},ExpressionUUID->"cc84c934-0d1c-408b-a9c3-\
183246043733"],

Cell[TextData[{
 "This file is an introduction to finite groups in Mathematica. The main \
example is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "3"], TraditionalForm]],ExpressionUUID->
  "3df9760f-1c67-4588-bd5b-9afed4751bb4"],
 ". \[LineSeparator]The purpose is 1. review group theory, 2. give foundation \
for ",
 StyleBox["group algebra",
  FontSlant->"Italic"],
 " \[DoubleStruckCapitalC]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "3"], TraditionalForm]],ExpressionUUID->
  "20212951-a424-423c-a9ec-37463fd5bda9"],
 " (see notes). \nMathematica knows groups by order, for example order 3:"
}], "Text",
 CellChangeTimes->{{3.972450058251321*^9, 3.972450061892666*^9}, {
  3.972451519828946*^9, 3.972451529251746*^9}, {3.973150542823477*^9, 
  3.973150616385913*^9}, {3.980252636064003*^9, 
  3.980252669426126*^9}},ExpressionUUID->"80553bcf-73ed-492c-9aae-\
c0a5c03fee66"],

