Cell[TextData[{
 "There is only one generator: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "3"], TraditionalForm]],ExpressionUUID->
  "91722adf-2a11-44ed-9ab9-1b0b3031974a"],
 " is an abelian group. For example, we can get the 3rd element by taking the \
2nd element twice (as you can hear from \[OpenCurlyDoubleQuote]permute \
cyclically twice\[CloseCurlyDoubleQuote]), using \
Mathematica\[CloseCurlyQuote]s ",
 StyleBox["permutation product",
  FontWeight->"Bold"],
 " \[PermutationProduct] (typed as ",
 StyleBox["esc p* esc",
  FontSlant->"Italic"],
 "):"
}], "Text",
 CellChangeTimes->{{3.972451896422474*^9, 3.972451927046187*^9}, {
  3.972452046150333*^9, 3.9724520525471277`*^9}, {3.972461752088957*^9, 
