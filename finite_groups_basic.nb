 CellChangeTimes->{{3.972465080802925*^9, 3.972465087756983*^9}, {
   3.972465139424522*^9, 3.9724651460201607`*^9}, 3.972465179458295*^9, 
   3.9724652474281073`*^9, 3.972523305986908*^9, 3.9725234463512163`*^9, 
   3.972550452965749*^9, 3.973154159014719*^9},
 CellLabel->
  "Out[1852]=",ExpressionUUID->"9c72b4b3-2549-418e-8bce-3b8afad7064f"]
}, Open  ]],

Cell["Now an application, the Galois group of a polynomial: ", "Text",
 CellChangeTimes->{{3.972525189045059*^9, 3.9725252281599207`*^9}, {
   3.9725252601296997`*^9, 3.9725252634598703`*^9}, {3.972525523828751*^9, 
   3.972525524446377*^9}, 3.972550599715816*^9, {3.973154401596768*^9, 
   3.973154407990822*^9}},ExpressionUUID->"3a3e55d2-525f-4153-997f-\
0ec86f960c0f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ResourceFunction", "[", "\"\<GaloisGroupProperties\>\"", "]"}], "[", 
  RowBox[{
   RowBox[{
    RowBox[{"x", "^", "3"}], "-", "x", " ", "+", "1"}], ",", "x"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.972525147776973*^9, 3.972525170443399*^9}, {
  3.972550443447259*^9, 3.9725504783250227`*^9}, {3.972550535286902*^9, 
  3.972550541304421*^9}, {3.9725506143156357`*^9, 3.972550616738427*^9}},
 CellLabel->
  "In[1853]:=",ExpressionUUID->"023cc602-5dcc-44b7-96d6-c0fb8fdf942f"],

Cell[BoxData[
 FormBox[
  RowBox[{"SymmetricGroup", "[", "3", "]"}], TraditionalForm]], "Output",
 CellChangeTimes->{{3.9725251604930353`*^9, 3.972525170939755*^9}, {
   3.972550444046327*^9, 3.972550478784287*^9}, 3.972550541547217*^9, 
   3.972550617145862*^9, 3.973154159030408*^9},
 CellLabel->
  "Out[1853]=",ExpressionUUID->"54ab6b57-f77c-44b5-af2c-e5f5bdc698a3"]
}, Open  ]],

Cell["\<\
Galois theory then says there is only one real root, and this is correct:\
\>", "Text",
 CellChangeTimes->{{3.972525645879558*^9, 3.972525664940539*^9}, {
  3.973154426589167*^9, 
  3.9731544633629827`*^9}},ExpressionUUID->"24b031df-4ee1-46dc-b231-\
69eeda4b4b89"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x", "^", "3"}], "-", "x", " ", "+", "1"}], "==", "0"}], ",", 
     "x", ",", "Reals"}], "]"}], "//", "First"}], "//", 
  "ToRadicals"}]], "Input",
 CellChangeTimes->{{3.972525627767376*^9, 3.972525634308148*^9}, {
  3.972525675946781*^9, 3.972525687644185*^9}, {3.972550550277295*^9, 
  3.972550579335362*^9}, {3.972550621591278*^9, 3.972550625897929*^9}},
 CellLabel->
  "In[1854]:=",ExpressionUUID->"47d04d7c-9ec0-4e60-a580-6dd7137625f7"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"x", "\[Rule]", 
    RowBox[{
     RowBox[{"-", 
      RadicalBox[
       FractionBox["2", 
        RowBox[{"3", " ", 
         RowBox[{"(", 
          RowBox[{"9", "-", 
           SqrtBox["69"]}], ")"}]}]], "3"]}], "-", 
     FractionBox[
      RadicalBox[
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"9", "-", 
          SqrtBox["69"]}], ")"}]}], "3"], 
      SuperscriptBox["3", 
       RowBox[{"2", "/", "3"}]]]}]}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{
  3.972525635341219*^9, {3.97252567848698*^9, 3.9725256889689074`*^9}, 
   3.9725504529842577`*^9, {3.972550550867756*^9, 3.9725505797310123`*^9}, {
   3.972550622147698*^9, 3.972550626217392*^9}, 3.973154159034493*^9},
 CellLabel->
  "Out[1854]=",ExpressionUUID->"23ac1bed-bb19-4f0f-803f-c16beed1377b"]
}, Open  ]],

Cell[TextData[{
 "More generally, an \[OpenCurlyDoubleQuote]irreducible\
\[CloseCurlyDoubleQuote] polynomial of prime degree ",
 StyleBox["p",
  FontSlant->"Italic"],
 " larger than 4 with exactly 2 nonreal roots has ",
 "Galois group",
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "p"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5dfb09f7-47dd-4e84-94ad-5660df26de6f"],
 ". For more on this, see my Galois notes.\n\nFinally, for entertainment, the \
biggest sporadic finite group, the Monster:"
}], "Text",
 CellChangeTimes->{{3.9725236350171328`*^9, 3.972523645235663*^9}, {
  3.972550601346265*^9, 3.9725506097534*^9}, {3.973154472687669*^9, 
  3.973154511129867*^9}},ExpressionUUID->"1524cba3-29ab-44c5-9ccc-\
7933848bb3d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"MonsterGroupM", "[", "]"}], "//", "GroupOrder"}]], "Input",
 CellChangeTimes->{{3.972523647468451*^9, 3.972523648958654*^9}, 
   3.972523735473652*^9},
 CellLabel->
  "In[1855]:=",ExpressionUUID->"5574af52-2d56-4c7a-aa3f-7f3c444780fa"],

Cell[BoxData[
 FormBox["808017424794512875886459904961710757005754368000000000", 
  TraditionalForm]], "Output",
 CellChangeTimes->{3.9725237365427923`*^9, 3.9725504529935637`*^9, 
  3.973154159046269*^9},
 CellLabel->
  "Out[1855]=",ExpressionUUID->"e8022f65-4b54-4fee-acdd-adedaaff021d"]
}, Open  ]],

Cell["\<\
The monster group has a faithful linear representation of dimension over the \
field of two elements of order 196 882. This number is decently approximated \
by:\
\>", "Text",
 CellChangeTimes->{{3.972523770051448*^9, 3.972523773219256*^9}, {
  3.972523804539263*^9, 3.9725238225856457`*^9}, {3.972523867486124*^9, 
  3.972523886663759*^9}, {3.9731545174276114`*^9, 
  3.973154521337531*^9}},ExpressionUUID->"cb31adb0-12da-4824-bd84-\
816062fdd90b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"2", " ", "\[Pi]", " ", 
   RowBox[{"BesselI", "[", 
    RowBox[{"1", ",", 
     RowBox[{"4", "\[Pi]"}]}], "]"}]}], "//", "N"}]], "Input",
 CellChangeTimes->{{3.97252377623378*^9, 3.972523800749803*^9}, {
  3.972523854485127*^9, 3.9725238584309597`*^9}},
 CellLabel->
  "In[1856]:=",ExpressionUUID->"696da902-87cd-4140-afdb-489fdd458561"],

Cell[BoxData[
 FormBox["196550.66513211324`", TraditionalForm]], "Output",
 CellChangeTimes->{{3.972523795217372*^9, 3.972523802007031*^9}, 
   3.97252385927067*^9, 3.972550453001214*^9, 3.973154159052907*^9},
 CellLabel->
  "Out[1856]=",ExpressionUUID->"abaff4b7-c804-476f-89f3-dc0313d93d3d"]
}, Open  ]],

Cell["\<\
For more on why this is, see my Cambridge lecture series notes (2022)\
\[LineSeparator]https://tp.hotell.kau.se/marcus/notes/newton.html
but this is of course not needed for this course. \
\>", "Text",
 CellChangeTimes->{{3.972523889471279*^9, 3.972523963688493*^9}, {
  3.9731545258279667`*^9, 
  3.9731545431965923`*^9}},ExpressionUUID->"d0880834-169b-4833-a0e6-\
