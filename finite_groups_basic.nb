Cell[TextData[{
 "To call two isomorphic groups \[OpenCurlyDoubleQuote]equal\
\[CloseCurlyDoubleQuote], there should be a",
 StyleBox[" canonical",
  FontSlant->"Italic"],
 " isomorphism between them, i.e. there is some more or less \
\[OpenCurlyDoubleQuote]standard\[CloseCurlyDoubleQuote] way to relate them.\n\
\nSo far, just names. Now let\[CloseCurlyQuote]s look at how we describe \
groups ",
 "somewhat ",
 StyleBox["abstractly",
  FontSlant->"Italic"],
 ", i.e. not yet as explicitly as in Ch.4 ",
 StyleBox["Representations",
  FontSlant->"Italic"],
 ". (\[OpenCurlyDoubleQuote]Somewhat\[CloseCurlyDoubleQuote] abstractly, \
since to work with these groups, in principle you don\[CloseCurlyQuote]t need \
to know anything more than the following.)\n\n",
 StyleBox["Example 1:",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["cyclic group ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "3"], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"d24867e2-52bd-4e77-bc99-e6289989c165"],
 StyleBox[" ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["i",
      FontSlant->"Plain"], ".", 
     StyleBox["e",
      FontSlant->"Plain"], ".", " ", 
     SubscriptBox["\[DoubleStruckCapitalZ]", "3"]}]}], TraditionalForm]],
  ExpressionUUID->"612a60f5-7268-4eed-984d-57984ca7d470"],
 "). Write the elements and generators:"
}], "Text",
 CellChangeTimes->{{3.9724514951672373`*^9, 3.972451495778211*^9}, {
   3.972451613334299*^9, 3.972451615645911*^9}, {3.972451889923408*^9, 
