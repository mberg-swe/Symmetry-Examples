Cell[TextData[{
 "To get a little more understanding of how Mathematica does these things, \
the Mathematica help page recommends the following home-made visualization of \
cycles. Explicitly convert to a ",
 StyleBox["directed graph",
  FontWeight->"Bold"],
 ", stored as a list of ",
 StyleBox["directed edges",
  FontSlant->"Italic"],
 ", denoted as 1\[DirectedEdge]2, and so on:"
}], "Text",
 CellChangeTimes->{{3.972522683689043*^9, 3.972522690116869*^9}, {
  3.972523328775571*^9, 3.972523421773395*^9}, {3.9725234529193983`*^9, 
  3.972523453616412*^9}, {3.9725250226239357`*^9, 3.97252502495726*^9}, {
  3.972525485051591*^9, 
  3.9725254892541*^9}},ExpressionUUID->"2aa50c0e-7d0c-4746-8fe7-a69eee205132"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"perm", " ", "=", " ", 
  RowBox[{"Cycles", "[", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "}"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rules", "[", "cycle_", "]"}], ":=", 
   RowBox[{"Thread", "[", 
    RowBox[{"DirectedEdge", "[", 
     RowBox[{"cycle", ",", 
      RowBox[{"RotateLeft", "[", "cycle", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Flatten", "[", 
  RowBox[{"rules", "/@", 
   RowBox[{"First", "[", "perm", "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Graph", "[", 
  RowBox[{"%", ",", 
   RowBox[{"VertexLabels", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{"\"\<Name\>\"", ",", "Center"}], "]"}]}], ",", 
   RowBox[{"VertexSize", "->", "0.5"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9724513997271547`*^9, 3.972451413360488*^9}, {
  3.972452707747466*^9, 3.9724527083004837`*^9}, {3.972465134514956*^9, 
