   3.97315415888253*^9},
 CellLabel->
  "Out[1838]=",ExpressionUUID->"3819f4a3-a032-473a-ad78-05e2b9d76b5f"]
}, Open  ]],

Cell[TextData[{
 "we see that indeed multiplication of just 3,4 generate all other elements: \
1,2,5,6. So indeed number 3 and 4 generate the group. \n\nHow does the above \
relate to the presentation by relations \[LeftAngleBracket]",
 StyleBox["a,b",
  FontSlant->"Italic"],
 "| ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "260e7e68-aa18-43a5-a391-e410aec943e2"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{",", 
    SuperscriptBox["b", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f4212705-ab10-4c0d-9684-6bf3864f7ce4"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     StyleBox["ab",
      FontSlant->"Italic"], ")"}], "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "801fd997-c540-432b-9e0e-98edaf90687f"],
 "\[RightAngleBracket]? This means both ",
 StyleBox["a ",
  FontSlant->"Italic"],
 "and ",
 StyleBox["b",
  FontSlant->"Italic"],
 " square to the unit group element ",
 StyleBox["e.",
  FontSlant->"Italic"],
 " Look at the table: for example, number 2 and 3 have this property. We see \
that their product ",
 StyleBox["c = ab",
  FontSlant->"Italic"],
 " is number 4. Take this to the 3rd permutation power: "
}], "Text",
 CellChangeTimes->{{3.9725509208692408`*^9, 3.972551051839877*^9}, {
  3.972551082453123*^9, 3.972551173036276*^9}, {3.9725512471887703`*^9, 
  3.972551256453959*^9}, {3.972551316255129*^9, 3.972551360881246*^9}, {
  3.9731542096367893`*^9, 3.973154250421797*^9}, {3.97315690484809*^9, 
  3.973156932617063*^9}, {3.9731569828224363`*^9, 
  3.973156995935986*^9}},ExpressionUUID->"8235782e-c02a-409d-9577-\
a7c0a767d783"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"c", " ", "=", " ", 
   RowBox[{
    RowBox[{"GroupElements", "[", "S3", "]"}], "[", 
    RowBox[{"[", "4", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"c", " ", "\[PermutationProduct]", " ", "c", " ", "\[PermutationProduct]",
   " ", "c"}]}], "Input",
 CellChangeTimes->{{3.972551053154769*^9, 3.972551067901334*^9}, {
  3.972551176701721*^9, 3.972551225492819*^9}, {3.9725512594804497`*^9, 
  3.972551275542284*^9}, {3.972551363162662*^9, 3.9725513641535*^9}},
 CellLabel->
  "In[1839]:=",ExpressionUUID->"ec3c5abd-5bb7-49e8-94b5-def3c1830063"],

Cell[BoxData[
 FormBox[
  RowBox[{"Cycles", "[", 
   RowBox[{"{", "}"}], "]"}], TraditionalForm]], "Output",
 CellChangeTimes->{{3.972551066099861*^9, 3.9725510683267117`*^9}, {
   3.972551202863706*^9, 3.972551230215621*^9}, {3.972551261734796*^9, 
   3.972551274047535*^9}, 3.9725513645308*^9, 3.9731541588907957`*^9},
 CellLabel->
  "Out[1840]=",ExpressionUUID->"64adcc1a-f29c-42f1-abf1-8d2a8aec2272"]
}, Open  ]],

Cell[TextData[{
 "This is the unit operation, i.e. in fact ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["c", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "81abac21-39a3-4b37-a54d-c0d2ac683767"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     StyleBox["ab",
      FontSlant->"Italic"], ")"}], "3"], TraditionalForm]],ExpressionUUID->
  "491f3e49-d899-4fc2-9e7a-adcfcbd6fb1b"],
 " = ",
 StyleBox["e",
  FontSlant->"Italic"],
 ". So number 2,3 work as ",
 StyleBox["a,b",
  FontSlant->"Italic"],
 ". Again, this is not the basis of generators that Mathematica picked, since \
4 \[PermutationProduct] 4 \[NotEqual] 1. \n\nWe can visualize the relations \
in the group as its ",
 StyleBox["Cayley graph, ",
  FontWeight->"Bold"],
 "that Mathematica knows:"
}], "Text",
 CellChangeTimes->{{3.9725510049245443`*^9, 3.97255100811415*^9}, {
  3.972551281704172*^9, 3.972551313388886*^9}, {3.9725513748014174`*^9, 
  3.972551454462741*^9}, {3.973154269067092*^9, 3.973154283877822*^9}, {
  3.973154323665185*^9, 3.973154365209276*^9}, {3.973156952489242*^9, 
  3.973156975608363*^9}, {3.9731570239372387`*^9, 
  3.973157078858356*^9}},ExpressionUUID->"d18d37f4-e8e7-4a62-b8ea-\
22a051c12c0b"],

