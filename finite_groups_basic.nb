Cell["\<\
The ordering is first row, then column. So indeed 3 \[PermutationProduct] 4 = \
6. But note in the table that 4 \[PermutationProduct] 3 = 2. So \
multiplication in this group is not commutative. 
If we focus on the the rows and columns numbered 3 to 4 in the above table:\
\>", "Text",
 CellChangeTimes->{{3.972452711934394*^9, 3.97245271255599*^9}, {
   3.972461996587719*^9, 3.972462006292006*^9}, {3.972465155476372*^9, 
   3.972465160931278*^9}, {3.9725224506025467`*^9, 3.972522463399939*^9}, 
   3.972522502383292*^9, {3.972522554307939*^9, 3.9725225644714403`*^9}, {
   3.9725245176647787`*^9, 3.972524539849811*^9}, {3.972524894143465*^9, 
   3.9725249247843237`*^9}, {3.972525414656289*^9, 3.972525415212595*^9}, {
   3.972550865464444*^9, 3.9725508927748938`*^9}, {3.972550923160692*^9, 
   3.972550936888345*^9}, {3.973154184677305*^9, 3.973154234982255*^9}, {
   3.973156868801033*^9, 
   3.973156887215639*^9}},ExpressionUUID->"5ea4f819-d305-4f30-863d-\
65e2a4e3d6ca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"GroupMultiplicationTable", "[", "S3", "]"}], "[", 
  RowBox[{"[", 
   RowBox[{
    RowBox[{"3", ";;", "4"}], ",", 
    RowBox[{"3", ";;", "4"}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.972550908874995*^9, 3.9725509128538733`*^9}},
 CellLabel->
