Cell[TextData[{
 "These two generators of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "3"], TraditionalForm]],ExpressionUUID->
  "8c1e4c51-a0ec-4351-a217-2d9b74360a45"],
 " are ",
 StyleBox["not",
  FontWeight->"Bold"],
 " ",
 StyleBox["a",
  FontSlant->"Italic"],
 " and ",
 StyleBox["b",
  FontSlant->"Italic"],
 " in the notes, that both square to 1. Only number 2,3,6 here square to 1.  \
But we can still call these two generators ",
 StyleBox["a",
  FontSlant->"Italic"],
 " and ",
 StyleBox["b",
  FontSlant->"Italic"],
 ", they\[CloseCurlyQuote]re just not the same ",
 StyleBox["a",
  FontSlant->"Italic"],
 " and ",
 StyleBox["b",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.972451154059314*^9, 3.972451166942808*^9}, {
   3.972461867640904*^9, 3.972461871287529*^9}, {3.972461919293414*^9, 
