Cell[TextData[{
 "So 3 \[PermutationProduct] 4 = 6",
 StyleBox[". ",
  FontSlant->"Italic"],
 "Here are all the possible multiplications in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "42871675-4a86-4b32-bea0-89147271f348"],
 ":"
}], "Text",
