Cell[TextData[{
 "So: don\[CloseCurlyQuote]t permute at all, permute cyclically once (1 \
\[Rule] 2,  2 \[Rule] 3, 3 \[Rule] 1), permute cyclically twice (1 \[Rule] 3, \
 2 \[Rule] 1, 3 \[Rule] 2).  (Note that there are no \
\[OpenCurlyDoubleQuote]reflection\[CloseCurlyDoubleQuote] that squares to the \
identity here like 1 \[Rule] 2,  2 \[Rule] 1, 3 \[Rule] 3: which is not in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "3"], TraditionalForm]],ExpressionUUID->
  "1beb564e-6784-4378-a297-893ea9d40b54"],
 ".)"
}], "Text",
 CellChangeTimes->{{3.973153457344667*^9, 3.9731534626924067`*^9}, {
  3.973153592971427*^9, 3.973153593481017*^9}, {3.9731536677107*^9, 
  3.973153669001747*^9}, {3.97315372151191*^9, 3.97315376943902*^9}, {
  3.973156613436471*^9, 3.973156663894742*^9}, {3.9731566943860826`*^9, 
  3.973156813941745*^9}, {3.977398004232806*^9, 
  3.977398018948052*^9}},ExpressionUUID->"127ce73e-44af-43e8-b29f-\
cdd721282a2e"],

