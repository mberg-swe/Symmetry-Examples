Cell[TextData[{
 "Here multiplication by the element ",
 StyleBox["a",
  FontSlant->"Italic"],
 " is blue, by ",
 StyleBox["b",
  FontSlant->"Italic"],
 " is green.\nWe see that blue is order 2, green is order 3."
}], "Text",
 CellChangeTimes->{{3.972522504245255*^9, 3.9725225071970263`*^9}, {
