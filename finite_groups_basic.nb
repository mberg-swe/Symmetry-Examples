Cell[TextData[{
 "There is only one unique finite group of order 3 up to isomorphism. So it \
only lists one as default: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"the", " ", "cyclic", " ", "group", " ", 
    SubscriptBox["C", "3"]}], TraditionalForm]],ExpressionUUID->
  "fad0b8cd-165e-4828-bb39-7a8c4db3d0c6"],
 " \[TildeEqual] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[DoubleStruckCapitalZ]", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a359fc33-46a4-43b3-8f6c-3c845b5fdeec"],
 ". But it also knows other groups of order 3, related to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "3"], TraditionalForm]],ExpressionUUID->
  "579edbb4-59e8-4f07-9dd0-480259a66a6b"],
 " by isomorphism:"
}], "Text",
 CellChangeTimes->{{3.972451728615213*^9, 3.972451736886528*^9}, {
  3.97245184117697*^9, 3.9724518435201273`*^9}, {3.972461692939493*^9, 
