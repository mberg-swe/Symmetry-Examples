   3.9731541499985657`*^9}},ExpressionUUID->"b148b91e-fd31-49f3-88f6-\
d16d4941d7cd"],

Cell[TextData[{
 "As above, the ",
 StyleBox["permutation product",
  FontWeight->"Bold"],
 " is written in Mathematica as \[PermutationProduct] (",
 StyleBox["esc p* esc",
  FontSlant->"Italic"],
 "):"
}], "Text",
