Cell["\<\
With Mathematica, it\[CloseCurlyQuote]s easy to check that this is not \
special to 3 x 3 matrices, but works equally well e.g. for 4 x 4 matrices:\
\>", "Text",
 CellChangeTimes->{{3.976694768192994*^9, 3.976694808124515*^9}, {
  3.976698307568061*^9, 
  3.976698315165649*^9}},ExpressionUUID->"582b80c9-4c92-4471-bc81-\
