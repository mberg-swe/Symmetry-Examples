Cell[TextData[{
 StyleBox["1. the relationship to the determinant of a matrix.\n",
  FontWeight->"Bold"],
 "take e.g. the 3 rows ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1d4498eb-e419-4c71-8650-9e71bdece699"],
 " (",
 StyleBox["i",
  FontSlant->"Italic"],
 " = 1,2,3) of a 3x3 matrix ",
 StyleBox["M. ",
  FontSlant->"Italic"],
 "Form\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bb4f5055-7132-46c9-afb6-21b4ea866d06"],
 " \[TensorProduct] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "341fb60d-4871-4669-9e1e-c8d2e416cf47"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[TensorProduct]", " ", 
    SubscriptBox["M", "3"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8cd7f2d6-f5df-42f0-8124-f4910cb0dd59"],
 " \[TensorProduct] \[Epsilon]\nwhich can be viewed as a tensor with 6 \
indices",
 ":"
}], "Text",
 CellChangeTimes->{{3.9766938786449547`*^9, 3.976693896261725*^9}, {
