 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Epsilon]", 
    RowBox[{"i", " ", "j", " ", "a"}]], TraditionalForm]],ExpressionUUID->
  "5b7ed87b-8109-4c1a-96e3-2a701ef9d587"],
 " = 0 "
}], "Text",
