Cell[TextData[{
 "For more on contractions, see the Mathematica help page on ",
 StyleBox["TensorContract.", "Input"],
 "\n(The above looks slightly more elegant with the ",
 StyleBox["Notation", "Input"],
 " package to write ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "ij"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "70302d41-36f4-43cd-ae86-82326bde7e9f"],
 " for ",
 StyleBox["m",
  FontSlant->"Italic"],
 "(",
 StyleBox["i,j",
  FontSlant->"Italic"],
 "), as I do in other files. But by the notation convention \
\[OpenCurlyDoubleQuote]",
 StyleBox["keep important data big",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote], I chose not to here.)"
}], "Text",
 CellChangeTimes->{{3.976693996125984*^9, 3.976694064754168*^9}, {
  3.976694237005784*^9, 3.976694266227171*^9}, {3.976694825225152*^9, 
  3.976694827280211*^9}},ExpressionUUID->"6d0fbe0c-5605-4f0d-9da5-\
3876412cf552"],

Cell[TextData[{
 StyleBox["2. \[Epsilon] as invariant tensor of so(3)",
  FontWeight->"Bold"],
 "\nAn ",
 StyleBox["invariant tensor",
  FontWeight->"Bold"],
 " gives zero on the Lie algebra. The standard basis of so(3) is given by \
these three real antisymmetric matrices",
 StyleBox[" ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "312823f5-e76c-42ee-8bb9-9d8159ef0b0c"],
 ": "
}], "Text",
 CellChangeTimes->{{3.9766424024561777`*^9, 3.97664241944674*^9}, {
  3.976690640680395*^9, 3.976690715484798*^9}, {3.976694835914205*^9, 
  3.976694870213564*^9}, {3.976698336942341*^9, 
  3.976698344232461*^9}},ExpressionUUID->"54b7a91c-e8b9-4d5c-af5e-\
eb7abe58200c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"L1", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L2", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L3", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ";"}]}], "Input",
