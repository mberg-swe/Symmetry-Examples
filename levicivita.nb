Cell[TextData[{
 "You can inspect the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["3", "6"], " ", "="}], TraditionalForm]],ExpressionUUID->
  "f7a9af1d-bfb4-4cc3-bcac-57c112a05242"],
 " 729 elements of ",
 StyleBox["MMM\[Epsilon] ", "Input"],
 "by modifying the [[",
 StyleBox["1,2,3,1,2,3", "Input"],
 "]] above. \n(More below about using symmetries to restrict computer \
storage. Here that aspect is not important: 729 element is no problem to ",
 StyleBox["handle",
  FontSlant->"Italic"],
 ", just clumsy to ",
 StyleBox["display",
  FontSlant->"Italic"],
 ".)\nNow ",
 StyleBox["contract",
  FontWeight->"Bold"],
 " indices 1 \[LeftRightArrow] 4, 2 \[LeftRightArrow] 5, 3 \[LeftRightArrow] \
6. This creates det(",
 StyleBox["M",
  FontSlant->"Italic"],
 "):"
}], "Text",
 CellChangeTimes->{{3.976694370573739*^9, 3.976694644604974*^9}, {
  3.976698278141582*^9, 
  3.976698291273919*^9}},ExpressionUUID->"dc7616bc-fda4-43e7-a00b-\
d5e248950903"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Det", "[", "M", "]"}], "===", 
  RowBox[{"TensorContract", "[", 
   RowBox[{"MMM\[Epsilon]", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "6"}], "}"}]}], "}"}]}], "]"}]}]], "Input",
