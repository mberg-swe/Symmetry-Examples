       RowBox[{"d", ",", "SymmetrizedArray"}], "]"}], "]"}], ",", 
     RowBox[{"ByteCount", "[", 
      RowBox[{"LeviCivitaTensor", "[", 
       RowBox[{"d", ",", "SparseArray"}], "]"}], "]"}], ",", 
     RowBox[{"ByteCount", "[", 
      RowBox[{"LeviCivitaTensor", "[", 
       RowBox[{"d", ",", "List"}], "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"d", ",", "2", ",", "9"}], "}"}]}], "]"}]], "Input",
