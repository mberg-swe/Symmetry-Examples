Cell[TextData[{
 "The invariant tensor condition to check is (",
 StyleBox["x",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"\[Epsilon]", ")"}], "ijk"], " ", "=", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"c01c312f-be8d-4cdd-bedf-d893dfe69113"],
 " for all ",
 StyleBox["x",
  FontSlant->"Italic"],
 " \[Element] so(3).\nIt\[CloseCurlyQuote]s enough to check for ",
 StyleBox["x",
  FontSlant->"Italic"],
 " being the 3 generators ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["L", "m"]}], TraditionalForm]],ExpressionUUID->
  "5cf6bd0f-d24e-4afe-a480-597a147ca458"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"\[Epsilon]", ")"}], "ijk"], " ", "=", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"1cde2315-3b62-4ae1-a2b9-592e30ace273"],
 ":\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sum]", "a"], TraditionalForm]],ExpressionUUID->
  "79108c8c-f40c-4d7c-9e6d-1b1a9fe27ced"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", 
    RowBox[{"m", ",", 
     RowBox[{"i", " ", "a"}]}]], TraditionalForm]],ExpressionUUID->
  "10b418f1-92e8-4019-aa9f-994fb6c7f7de"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Epsilon]", 
    RowBox[{"a", " ", "j", " ", "k"}]], TraditionalForm]],ExpressionUUID->
  "74e48aab-cc5a-47a0-a98d-fdc683869b06"],
 " +",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", 
    RowBox[{"m", ",", 
     RowBox[{"j", " ", "a"}]}]], TraditionalForm]],ExpressionUUID->
  "be2d57c7-529c-468e-9f85-f20539ebe0ff"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Epsilon]", 
    RowBox[{"i", " ", "a", " ", "k"}]], TraditionalForm]],ExpressionUUID->
  "5910f73a-1101-4b3d-a8bd-db4e9adb18b1"],
 " + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", 
    RowBox[{"m", ",", 
     RowBox[{"k", " ", "a"}]}]], TraditionalForm]],ExpressionUUID->
  "ff3ee675-f448-4b45-bd27-b8b37ff2de7c"],
