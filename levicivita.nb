Cell["\<\
With this experience, we can do the same for the Kronecker \[Delta]:\
\>", "Text",
 CellChangeTimes->{{3.976697298788793*^9, 3.976697305879222*^9}, {
  3.976697725249065*^9, 3.976697727312028*^9}, {3.976698380791811*^9, 
  3.976698390580223*^9}},ExpressionUUID->"e838fd97-c095-4043-aac4-\
7dc6a1cce969"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Delta]", "=", 
   RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"id", "=", 
   RowBox[{"IdentityMatrix", "[", "3", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"apply2", "[", 
    RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
   RowBox[{"TensorContract", "[", 
    RowBox[{
     RowBox[{"TensorProduct", "[", 
      RowBox[{"A", ",", "B", ",", "\[Delta]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "6"}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"action2", "[", "m_", "]"}], ":=", 
   RowBox[{
    RowBox[{"apply2", "[", 
     RowBox[{
      RowBox[{"L", "[", 
       RowBox[{"[", "m", "]"}], "]"}], ",", "id"}], "]"}], "+", 
    RowBox[{"apply2", "[", 
     RowBox[{"id", ",", 
      RowBox[{"L", "[", 
       RowBox[{"[", "m", "]"}], "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"action2", "[", "m", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"m", ",", "3"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.97669730694009*^9, 3.9766973689957*^9}},
 CellLabel->
  "In[2422]:=",ExpressionUUID->"d041155d-9b10-4aa4-9d6f-1c99f1847248"],

