Cell[BoxData[{
 RowBox[{
  RowBox[{"id", "=", 
   RowBox[{"IdentityMatrix", "[", "3", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"apply", "[", 
    RowBox[{"A_", ",", "B_", ",", "C_"}], "]"}], ":=", 
   RowBox[{"TensorContract", "[", 
    RowBox[{
     RowBox[{"TensorProduct", "[", 
      RowBox[{"A", ",", "B", ",", "C", ",", "\[Epsilon]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "7"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "8"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"6", ",", "9"}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"action", "[", "m_", "]"}], ":=", 
   RowBox[{
    RowBox[{"apply", "[", 
     RowBox[{
      RowBox[{"L", "[", 
       RowBox[{"[", "m", "]"}], "]"}], ",", "id", ",", "id"}], "]"}], "+", 
    RowBox[{"apply", "[", 
     RowBox[{"id", ",", 
      RowBox[{"L", "[", 
       RowBox[{"[", "m", "]"}], "]"}], ",", "id"}], "]"}], "+", 
    RowBox[{"apply", "[", 
     RowBox[{"id", ",", "id", ",", 
      RowBox[{"L", "[", 
       RowBox[{"[", "m", "]"}], "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", 
