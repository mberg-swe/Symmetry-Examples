Cell[BoxData[{
 RowBox[{
  RowBox[{"M", "=", 
   RowBox[{"Array", "[", 
    RowBox[{"m", ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MMMM\[Epsilon]", "=", 
   RowBox[{
    RowBox[{"M", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[TensorProduct]", 
    RowBox[{"M", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "\[TensorProduct]", 
    RowBox[{"M", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "\[TensorProduct]", 
    RowBox[{"M", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], "\[TensorProduct]", 
    RowBox[{"LeviCivitaTensor", "[", 
     RowBox[{"4", ",", "List"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Det", "[", "M", "]"}], "===", 
  RowBox[{"TensorContract", "[", 
   RowBox[{"MMMM\[Epsilon]", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "6"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"4", ",", "8"}], "}"}]}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.976694665576136*^9, 3.976694765224365*^9}, 
