Cell[TextData[{
 "The rules above give the basic idea what a sparse array is: only give \
nonzero elements. If you are interested in the details, see the help page in \
Mathematica. But here we will use the next version, not this.\n\nA key \
advantage of symbolic manipulation is that the essential content of a tensor \
is stored as ",
 StyleBox["the relations themselves",
  FontWeight->"Bold"],
 ", not as explicit numbers. Here in Mathematica, this data type is called ",
 StyleBox["SymmetrizedArray", "Input"],
 ":"
}], "Text",
 CellChangeTimes->{{3.976693057877735*^9, 3.976693136614914*^9}, {
  3.976697948823493*^9, 3.9766979529161453`*^9}, {3.976699243517267*^9, 
  3.976699345700715*^9}, {3.97677459008991*^9, 
  3.976774598044813*^9}},ExpressionUUID->"a2829f70-3e2d-49a0-804c-\
8b9e0ebec636"],

