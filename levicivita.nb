Cell[TextData[{
 "(the index ",
 StyleBox["a",
  FontSlant->"Italic"],
 " is of the same type as ",
 StyleBox["ijk",
  FontSlant->"Italic"],
 ", so maybe the letter",
 StyleBox[" l",
  FontSlant->"Italic"],
 " would be better than ",
 StyleBox["a",
  FontSlant->"Italic"],
 ". But I\[CloseCurlyQuote]m trying to emphasize the sum over ",
 StyleBox["a",
  FontSlant->"Italic"],
 ". Below I\[CloseCurlyQuote]ll do it without having to make a choice).\n\
Explicitly:"
}], "Text",
 CellChangeTimes->{{3.976695964370633*^9, 3.9766960087246*^9}, {
